// Склады из настроек (массив ссылок)
Функция СкладыИзНастроек()

	Результат = Новый Массив;
	Для Каждого Название Из РазделитьСтроку(Нас("warehouse"), ";") Цикл
		Ссылка = НайтиЭлемент("Склады", СокрЛП(Название));
		Если Ссылка <> Неопределено И ЗначениеЗаполнено(Ссылка) Тогда
			Результат.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Остатки по товарам: Соответствие «ссылка -> количество в единицах хранения»
Функция ОстаткиТоваров(ИмяРегистра, Ссылки, Склады)

	Результат = Новый Соответствие;
	ОбъектМД = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если ОбъектМД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Поле = ПервоеПоле(ОбъектМД.Ресурсы, "Количество|ВНаличии|КоличествоОстаток");
	Если ПустаяСтрока(Поле) Или ОбъектМД.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Пишу("Регистр «" + ИмяРегистра + "»: не нашёл ресурс количества или измерение «Номенклатура». Ресурсы: "
			+ ИменаПолей(ОбъектМД.Ресурсы) + ". Измерения: " + ИменаПолей(ОбъектМД.Измерения));
		Возврат Результат;
	КонецЕсли;
	Условие = "Номенклатура В (&Ссылки)";
	Если Склады.Количество() > 0 И ОбъектМД.Измерения.Найти("Склад") <> Неопределено Тогда
		Условие = "Склад В (&Склады) И " + Условие;
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ О.Номенклатура КАК Товар, СУММА(О." + Поле + "Остаток) КАК Кол");
	Строки.Добавить("ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки(, " + Условие + ") КАК О");
	Строки.Добавить("СГРУППИРОВАТЬ ПО О.Номенклатура");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.УстановитьПараметр("Склады", Склады);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Товар, ЧислоИлиНоль(Выборка.Кол));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Запрос цен выбранного типа: Соответствие «ссылка -> Структура(Цена, Коэф)»
Функция ВыполнитьЗапросЦен(ПолеЦены, ПолеТипа, ТипЦен, Ссылки, СЕдиницей)

	Результат = Новый Соответствие;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ Ц.Номенклатура КАК Товар, Ц." + ПолеЦены + " КАК Цена"
		+ ?(СЕдиницей, ", Ц.ЕдиницаИзмерения.Коэффициент КАК Коэф", ""));
	Строки.Добавить("ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, " + ПолеТипа + " = &ТипЦен И Номенклатура В (&Ссылки)) КАК Ц");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цена = ЧислоИлиНоль(Выборка.Цена);
		Если Цена <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Коэф = 1;
		Если СЕдиницей Тогда
			Коэф = ЧислоИлиНоль(Выборка.Коэф);
			Если Коэф <= 0 Тогда
				Коэф = 1;
			КонецЕсли;
		ИначеЕсли Нас("price_unit") = "pack" Тогда
			Коэф = 0;     // цена за упаковку: переведём, когда узнаем размер упаковки
		КонецЕсли;
		Результат.Вставить(Выборка.Товар, Новый Структура("Цена, Коэф", Цена, Коэф));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Цены: Соответствие «ссылка -> цена за штуку»
Функция ЦеныТоваров(Ссылки, Инфо)

	Результат = Новый Соответствие;
	МДЦен = Метаданные.РегистрыСведений.Найти("ЦеныНоменклатуры");
	Если МДЦен = Неопределено Тогда
		Пишу("ОШИБКА: нет регистра сведений «ЦеныНоменклатуры».");
		Возврат Результат;
	КонецЕсли;
	ПолеТипа = ПервоеПоле(МДЦен.Измерения, "ТипЦен|ТипЦены|ВидЦены|ВидЦен");
	ПолеЦены = ПервоеПоле(МДЦен.Ресурсы, "Цена");
	Если ПустаяСтрока(ПолеТипа) Или ПустаяСтрока(ПолеЦены) Или МДЦен.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Пишу("Регистр «ЦеныНоменклатуры»: не нашёл нужные поля. Измерения: " + ИменаПолей(МДЦен.Измерения)
			+ ". Ресурсы: " + ИменаПолей(МДЦен.Ресурсы));
		Возврат Результат;
	КонецЕсли;
	МДТипов = НайтиСправочник("ТипыЦенНоменклатуры|ВидыЦен|ТипыЦен");
	Если МДТипов = Неопределено Или ПустаяСтрока(Нас("price_type")) Тогда
		Пишу("Не выбран тип цен: пункт 2 (первая настройка).");
		Возврат Результат;
	КонецЕсли;
	ТипЦен = НайтиЭлемент(МДТипов.Имя, Нас("price_type"));
	Если Не ЗначениеЗаполнено(ТипЦен) Тогда
		Пишу("Тип цен «" + Нас("price_type") + "» не найден в справочнике «" + МДТипов.Имя + "».");
		Возврат Результат;
	КонецЕсли;
	ЕстьЕдиница = МДЦен.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено;
	Попытка
		Результат = ВыполнитьЗапросЦен(ПолеЦены, ПолеТипа, ТипЦен, Ссылки, ЕстьЕдиница);
	Исключение
		Если ЕстьЕдиница Тогда
			Пишу("Цены вместе с единицей измерения не прочитаны (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
				+ "); читаю без неё: цена считается за штуку (или за упаковку, если price_unit=pack).");
			ЕстьЕдиница = Ложь;
			Результат = ВыполнитьЗапросЦен(ПолеЦены, ПолеТипа, ТипЦен, Ссылки, Ложь);
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	Инфо.Вставить("ЦенаПоЕдинице", ЕстьЕдиница);
	Возврат Результат;

КонецФункции

// Единицы измерения: Соответствие «ссылка товара -> массив структур(Имя, Коэф)»
Функция ЕдиницыТоваров(Ссылки)

	Результат = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Е.Владелец КАК Товар, Е.Наименование КАК Имя, Е.Коэффициент КАК Коэф"
			+ Символы.ПС + "ИЗ Справочник.ЕдиницыИзмерения КАК Е"
			+ Символы.ПС + "ГДЕ Е.Владелец В (&Ссылки) И Е.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Список = Результат.Получить(Выборка.Товар);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				Результат.Вставить(Выборка.Товар, Список);
			КонецЕсли;
			Список.Добавить(Новый Структура("Имя, Коэф", Выборка.Имя, Выборка.Коэф));
		КонецЦикла;
	Исключение
		Пишу("Единицы измерения не прочитаны (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ "): размер упаковки возьму из настройки default_pack.");
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Все сведения о товарах по списку ссылок: Соответствие «ссылка -> Структура».
// НужныЦены = Ложь: цены из регистра не читаются (для инвойсов цена берётся из строки документа).
Функция СведенияОТоварах(Ссылки, НужныЦены = Истина)

	Результат = Новый Соответствие;
	МДН = Метаданные.Справочники.Найти("Номенклатура");
	Если МДН = Неопределено Тогда
		Пишу("ОШИБКА: в базе нет справочника «Номенклатура».");
		Возврат Результат;
	КонецЕсли;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ЕстьАртикул = МДН.Реквизиты.Найти("Артикул") <> Неопределено;
	ЕстьЕдХран = МДН.Реквизиты.Найти("ЕдиницаХраненияОстатков") <> Неопределено;
	ЕстьВид = МДН.Реквизиты.Найти("ВидТовара") <> Неопределено;
	ЕстьВысота = МДН.Реквизиты.Найти("Высота") <> Неопределено;
	ЕстьСтрана = МДН.Реквизиты.Найти("СтранаПроисхождения") <> Неопределено;

	Поля = Новый Массив;
	Поля.Добавить("	Н.Ссылка КАК Ссылка");
	Поля.Добавить("	Н.Код КАК Код");
	Поля.Добавить("	Н.Наименование КАК Имя");
	Поля.Добавить("	Н.Родитель.Наименование КАК Группа");
	Если ЕстьАртикул Тогда
		Поля.Добавить("	Н.Артикул КАК Артикул");
	КонецЕсли;
	Если ЕстьЕдХран Тогда
		Поля.Добавить("	Н.ЕдиницаХраненияОстатков.Наименование КАК ЕдХранИмя");
		Поля.Добавить("	Н.ЕдиницаХраненияОстатков.Коэффициент КАК ЕдХранКоэф");
	КонецЕсли;
	Если ЕстьВид Тогда
		Поля.Добавить("	Н.ВидТовара КАК ВидТовара");
	КонецЕсли;
	Если ЕстьВысота Тогда
		Поля.Добавить("	Н.Высота КАК Высота");
	КонецЕсли;
	Если ЕстьСтрана Тогда
		Поля.Добавить("	Н.СтранаПроисхождения КАК СтранаТовара");
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ");
	Строки.Добавить(СоединитьСтроки(Поля, "," + Символы.ПС));
	Строки.Добавить("ИЗ Справочник.Номенклатура КАК Н");
	Строки.Добавить("ГДЕ Н.Ссылка В (&Ссылки)");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Карточки = Запрос.Выполнить().Выгрузить();

	Склады = СкладыИзНастроек();
	Остатки = ОстаткиТоваров("ТоварыНаСкладах", Ссылки, Склады);
	Резервы = Новый Соответствие;
	Если Нас("use_reserves") = "1" Тогда
		Резервы = ОстаткиТоваров("ТоварыВРезервеНаСкладах", Ссылки, Склады);
	КонецЕсли;
	Инфо = Новый Структура;
	Цены = Новый Соответствие;
	Если НужныЦены Тогда
		Цены = ЦеныТоваров(Ссылки, Инфо);
	КонецЕсли;
	Единицы = ЕдиницыТоваров(Ссылки);
	ПоУмолчанию = 25;
	Попытка
		ПоУмолчанию = Число(Нас("default_pack"));
	Исключение
	КонецПопытки;

	Для Каждого Карта Из Карточки Цикл
		Св = Новый Структура;
		Св.Вставить("Ссылка", Карта.Ссылка);
		Св.Вставить("GUID", Строка(Карта.Ссылка.УникальныйИдентификатор()));
		Св.Вставить("Код", Карта.Код);
		Св.Вставить("Имя", СокрЛП(Карта.Имя));
		Св.Вставить("Группа", ?(Карта.Группа = Null, "", Карта.Группа));
		Артикул = "";
		Если ЕстьАртикул Тогда
			Артикул = СокрЛП(Строка(Карта.Артикул));
		КонецЕсли;
		Св.Вставить("Артикул", Артикул);
		Вид = "";
		Если ЕстьВид Тогда
			Вид = ТекстЗначения(Карта.ВидТовара);
		КонецЕсли;
		Св.Вставить("Вид", Вид);
		Высота = 0;
		Если ЕстьВысота Тогда
			Высота = ПерваяЧисло(Карта.Высота);
		КонецЕсли;
		Св.Вставить("Высота", Высота);
		СтранаТовара = "";
		Если ЕстьСтрана Тогда
			СтранаТовара = СтранаПоТексту(ТекстЗначения(Карта.СтранаТовара));
		КонецЕсли;
		Св.Вставить("СтранаТовара", СтранаТовара);
		ЕдХранИмя = "";
		КоэфХран = 1;
		Если ЕстьЕдХран Тогда
			ЕдХранИмя = СокрЛП(Строка(Карта.ЕдХранИмя));
			Если ЧислоИлиНоль(Карта.ЕдХранКоэф) > 0 Тогда
				КоэфХран = Карта.ЕдХранКоэф;
			КонецЕсли;
		КонецЕсли;
		Св.Вставить("ЕдХранИмя", ЕдХранИмя);
		Св.Вставить("КоэфХран", КоэфХран);

		// размер упаковки: из единиц измерения («пачка» = 25 шт), иначе из настройки
		Упаковка = 0;
		ИзЕдиниц = Ложь;
		СписокЕд = Единицы.Получить(Карта.Ссылка);
		Если СписокЕд <> Неопределено Тогда
			Для Каждого Ед Из СписокЕд Цикл
				Если ЧислоИлиНоль(Ед.Коэф) > 1 И СодержитСлово(Ед.Имя, "", Нас("pack_words")) Тогда
					Упаковка = Окр(Ед.Коэф);
					ИзЕдиниц = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Упаковка = 0 И КоэфХран > 1 И СодержитСлово(ЕдХранИмя, "", Нас("pack_words")) Тогда
			Упаковка = Окр(КоэфХран);
			ИзЕдиниц = Истина;
		КонецЕсли;
		Если Упаковка = 0 Тогда
			Упаковка = ?(ПоУмолчанию >= 1, Окр(ПоУмолчанию), 1);
		КонецЕсли;
		Св.Вставить("Упаковка", Упаковка);
		Св.Вставить("УпаковкаИзЕдиниц", ИзЕдиниц);

		// цена за штуку
		ЦенаШт = 0;
		Ц = Цены.Получить(Карта.Ссылка);
		Если Ц <> Неопределено Тогда
			Если Ц.Коэф > 0 Тогда
				ЦенаШт = Ц.Цена / Ц.Коэф;
			Иначе
				ЦенаШт = Ц.Цена / Упаковка;
			КонецЕсли;
		КонецЕсли;
		Св.Вставить("ЦенаШт", Окр(ЦенаШт, 2));

		// остаток в штуках = (остаток - резерв) * штук в единице хранения
		Ост = Остатки.Получить(Карта.Ссылка);
		Рез = Резервы.Получить(Карта.Ссылка);
		Остаток = ?(Ост = Неопределено, 0, Ост) - ?(Рез = Неопределено, 0, Рез);
		Св.Вставить("ОстатокЕд", ?(Ост = Неопределено, 0, Ост));
		Св.Вставить("РезервЕд", ?(Рез = Неопределено, 0, Рез));
		Св.Вставить("Стеблей", Макс(0, Окр(Остаток * КоэфХран)));
		Результат.Вставить(Карта.Ссылка, Св);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------------
// Каталог: подготовка, предпросмотр, отправка
// ----------------------------------------------------------------------------

// Строки каталога для сайта (массив структур) или Неопределено, если не получилось
Функция ПодготовитьКаталог()

	МДН = Метаданные.Справочники.Найти("Номенклатура");
	Если МДН = Неопределено Тогда
		Пишу("ОШИБКА: в базе нет справочника «Номенклатура».");
		Возврат Неопределено;
	КонецЕсли;
	Группы = Новый Массив;
	Для Каждого Название Из РазделитьСтроку(Нас("group"), ";") Цикл
		Ссылка = НайтиЭлемент("Номенклатура", СокрЛП(Название));
		Если Ссылка = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
			Пишу("Группа номенклатуры «" + СокрЛП(Название) + "» не найдена: пункт 2 (первая настройка).");
			Возврат Неопределено;
		КонецЕсли;
		Группы.Добавить(Ссылка);
	КонецЦикла;
	Если Группы.Количество() = 0 Тогда
		Пишу("Не выбрана группа товаров: пункт 2 (первая настройка).");
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Н.Ссылка КАК Ссылка ИЗ Справочник.Номенклатура КАК Н"
		+ Символы.ПС + "ГДЕ Н.ЭтоГруппа = ЛОЖЬ И Н.ПометкаУдаления = ЛОЖЬ И Н.Ссылка В ИЕРАРХИИ (&Группы)";
	Запрос.УстановитьПараметр("Группы", Группы);
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Пишу("Товаров в группе «" + Нас("group") + "»: " + Формат(Ссылки.Количество(), "ЧГ=0"));
	Сведения = СведенияОТоварах(Ссылки);

	Строки = Новый Массив;
	БезЦены = 0;
	БезОстатка = 0;
	Для Каждого Ссылка Из Ссылки Цикл
		Св = Сведения.Получить(Ссылка);
		Если Св = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Св.ЦенаШт <= 0 Тогда
			БезЦены = БезЦены + 1;
		ИначеЕсли Св.Стеблей <= 0 Тогда
			БезОстатка = БезОстатка + 1;
		Иначе
			Строки.Добавить(Св);
		КонецЕсли;
	КонецЦикла;
	Пишу("Без цены (не отправляются): " + Формат(БезЦены, "ЧГ=0") + "; без остатка (не отправляются, на сайте исчезнут): "
		+ Формат(БезОстатка, "ЧГ=0") + "; к отправке: " + Формат(Строки.Количество(), "ЧГ=0"));
	Возврат Строки;

КонецФункции

Процедура ПоказатьПримеры(Строки, Сколько = 25)

	Пишу("");
	Пишу("Первые " + Формат(Мин(Сколько, Строки.Количество()), "ЧГ=0") + " строк (так увидит сайт):");
	Пишу("название | упаковка | цена за штуку | остаток, шт | как посчитано");
	Номер = 0;
	Для Каждого Св Из Строки Цикл
		Номер = Номер + 1;
		Если Номер > Сколько Тогда
			Прервать;
		КонецЕсли;
		Откуда = "";
		Если Св.УпаковкаИзЕдиниц Тогда
			Откуда = "упаковка из единиц измерения";
		Иначе
			Откуда = "упаковка по умолчанию " + Формат(Св.Упаковка, "ЧГ=0") + " (единица «пачка» не найдена)";
		КонецЕсли;
		Пишу(Св.Имя + " | " + Формат(Св.Упаковка, "ЧГ=0") + " шт | " + Формат(Св.ЦенаШт, "ЧДЦ=2; ЧРД=,; ЧГ=0") + " ₽ | "
			+ Формат(Св.Стеблей, "ЧГ=0") + " | остаток 1С " + Формат(Св.ОстатокЕд, "ЧДЦ=2; ЧРД=,; ЧГ=0") + " " + Св.ЕдХранИмя
			+ " (резерв " + Формат(Св.РезервЕд, "ЧДЦ=2; ЧРД=,; ЧГ=0") + ", в штуке единицы хранения " + Формат(Св.КоэфХран, "ЧДЦ=2; ЧРД=,; ЧГ=0") + "); " + Откуда);
	КонецЦикла;

КонецПроцедуры

Функция СтрокаТовараJSON(Св)

	Части = Новый Массив;
	Части.Добавить("""id"":" + JSONСтрока(Св.GUID));
	Если Не ПустаяСтрока(Св.Артикул) Тогда
		Части.Добавить("""sku"":" + JSONСтрока(Св.Артикул));
	КонецЕсли;
	Части.Добавить("""name"":" + JSONСтрока(Св.Имя));
	Если Не ПустаяСтрока(Св.Вид) Тогда
		Части.Добавить("""kind"":" + JSONСтрока(Св.Вид));
	КонецЕсли;
	Если Св.Высота > 0 Тогда
		Части.Добавить("""height"":" + ЧислоJSON(Св.Высота, 0));
	КонецЕсли;
	Если Не ПустаяСтрока(Св.СтранаТовара) Тогда
		Части.Добавить("""country"":" + JSONСтрока(Св.СтранаТовара));
	КонецЕсли;
	Части.Добавить("""price"":" + ЧислоJSON(Св.ЦенаШт, 2));
	Части.Добавить("""quantity"":" + ЧислоJSON(Св.Стеблей, 0));
	Если Св.УпаковкаИзЕдиниц Тогда
		Части.Добавить("""package_size"":" + ЧислоJSON(Св.Упаковка, 0));
	Иначе
		Части.Добавить("""package_size_hint"":" + ЧислоJSON(Св.Упаковка, 0));
	КонецЕсли;
	Возврат "{" + СоединитьСтроки(Части, ",") + "}";

КонецФункции

Функция ТелоКаталога(Строки)

	Документ = Новый ТекстовыйДокумент;
	Документ.ДобавитьСтроку("{""full"":true,""products"":[");
	Номер = 0;
	Для Каждого Св Из Строки Цикл
		Номер = Номер + 1;
		Документ.ДобавитьСтроку(СтрокаТовараJSON(Св) + ?(Номер < Строки.Количество(), ",", ""));
	КонецЦикла;
	Документ.ДобавитьСтроку("]}");
	Возврат Документ.ПолучитьТекст();

КонецФункции

Процедура ДействиеКаталогПоказать()

	Строки = ПодготовитьКаталог();
	Если Строки <> Неопределено Тогда
		ПоказатьПримеры(Строки);
		Пишу("");
		Пишу("Ничего не отправлено. Если цены, остатки и упаковки похожи на правду, сделайте пункт 4 (проверка на сайте).");
	КонецЕсли;

КонецПроцедуры

// ПроверкаБезСохранения: Истина - сайт только посчитает и ничего не сохранит
Процедура ОтправитьКаталог(ПроверкаБезСохранения)

	Если ПустаяСтрока(Нас("key")) Тогда
		Пишу("Не задан ключ доступа: пункт 2 (первая настройка).");
		Возврат;
	КонецЕсли;
	Строки = ПодготовитьКаталог();
	Если Строки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Строки.Количество() = 0 Тогда
		Пишу("К отправке 0 товаров: проверьте группу, склад и тип цен (пункт 2). На сайт ничего не ушло.");
		Возврат;
	КонецЕсли;
	Прошлое = 0;
	Попытка
		Прошлое = Число(Нас("last_count"));
	Исключение
	КонецПопытки;
	Если Не ПроверкаБезСохранения И Прошлое >= 20 И Строки.Количество() < Прошлое / 2 Тогда
		Пишу("СТОП: к отправке " + Формат(Строки.Количество(), "ЧГ=0") + " товаров, а в прошлый раз было " + Формат(Прошлое, "ЧГ=0")
			+ ". Так резко товаров убывать не должно: возможно, выбран не тот склад или тип цен. На сайт ничего не ушло."
			+ " Если так и должно быть, сначала сделайте пункт 4 (проверка), затем снова пункт 5.");
		Возврат;
	КонецЕсли;
	Если Не ПроверкаБезСохранения Тогда
		Если Не Подтвердить("Отправить на сайт " + Формат(Строки.Количество() + 0, "ЧГ=0") + " товаров ПО-НАСТОЯЩЕМУ?"
			+ Символы.ПС + "Всё, чего нет в этом списке, исчезнет с витрины сайта (остаток 0)."
			+ Символы.ПС + "Сначала лучше сделать пункт 4 (проверка на сайте).") Тогда
			Пишу("Отправка отменена.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Ответ = ВызватьСайт("POST", "/api/1c/products/sync" + ?(ПроверкаБезСохранения, "?dry_run=1", ""), ТелоКаталога(Строки));
	Пишу(?(ПроверкаБезСохранения, "ПРОВЕРКА на сайте (ничего не сохранено)", "ОТПРАВКА каталога на сайт") + ": " + Формат(Строки.Количество(), "ЧГ=0") + " товаров.");
	Названия = Новый Соответствие;
	Названия.Вставить("created", "создано новых");
	Названия.Вставить("updated", "обновлено");
	Названия.Вставить("deactivated", "снято с витрины");
	Названия.Вставить("errors_total", "ошибок в строках");
	ИтогОтвета(Ответ, Названия);
	Если ПроверкаБезСохранения Тогда
		Пишу("");
		Пишу("Как читать: если «создано новых» почти равно числу товаров, а «обновлено» почти ноль, то названия/артикулы не совпали");
		Пишу("с товарами на сайте и настоящая загрузка заведёт дубли: НЕ отправляйте, пришлите этот отчёт мне.");
	ИначеЕсли Ответ.Код = 200 Тогда
		Настройки.Вставить("last_count", Формат(Строки.Количество(), "ЧГ=0"));
		СохранитьНастройки();
	КонецЕсли;

КонецПроцедуры

// ----------------------------------------------------------------------------
// Инвойсы «в пути»
// ----------------------------------------------------------------------------

Функция СтранаПоТексту(Текст)

	Образец = НРег(Текст);
	Если Найти(Образец, "эквадор") > 0 Тогда
		Возврат "Эквадор";
	ИначеЕсли Найти(Образец, "колумб") > 0 Тогда
		Возврат "Колумбия";
	ИначеЕсли Найти(Образец, "кени") > 0 Тогда
		Возврат "Кения";
	ИначеЕсли Найти(Образец, "голланд") > 0 Или Найти(Образец, "нидерланд") > 0 Тогда
		Возврат "Голландия";
	ИначеЕсли Найти(Образец, "эфиоп") > 0 Тогда
		Возврат "Эфиопия";
	ИначеЕсли Найти(Образец, "китай") > 0 Тогда
		Возврат "Китай";
	ИначеЕсли Найти(Образец, "росси") > 0 Тогда
		Возврат "Россия";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ТабличнаяЧастьТоваров(ОбъектМД)

	Лучшая = Неопределено;
	Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
		Если ТЧ.Реквизиты.Найти("Номенклатура") <> Неопределено И ТЧ.Реквизиты.Найти("Количество") <> Неопределено Тогда
			Если Лучшая = Неопределено Или ТЧ.Имя = "Товары" Тогда
				Лучшая = ТЧ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Лучшая;

КонецФункции

// Массив структур-инвойсов (Ид, Номер, Дата, Вид, ВидДок, Штучный, СтранаДок, Страна, Поставщик, Проведен, Статус,
// Поля, Строки). СтранаДок - страна из шапки или вида документа, Страна - то, что уйдёт на сайт (если СтранаДок пуста,
// то самая частая страна строк). Строка = Структура(Св, Штук, ШтукДок, Цена, Упак, УпакТекст, Высота, Короб, Вид, СтранаСтр):
// Штук - к отправке (с учётом остатка склада), ШтукДок - по документу; Цена, Упак (штук в пачке), Высота, СтранаСтр - из
// строки документа (0 или пусто, если там не заполнено); УпакТекст («Упаковка») и Короб («В коробке») - для проверки глазами.
Функция ПолныйРежимИнвойсов()

	Возврат Нас("cap_stock") = "1" И ПустаяСтрока(Нас("invoice_kinds"));

КонецФункции

Функция ПодготовитьИнвойсы()

	Результат = Новый Массив;
	Полный = ПолныйРежимИнвойсов();
	СтатИнвойсов = Новый Структура("Полный, Прочитано, Пустых, Отправляется", Полный, 0, 0, 0);
	Дней = 21;
	Попытка
		Дней = Число(Нас("invoice_days"));
	Исключение
	КонецПопытки;
	От = НачалоДня(ТекущаяДата()) - Дней * 86400;
	Найдено = 0;
	ПропущеноПоВиду = 0;
	НужныЦеныРегистра = Не ПустаяСтрока(Нас("price_type"));

	Для Каждого ОбъектМД Из Метаданные.Документы Цикл
		Если Не СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Нас("invoice_words")) Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		ТЧ = ТабличнаяЧастьТоваров(ОбъектМД);
		Если ТЧ = Неопределено Тогда
			Пишу("Документ «" + ОбъектМД.Синоним + "»: не нашёл табличную часть с товарами (нужны поля Номенклатура и Количество). Пропущен.");
			Продолжить;
		КонецЕсли;
		ЕстьПоставщик = ОбъектМД.Реквизиты.Найти("Контрагент") <> Неопределено;
		ЕстьСтрана = ОбъектМД.Реквизиты.Найти("Страна") <> Неопределено;
		ЕстьВидДок = ОбъектМД.Реквизиты.Найти("ВидДок") <> Неопределено;
		Строки = Новый Массив;
		Строки.Добавить("ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.Номер КАК Номер, Д.Дата КАК ДатаДок, Д.Проведен КАК Проведен, Д.ПометкаУдаления КАК Удален"
			+ ?(ЕстьПоставщик, ", Д.Контрагент.Наименование КАК Поставщик", "")
			+ ?(ЕстьСтрана, ", Д.Страна КАК СтранаШапки", "")
			+ ?(ЕстьВидДок, ", Д.ВидДок КАК ВидДок", ""));
		Строки.Добавить("ИЗ Документ." + ОбъектМД.Имя + " КАК Д");
		Если Полный Тогда
			Строки.Добавить("ГДЕ (Д.Проведен Или Д.Дата >= &От)");
		Иначе
			Строки.Добавить("ГДЕ Д.Дата >= &От");
		КонецЕсли;
		Строки.Добавить("УПОРЯДОЧИТЬ ПО Д.Дата");
		Запрос = Новый Запрос;
		Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
		Запрос.УстановитьПараметр("От", От);
		ТаблДокументов = Запрос.Выполнить().Выгрузить();

		// какие поля табличной части брать: по имени, а если не нашлось - по слову в синониме
		ЕстьКоэф = ТЧ.Реквизиты.Найти("Коэффициент") <> Неопределено;
		ПолеЦены = ПолеТЧ(ТЧ.Реквизиты, "ЦенаПродажи", "цена оптовая,цена продажи");
		ПолеПачки = ПолеТЧ(ТЧ.Реквизиты, "Колво", "в пачке");
		ПолеУпак = ПолеТЧ(ТЧ.Реквизиты, "Упаковка");
		ПолеВысоты = ПолеТЧ(ТЧ.Реквизиты, "Высота");
		ПолеКоробки = ПолеТЧ(ТЧ.Реквизиты, "ВКоробке|КоличествоВКоробке");
		ПолеВида = ПолеТЧ(ТЧ.Реквизиты, "ВидТовараСТР", "вид товара");
		ПолеСтраны = ПолеТЧ(ТЧ.Реквизиты, "СтранаСтрока");
		ОписаниеПолей = "штук <- Количество" + ?(ЕстьКоэф, " x Коэффициент", "")
			+ "; цена за штуку <- " + ?(ПустаяСтрока(ПолеЦены), "(поля нет: беру из регистра цен)", ПолеЦены)
			+ "; штук в пачке <- " + ?(ПустаяСтрока(ПолеПачки), "(поля нет)", ПолеПачки) + ", а если пусто, то число из «" + ?(ПустаяСтрока(ПолеУпак), "(поля нет)", ПолеУпак) + "»"
			+ "; высота <- " + ?(ПустаяСтрока(ПолеВысоты), "(поля нет)", ПолеВысоты) + ", а если пусто, то из карточки товара"
			+ "; вид товара (запасной) <- " + ?(ПустаяСтрока(ПолеВида), "(поля нет)", ПолеВида)
			+ "; страна строки <- " + ?(ПустаяСтрока(ПолеСтраны), "(поля нет)", ПолеСтраны)
			+ "; для сверки: " + ?(ПустаяСтрока(ПолеКоробки), "(поля нет)", ПолеКоробки);

		// строки товаров: один запрос на все документы этого вида
		Поля2 = Новый Массив;
		Поля2.Добавить("Т.Ссылка КАК Док");
		Поля2.Добавить("Т.Номенклатура КАК Товар");
		Поля2.Добавить("Т.Количество КАК Кол");
		Если ЕстьКоэф Тогда
			Поля2.Добавить("Т.Коэффициент КАК Коэф");
		КонецЕсли;
		Если Не ПустаяСтрока(ПолеЦены) Тогда
			Поля2.Добавить("Т." + ПолеЦены + " КАК ЦенаСтр");
		КонецЕсли;
		Если Не ПустаяСтрока(ПолеПачки) Тогда
			Поля2.Добавить("Т." + ПолеПачки + " КАК ПачкаСтр");
		КонецЕсли;
		Если Не ПустаяСтрока(ПолеУпак) Тогда
			Поля2.Добавить("Т." + ПолеУпак + " КАК УпакСтр");
		КонецЕсли;
		Если Не ПустаяСтрока(ПолеВысоты) Тогда
			Поля2.Добавить("Т." + ПолеВысоты + " КАК ВысотаСтр");
		КонецЕсли;
		Если Не ПустаяСтрока(ПолеКоробки) Тогда
			Поля2.Добавить("Т." + ПолеКоробки + " КАК КоробСтр");
		КонецЕсли;
		Если Не ПустаяСтрока(ПолеВида) Тогда
			Поля2.Добавить("Т." + ПолеВида + " КАК ВидСтр");
		КонецЕсли;
		Если Не ПустаяСтрока(ПолеСтраны) Тогда
			Поля2.Добавить("Т." + ПолеСтраны + " КАК СтранаСтр");
		КонецЕсли;
		Запрос2 = Новый Запрос;
		Запрос2.Текст = "ВЫБРАТЬ " + СоединитьСтроки(Поля2, ", ")
			+ Символы.ПС + "ИЗ Документ." + ОбъектМД.Имя + "." + ТЧ.Имя + " КАК Т"
			+ Символы.ПС + "ГДЕ Т.Ссылка В (&Документы)";
		Запрос2.УстановитьПараметр("Документы", ТаблДокументов.ВыгрузитьКолонку("Ссылка"));
		СтрокиДок = Запрос2.Выполнить().Выгрузить();
		ПоДокументам = Новый Соответствие;
		Товары = Новый Массив;
		Для Каждого Ст Из СтрокиДок Цикл
			Список = ПоДокументам.Получить(Ст.Док);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				ПоДокументам.Вставить(Ст.Док, Список);
			КонецЕсли;
			Коэф = 1;
			Если ЕстьКоэф Тогда
				Если ЧислоИлиНоль(Ст.Коэф) > 0 Тогда
					Коэф = Ст.Коэф;
				КонецЕсли;
			КонецЕсли;
			Цена = 0;
			Если Не ПустаяСтрока(ПолеЦены) Тогда
				Цена = ПерваяЧисло(Ст.ЦенаСтр);
			КонецЕсли;
			УпакТекст = "";
			Если Не ПустаяСтрока(ПолеУпак) Тогда
				УпакТекст = ТекстЗначения(Ст.УпакСтр);
			КонецЕсли;
			Упак = 0;
			Если Не ПустаяСтрока(ПолеПачки) Тогда
				Упак = ПерваяЧисло(Ст.ПачкаСтр);
			КонецЕсли;
			Если Упак <= 0 Тогда
				Упак = ПерваяЧисло(УпакТекст);
			КонецЕсли;
			ВысотаСтр = 0;
			Если Не ПустаяСтрока(ПолеВысоты) Тогда
				ВысотаСтр = ПерваяЧисло(Ст.ВысотаСтр);
			КонецЕсли;
			Короб = 0;
			Если Не ПустаяСтрока(ПолеКоробки) Тогда
				Короб = ПерваяЧисло(Ст.КоробСтр);
			КонецЕсли;
			ВидСтр = "";
			Если Не ПустаяСтрока(ПолеВида) Тогда
				ВидСтр = ТекстЗначения(Ст.ВидСтр);
			КонецЕсли;
			СтранаСтр = "";
			Если Не ПустаяСтрока(ПолеСтраны) Тогда
				СтранаСтр = НазваниеСтраны(ТекстЗначения(Ст.СтранаСтр));
			КонецЕсли;
			Список.Добавить(Новый Структура("Товар, Штук, Цена, Упак, УпакТекст, ВысотаСтр, Короб, ВидСтр, СтранаСтр",
				Ст.Товар, ЧислоИлиНоль(Ст.Кол) * Коэф, Цена, Упак, УпакТекст, ВысотаСтр, Короб, ВидСтр, СтранаСтр));
			Товары.Добавить(Ст.Товар);
		КонецЦикла;
		Сведения = СведенияОТоварах(Товары, НужныЦеныРегистра);

		Для Каждого Док Из ТаблДокументов Цикл
			СтатИнвойсов.Прочитано = СтатИнвойсов.Прочитано + 1;
			ТекстВида = "";
			Если ЕстьВидДок Тогда
				ТекстВида = ТекстЗначения(Док.ВидДок);
			КонецЕсли;
			Если Не ПустаяСтрока(Нас("invoice_kinds")) И Не СодержитСлово(ТекстВида, "", Нас("invoice_kinds")) Тогда
				ПропущеноПоВиду = ПропущеноПоВиду + 1;
				Продолжить;
			КонецЕсли;
			Штучный = СодержитСлово(ТекстВида, "", Нас("piece_words"));
			ТекстСтраны = "";
			Если ЕстьСтрана Тогда
				ТекстСтраны = ТекстЗначения(Док.СтранаШапки);
			КонецЕсли;
			// страна: из шапки документа, потом из «вида документа» («Инвойс срезка эквадор»), потом из названия документа
			СтранаДок = СтранаПоТексту(ТекстСтраны);
			Если ПустаяСтрока(СтранаДок) Тогда
				СтранаДок = СтранаПоТексту(ТекстВида);
			КонецЕсли;
			Если ПустаяСтрока(СтранаДок) Тогда
				СтранаДок = СтранаПоТексту(ОбъектМД.Синоним + " " + ОбъектМД.Имя);
			КонецЕсли;
			Если ПустаяСтрока(СтранаДок) Тогда
				СтранаДок = НазваниеСтраны(ТекстСтраны);
			КонецЕсли;
			Инв = Новый Структура;
			Инв.Вставить("Ид", ОбъектМД.Имя + "-" + СокрЛП(Док.Номер));
			Инв.Вставить("Номер", СокрЛП(Док.Номер));
			Инв.Вставить("Дата", Док.ДатаДок);
			Инв.Вставить("Вид", ОбъектМД.Синоним);
			Инв.Вставить("ВидДок", ТекстВида);
			Инв.Вставить("Штучный", Штучный);
			Инв.Вставить("СтранаДок", СтранаДок);
			Инв.Вставить("Страна", СтранаДок);
			Инв.Вставить("Поля", ОписаниеПолей);
			Поставщик = "";
			Если ЕстьПоставщик Тогда
				Поставщик = СокрЛП(Строка(Док.Поставщик));
			КонецЕсли;
			Инв.Вставить("Поставщик", Поставщик);
			Инв.Вставить("Проведен", Док.Проведен);
			Если Док.Удален Тогда
				Статус = "cancelled";
			ИначеЕсли Нас("transit_rule") = "future" Тогда
				Статус = ?(Док.ДатаДок > ТекущаяДата(), "in_transit", "received");
			Иначе
				Статус = ?(Док.Проведен, "received", "in_transit");
			КонецЕсли;
			Инв.Вставить("Статус", Статус);

			// строки: складываем одинаковые товары; в штуках
			Свод = Новый Соответствие;
			Порядок = Новый Массив;
			Список = ПоДокументам.Получить(Док.Ссылка);
			Если Список <> Неопределено Тогда
				Для Каждого Эл Из Список Цикл
					Если Сведения.Получить(Эл.Товар) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Накоплено = Свод.Получить(Эл.Товар);
					Если Накоплено = Неопределено Тогда
						Свод.Вставить(Эл.Товар, Новый Структура("Штук, Цена, Упак, УпакТекст, Высота, Короб, ВидСтр, СтранаСтр",
							Эл.Штук, Эл.Цена, Эл.Упак, Эл.УпакТекст, Эл.ВысотаСтр, Эл.Короб, Эл.ВидСтр, Эл.СтранаСтр));
						Порядок.Добавить(Эл.Товар);
					Иначе
						Накоплено.Штук = Накоплено.Штук + Эл.Штук;
						Если Накоплено.Цена <= 0 Тогда
							Накоплено.Цена = Эл.Цена;
						КонецЕсли;
						Если Накоплено.Упак <= 0 Тогда
							Накоплено.Упак = Эл.Упак;
						КонецЕсли;
						Если Накоплено.Высота <= 0 Тогда
							Накоплено.Высота = Эл.ВысотаСтр;
						КонецЕсли;
						Если ПустаяСтрока(Накоплено.СтранаСтр) Тогда
							Накоплено.СтранаСтр = Эл.СтранаСтр;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			СтрокиИнв = Новый Массив;
			СчетСтран = Новый Соответствие;
			ЛучшаяСтрана = "";
			ЛучшийСчет = 0;
			Для Каждого Товар Из Порядок Цикл
				Накоплено = Свод.Получить(Товар);
				Св = Сведения.Получить(Товар);
				ВидТовара = ?(ПустаяСтрока(Св.Вид), Накоплено.ВидСтр, Св.Вид);
				// штучный товар (аксессуары, горшки) продаётся по одному: пачка = 1
				УпакИтог = ?(Штучный, 1, Накоплено.Упак);
				СтрокиИнв.Добавить(Новый Структура("Св, Штук, ШтукДок, Цена, Упак, УпакТекст, Высота, Короб, Вид, СтранаСтр",
					Св, Окр(Накоплено.Штук), Окр(Накоплено.Штук), Накоплено.Цена, УпакИтог, Накоплено.УпакТекст, Накоплено.Высота, Накоплено.Короб, ВидТовара, Накоплено.СтранаСтр));
				Если Не ПустаяСтрока(Накоплено.СтранаСтр) Тогда
					СколькоСтрок = СчетСтран.Получить(Накоплено.СтранаСтр);
					СколькоСтрок = ?(СколькоСтрок = Неопределено, 1, СколькоСтрок + 1);
					СчетСтран.Вставить(Накоплено.СтранаСтр, СколькоСтрок);
					Если СколькоСтрок > ЛучшийСчет Тогда
						ЛучшийСчет = СколькоСтрок;
						ЛучшаяСтрана = Накоплено.СтранаСтр;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если ПустаяСтрока(СтранаДок) Тогда
				Инв.Вставить("Страна", ЛучшаяСтрана);
			КонецЕсли;
			Инв.Вставить("Строки", СтрокиИнв);
			Результат.Добавить(Инв);
		КонецЦикла;
	КонецЦикла;
	Если Найдено = 0 Тогда
		Пишу("Документов с названием, содержащим «" + Нас("invoice_words") + "», не найдено (настройка invoice_words).");
	КонецЕсли;
	Если ПропущеноПоВиду > 0 Тогда
		Пишу("Пропущено по виду документа (настройка invoice_kinds = «" + Нас("invoice_kinds") + "»): " + Формат(ПропущеноПоВиду, "ЧГ=0") + " шт.");
	КонецЕсли;

	// Складской остаток распределяем от новых инвойсов к старым: при выдаче FIFO он чаще в новых партиях.
	// (старые цветы продаются раньше). Так на сайте не будет товара, которого уже нет.
	Если Нас("cap_stock") = "1" Тогда
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("Инв");
		Таблица.Колонки.Добавить("Дата");
		Для Каждого Инв Из Результат Цикл
			Если Инв.Статус = "received" Тогда
				Новая = Таблица.Добавить();
				Новая.Инв = Инв;
				Новая.Дата = Инв.Дата;
			КонецЕсли;
		КонецЦикла;
		Таблица.Сортировать("Дата Убыв");
		Осталось = Новый Соответствие;
		Для Каждого Эл Из Таблица Цикл
			Для Каждого Ст Из Эл.Инв.Строки Цикл
				Дост = Осталось.Получить(Ст.Св.Ссылка);
				Если Дост = Неопределено Тогда
					Дост = Ст.Св.Стеблей;
				КонецЕсли;
				Кол = Мин(Ст.ШтукДок, Дост);
				Ст.Штук = Кол;
				Осталось.Вставить(Ст.Св.Ссылка, Дост - Кол);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Если Полный Тогда
		Актуальные = Новый Массив;
		Для Каждого Инв Из Результат Цикл
			ЕстьОстаток = Инв.Статус <> "received";
			Если Инв.Статус = "received" Тогда
				Для Каждого Ст Из Инв.Строки Цикл
					Если Ст.Штук > 0 Тогда
						ЕстьОстаток = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если ЕстьОстаток Тогда
				Актуальные.Добавить(Инв);
			Иначе
				СтатИнвойсов.Пустых = СтатИнвойсов.Пустых + 1;
			КонецЕсли;
		КонецЦикла;
		Результат = Актуальные;
	КонецЕсли;
	СтатИнвойсов.Отправляется = Результат.Количество();
	Возврат Результат;

КонецФункции

Процедура ДействиеИнвойсыПоказать()

	Инвойсы = ПодготовитьИнвойсы();
	Если СтатИнвойсов.Полный Тогда
		Пишу("ПОЛНЫЙ АКТУАЛЬНЫЙ СПИСОК: прочитано для расчёта " + Формат(СтатИнвойсов.Прочитано, "ЧГ=0")
			+ " инвойсов; к отправке " + Формат(СтатИнвойсов.Отправляется, "ЧГ=0")
			+ "; пустых оприходованных исключено " + Формат(СтатИнвойсов.Пустых, "ЧГ=0") + ".");
		Пишу("Для остатков учтены ВСЕ проведённые инвойсы; «в пути» и отмены — за " + Нас("invoice_days") + " дн. и будущие. Отсутствующие на сайте старые позиции будут сняты с продажи.");
		Пишу("Остаток склада распределяется по инвойсам расчётно, от новых к старым: это не точный учёт по партиям.");
	Иначе
		Пишу("Инвойсов к отправке за " + Нас("invoice_days") + " дн. (и будущие): " + Формат(Инвойсы.Количество(), "ЧГ=0")
			+ ". Режим частичной выгрузки: старые поставки по отсутствию НЕ закрываются.");
	КонецЕсли;
	Пишу("«В пути» = " + ?(Нас("transit_rule") = "future", "дата документа в будущем", "документ не проведён") + ".");
	Пишу("Склад: «" + Нас("warehouse") + "». Остаток склада ограничивает оприходованные инвойсы: " + ?(Нас("cap_stock") = "1", "да", "нет") + ".");
	Если Инвойсы.Количество() > 200 Тогда
		Пишу("СТОП: к отправке больше 200 инвойсов. Сервер принимает не больше 200 за раз; неполный список НЕ отправляем.");
		Возврат;
	КонецЕсли;
	Если Инвойсы.Количество() = 0 Тогда
		Пишу("Актуальных поставок и остатков нет. При полном режиме пункт 7 проверит закрытие всех старых позиций на сайте.");
		Возврат;
	КонецЕсли;
	Пишу("Откуда взяты поля: " + Инвойсы[0].Поля);
	// сколько инвойсов каждого вида документа
	ПоВидам = Новый Соответствие;
	ПорядокВидов = Новый Массив;
	Для Каждого Инв Из Инвойсы Цикл
		ВидКлюч = ?(ПустаяСтрока(Инв.ВидДок), Инв.Вид, Инв.ВидДок);
		СколькоВидов = ПоВидам.Получить(ВидКлюч);
		Если СколькоВидов = Неопределено Тогда
			ПорядокВидов.Добавить(ВидКлюч);
			СколькоВидов = 0;
		КонецЕсли;
		ПоВидам.Вставить(ВидКлюч, СколькоВидов + 1);
	КонецЦикла;
	Для Каждого ВидКлюч Из ПорядокВидов Цикл
		Пишу("  вид документа «" + ВидКлюч + "»: " + Формат(ПоВидам.Получить(ВидКлюч), "ЧГ=0") + " инв.");
	КонецЦикла;
	Пишу("");
	Пишу("номер | дата | вид документа | поставщик | страна | проведён | отправится как | строк | штук по документу | штук к отправке | строк без цены | штучный");
	ПолученоПоДок = 0;
	ПолученоК = 0;
	СтрокВсего = 0;
	БезПачки = 0;
	БезВысоты = 0;
	Для Каждого Инв Из Инвойсы Цикл
		ШтукДок = 0;
		Штук = 0;
		БезЦены = 0;
		Для Каждого Ст Из Инв.Строки Цикл
			ШтукДок = ШтукДок + Ст.ШтукДок;
			Штук = Штук + Ст.Штук;
			СтрокВсего = СтрокВсего + 1;
			Если ЦенаСтроки(Ст) <= 0 Тогда
				БезЦены = БезЦены + 1;
			КонецЕсли;
			Если Ст.Упак <= 0 Тогда
				БезПачки = БезПачки + 1;
			КонецЕсли;
			Если ВысотаСтроки(Ст) <= 0 Тогда
				БезВысоты = БезВысоты + 1;
			КонецЕсли;
		КонецЦикла;
		Если Инв.Статус = "received" Тогда
			ПолученоПоДок = ПолученоПоДок + ШтукДок;
			ПолученоК = ПолученоК + Штук;
		КонецЕсли;
		Пишу(Инв.Номер + " | " + Формат(Инв.Дата, "ДФ=dd.MM.yyyy") + " | " + ?(ПустаяСтрока(Инв.ВидДок), Инв.Вид, Инв.ВидДок) + " | " + Инв.Поставщик + " | "
			+ ?(ПустаяСтрока(Инв.Страна), "(страна не определена)", Инв.Страна) + " | " + ?(Инв.Проведен, "да", "нет") + " | " + Инв.Статус
			+ " | " + Формат(Инв.Строки.Количество(), "ЧГ=0") + " | " + Формат(ШтукДок, "ЧГ=0") + " | " + Формат(Штук, "ЧГ=0") + " | " + Формат(БезЦены, "ЧГ=0")
			+ " | " + ?(Инв.Штучный, "штучный", ""));
	КонецЦикла;
	Пишу("");
	Пишу("Строк товаров всего: " + Формат(СтрокВсего, "ЧГ=0") + "; без размера пачки в 1С: " + Формат(БезПачки, "ЧГ=0")
		+ " (для новых товаров возьмётся по виду); без высоты ни в строке, ни в карточке: " + Формат(БезВысоты, "ЧГ=0") + " (сайт попробует угадать по названию).");
	Если ПолученоПоДок > 0 И ПолученоК = 0 Тогда
		Пишу("ВНИМАНИЕ: оприходовано по документам " + Формат(ПолученоПоДок, "ЧГ=0") + " шт, а на складе «" + Нас("warehouse")
			+ "» по этим товарам 0. Скорее всего, склад выбран не тот (пункт 2) или остатки хранятся иначе.");
	КонецЕсли;

	Пишу("");
	Пишу("Примеры строк (самые свежие инвойсы, так увидит сайт): [инвойс] название | вид | высота | страна | пачка | «Упаковка» в 1С | «В коробке» в 1С | цена за штуку | штук по документу | штук к отправке");
	Показано = 0;
	Всего = Инвойсы.Количество();
	Для Номер = 1 По Всего Цикл
		Инв = Инвойсы[Всего - Номер];
		ВИнвойсе = 0;
		Для Каждого Ст Из Инв.Строки Цикл
			Если ВИнвойсе >= 3 Или Показано >= 18 Тогда
				Прервать;
			КонецЕсли;
			ВИнвойсе = ВИнвойсе + 1;
			Показано = Показано + 1;
			Св = Ст.Св;
			Пишу("[" + Инв.Номер + "] " + Св.Имя + " | " + Ст.Вид + " | " + Формат(ВысотаСтроки(Ст), "ЧГ=0") + " | " + СтранаСтроки(Инв, Ст)
				+ " | " + ?(Ст.Упак > 0, Формат(Ст.Упак, "ЧГ=0"), "нет в 1С, будет " + Формат(ПачкаПоВиду(Ст.Вид, Св.Имя), "ЧГ=0") + " по виду")
				+ " | " + Ст.УпакТекст + " | " + Формат(Ст.Короб, "ЧГ=0") + " | " + Формат(ЦенаСтроки(Ст), "ЧДЦ=2; ЧРД=,; ЧГ=0")
				+ " | " + Формат(Ст.ШтукДок, "ЧГ=0") + " | " + Формат(Ст.Штук, "ЧГ=0"));
		КонецЦикла;
		Если Показано >= 18 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Что стоит проверить глазами до отправки: размер пачки, которого нет в 1С (сайт возьмёт его по виду товара),
	// и остатки меньше одной пачки (на сайте их не будет: продаём целыми пачками).
	СписокБезПачки = Новый Массив;
	СписокМеньшеПачки = Новый Массив;
	Для Каждого Инв Из Инвойсы Цикл
		Если Инв.Статус = "cancelled" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ст Из Инв.Строки Цикл
			Если Ст.Штук <= 0 Тогда
				Продолжить;
			КонецЕсли;
			ПачкаСтроки = Ст.Упак;
			ПачкаИзЕдиниц = Ложь;
			Если ПачкаСтроки <= 0 И Ст.Св.УпаковкаИзЕдиниц Тогда
				ПачкаСтроки = Ст.Св.Упаковка;
				ПачкаИзЕдиниц = Истина;
			КонецЕсли;
			Если ПачкаСтроки <= 0 Тогда
				ПачкаСтроки = ПачкаПоВиду(Ст.Вид, Ст.Св.Имя);
				СписокБезПачки.Добавить("[" + Инв.Номер + "] " + Ст.Св.Имя + " | " + Ст.Вид + " | будет " + Формат(ПачкаСтроки, "ЧГ=0")
					+ " шт в пачке | штук " + Формат(Ст.Штук, "ЧГ=0"));
			КонецЕсли;
			Если ПачкаСтроки > 1 И Ст.Штук < ПачкаСтроки Тогда
				СписокМеньшеПачки.Добавить("[" + Инв.Номер + "] " + Ст.Св.Имя + " | штук " + Формат(Ст.Штук, "ЧГ=0")
					+ " | пачка " + Формат(ПачкаСтроки, "ЧГ=0"));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Пишу("");
	Пишу("ПРОВЕРЬТЕ РАЗМЕР ПАЧКИ: в 1С он не указан у " + Формат(СписокБезПачки.Количество(), "ЧГ=0") + " строк - сайт возьмёт его по виду товара (роза 25, гвоздика 20, тюльпан 50, кустовая и российская роза 10, остальное 10).");
	Пишу("Если у товара пачка другая, заполните «В пачке» в строке инвойса в 1С и отправьте заново, либо поправьте «Упак.» в карточке товара на сайте (админка -> Справочник).");
	Если СписокБезПачки.Количество() > 0 Тогда
		Пишу("[инвойс] название | вид | какая пачка будет | штук к отправке");
		Для Каждого Эл Из СписокБезПачки Цикл
			Пишу("  " + Эл);
		КонецЦикла;
	КонецЕсли;
	Пишу("");
	Пишу("ОСТАТОК МЕНЬШЕ ОДНОЙ ПАЧКИ (" + Формат(СписокМеньшеПачки.Количество(), "ЧГ=0") + " строк): на сайте эти позиции не появятся, продаём только целыми пачками.");
	Если СписокМеньшеПачки.Количество() > 0 Тогда
		Пишу("[инвойс] название | штук осталось | пачка");
		Для Каждого Эл Из СписокМеньшеПачки Цикл
			Пишу("  " + Эл);
		КонецЦикла;
	КонецЕсли;

	Пишу("");
	Пишу("Для сверки с 1С: откройте инвойс и сравните итог «Приход количество» с числом ниже (штук по документу):");
	НомерИнв = 0;
	Для Каждого Инв Из Инвойсы Цикл
		НомерИнв = НомерИнв + 1;
		Если НомерИнв > 3 Тогда
			Прервать;
		КонецЕсли;
		ПоДок = 0;
		Для Каждого Ст Из Инв.Строки Цикл
			ПоДок = ПоДок + Ст.ШтукДок;
		КонецЦикла;
		Пишу("  инвойс " + Инв.Номер + ": " + Формат(ПоДок, "ЧГ=0") + " шт");
	КонецЦикла;
	Пишу("");
	Пишу("Ничего не отправлено. in_transit = в пути (клиенты увидят «Товары в пути»), received = уже оприходован, cancelled = отменён.");

КонецПроцедуры

Функция ТелоИнвойсов(Инвойсы)

	Документ = Новый ТекстовыйДокумент;
	Префикс = "{";
	Если СтатИнвойсов.Полный Тогда
		Префикс = Префикс + """full"":true,";
		Если Инвойсы.Количество() = 0 Тогда
			Префикс = Префикс + """allow_empty"":true,";
		КонецЕсли;
	КонецЕсли;
	Документ.ДобавитьСтроку(Префикс + """supplies"":[");
	Номер = 0;
	Для Каждого Инв Из Инвойсы Цикл
		Номер = Номер + 1;
		Части = Новый Массив;
		Части.Добавить("""id"":" + JSONСтрока(Инв.Ид));
		Части.Добавить("""number"":" + JSONСтрока(Инв.Номер));
		Части.Добавить("""status"":" + JSONСтрока(Инв.Статус));
		// строки (price - за штуку, quantity - в штуках) нужны и «в пути», и оприходованным:
		// сайт показывает каждую строку инвойса отдельной карточкой. Для оприходованного инвойса
		// quantity - то, что осталось на складе (см. настройку cap_stock), для «в пути» - по документу
		Если Инв.Статус <> "cancelled" Тогда
			Части.Добавить("""date"":" + JSONСтрока(Формат(Инв.Дата, "ДФ=yyyy-MM-dd")));
			Если Не ПустаяСтрока(Инв.Страна) Тогда
				Части.Добавить("""country"":" + JSONСтрока(Инв.Страна));
			КонецЕсли;
			Если Не ПустаяСтрока(Инв.Поставщик) Тогда
				Части.Добавить("""supplier"":" + JSONСтрока(Инв.Поставщик));
			КонецЕсли;
			Линии = Новый Массив;
			Для Каждого Ст Из Инв.Строки Цикл
				Если Ст.Штук <= 0 Тогда
					Продолжить;
				КонецЕсли;
				Св = Ст.Св;
				Поля = Новый Массив;
				Поля.Добавить("""id"":" + JSONСтрока(Св.GUID));
				Если Не ПустаяСтрока(Св.Артикул) Тогда
					Поля.Добавить("""sku"":" + JSONСтрока(Св.Артикул));
				КонецЕсли;
				Поля.Добавить("""name"":" + JSONСтрока(Св.Имя));
				Если Не ПустаяСтрока(Ст.Вид) Тогда
					Поля.Добавить("""kind"":" + JSONСтрока(Ст.Вид));
				КонецЕсли;
				Если ВысотаСтроки(Ст) > 0 Тогда
					Поля.Добавить("""height"":" + ЧислоJSON(ВысотаСтроки(Ст), 0));
				КонецЕсли;
				СтранаЛинии = СтранаСтроки(Инв, Ст);
				Если Не ПустаяСтрока(СтранаЛинии) Тогда
					Поля.Добавить("""country"":" + JSONСтрока(СтранаЛинии));
				КонецЕсли;
				Поля.Добавить("""price"":" + ЧислоJSON(ЦенаСтроки(Ст), 2));
				Поля.Добавить("""quantity"":" + ЧислоJSON(Ст.Штук, 0));
				Если Ст.Упак > 0 Тогда
					Поля.Добавить("""package_size"":" + ЧислоJSON(Ст.Упак, 0));
				ИначеЕсли Св.УпаковкаИзЕдиниц Тогда
					Поля.Добавить("""package_size"":" + ЧислоJSON(Св.Упаковка, 0));
				Иначе
					Поля.Добавить("""package_size_hint"":" + ЧислоJSON(ПачкаПоВиду(Ст.Вид, Св.Имя), 0));
				КонецЕсли;
				Линии.Добавить("{" + СоединитьСтроки(Поля, ",") + "}");
			КонецЦикла;
			Части.Добавить("""items"":[" + СоединитьСтроки(Линии, ",") + "]");
		КонецЕсли;
		Документ.ДобавитьСтроку("{" + СоединитьСтроки(Части, ",") + "}" + ?(Номер < Инвойсы.Количество(), ",", ""));
	КонецЦикла;
	Документ.ДобавитьСтроку("]}");
	Возврат Документ.ПолучитьТекст();

КонецФункции

Процедура ОтправитьИнвойсы(ПроверкаБезСохранения)

	Если ПустаяСтрока(Нас("key")) Тогда
		Пишу("Не задан ключ доступа: пункт 2 (первая настройка).");
		Возврат;
	КонецЕсли;
	Инвойсы = ПодготовитьИнвойсы();
	Если СтатИнвойсов.Полный И Инвойсы.Количество() = 0 И СтатИнвойсов.Прочитано = 0 Тогда
		Пишу("СТОП: 1С не прочитала ни одного инвойса. Пустой полный список в этом случае опасен и НЕ отправляется. Проверьте invoice_words и структуру документов.");
		Возврат;
	КонецЕсли;
	Если Инвойсы.Количество() > 200 Тогда
		Пишу("СТОП: к отправке " + Формат(Инвойсы.Количество(), "ЧГ=0") + " инвойсов, а сервер принимает не больше 200. Ничего не отправлено: неполный полный список опасен.");
		Возврат;
	КонецЕсли;
	Если Инвойсы.Количество() = 0 И Не СтатИнвойсов.Полный Тогда
		Пишу("Инвойсов для отправки нет. На сайт ничего не ушло.");
		Возврат;
	КонецЕсли;
	Если Не ПроверкаБезСохранения Тогда
		ТекстПодтверждения = "Отправить на сайт " + Формат(Инвойсы.Количество(), "ЧГ=0") + " инвойсов ПО-НАСТОЯЩЕМУ?";
		Если СтатИнвойсов.Полный Тогда
			ТекстПодтверждения = ТекстПодтверждения + Символы.ПС + "Это полный актуальный список: отсутствующие старые поставки будут закрыты, их остатки обнулены.";
		КонецЕсли;
		Если Инвойсы.Количество() = 0 Тогда
			ТекстПодтверждения = ТекстПодтверждения + Символы.ПС + "ВНИМАНИЕ: список пуст. Это отдельно подтверждает, что актуальных поставок и остатков не осталось. Все старые поставки из 1С на сайте будут закрыты.";
		Иначе
			ТекстПодтверждения = ТекстПодтверждения + Символы.ПС + "«В пути» увидят клиенты и смогут сделать предзаказ.";
		КонецЕсли;
		Если Не Подтвердить(ТекстПодтверждения + Символы.ПС + "Сначала лучше сделать пункт 7 (проверка на сайте).") Тогда
			Пишу("Отправка отменена.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Ответ = ВызватьСайт("POST", "/api/1c/supplies/sync" + ?(ПроверкаБезСохранения, "?dry_run=1", ""), ТелоИнвойсов(Инвойсы));
	Пишу(?(ПроверкаБезСохранения, "ПРОВЕРКА на сайте (ничего не сохранено)", "ОТПРАВКА инвойсов на сайт") + ": " + Формат(Инвойсы.Количество(), "ЧГ=0") + " шт.");
	Названия = Новый Соответствие;
	Названия.Вставить("created", "новых поставок");
	Названия.Вставить("updated", "обновлено");
	Названия.Вставить("received", "принято (оприходовано)");
	Названия.Вставить("cancelled", "отменено");
	Названия.Вставить("closed", "закрыто по полному списку");
	Названия.Вставить("skipped", "пропущено");
	Названия.Вставить("lines", "строк товаров");
	Названия.Вставить("products_created", "новых товаров");
	Названия.Вставить("preorders_fulfilled", "предзаказов выполнено");
	Названия.Вставить("errors_total", "ошибок");
	ИтогОтвета(Ответ, Названия);

КонецПроцедуры

// ----------------------------------------------------------------------------
// Заказы с сайта: показать и подтвердить
// ----------------------------------------------------------------------------

Функция ЗагрузитьЗаказы()

	Ответ = ВызватьСайт("GET", "/api/1c/orders/export?new=1&format=csv");
	Если Не ПустаяСтрока(Ответ.Ошибка) Или Ответ.Код <> 200 Тогда
		Пишу("Не удалось получить заказы: " + ОписатьОтвет(Ответ));
		Возврат Неопределено;
	КонецЕсли;
	Текст = Ответ.Текст;
	Если КодСимвола(Лев(Текст, 1)) = 65279 Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Возврат РазобратьCSV(Текст);

КонецФункции

Функция Колонка(Заголовок, Имя)

	Индекс = Заголовок.Найти(Имя);
	Возврат ?(Индекс = Неопределено, -1, Индекс);

КонецФункции

Функция ЗначениеПоля(Линия, Индекс)

	Если Индекс < 0 Или Индекс >= Линия.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Линия[Индекс];

КонецФункции

Процедура ДействиеЗаказыПоказать()

	Таблица = ЗагрузитьЗаказы();
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Таблица.Количество() < 2 Тогда
		Пишу("Новых заказов на сайте нет.");
		Возврат;
	КонецЕсли;
	Шапка = Таблица[0];
	кНомер = Колонка(Шапка, "order_number");
	кКогда = Колонка(Шапка, "date");
	кНужно = Колонка(Шапка, "desired_date");
	кСпособ = Колонка(Шапка, "delivery_method");
	кАдрес = Колонка(Шапка, "delivery_address");
	кФирма = Колонка(Шапка, "counterparty_name");
	кИНН = Колонка(Шапка, "counterparty_inn");
	кТелефон = Колонка(Шапка, "counterparty_phone");
	кКомм = Колонка(Шапка, "comment");
	кСкидка = Колонка(Шапка, "discount_percent");
	кИтого = Колонка(Шапка, "order_total");
	кАртикул = Колонка(Шапка, "sku");
	кИмя = Колонка(Шапка, "name");
	кВУпак = Колонка(Шапка, "package_size");
	кШтук = Колонка(Шапка, "quantity");
	кЦена = Колонка(Шапка, "price");
	кСумма = Колонка(Шапка, "sum");
	кПоставка = Колонка(Шапка, "supply_number");

	Последний = "";
	Заказов = 0;
	Для Номер = 1 По Таблица.Количество() - 1 Цикл
		Ст = Таблица[Номер];
		НомерЗаказа = ЗначениеПоля(Ст, кНомер);
		Если НомерЗаказа <> Последний Тогда
			Последний = НомерЗаказа;
			Заказов = Заказов + 1;
			Пишу("");
			Пишу("=== ЗАКАЗ " + НомерЗаказа + " от " + ЗначениеПоля(Ст, кКогда) + "; нужен к " + ?(ПустаяСтрока(ЗначениеПоля(Ст, кНужно)), "(не указано)", ЗначениеПоля(Ст, кНужно)));
			Пишу("    Клиент: " + ЗначениеПоля(Ст, кФирма) + ", ИНН " + ЗначениеПоля(Ст, кИНН) + ", " + ЗначениеПоля(Ст, кТелефон));
			Пишу("    Получение: " + ?(ЗначениеПоля(Ст, кСпособ) = "delivery", "доставка, " + ЗначениеПоля(Ст, кАдрес), ?(ЗначениеПоля(Ст, кСпособ) = "pickup", "самовывоз", "(не указано)")));
			Если Не ПустаяСтрока(ЗначениеПоля(Ст, кКомм)) Тогда
				Пишу("    Комментарий клиента: " + ЗначениеПоля(Ст, кКомм));
			КонецЕсли;
			Пишу("    Скидка клиента: " + ЗначениеПоля(Ст, кСкидка) + "%;  итого по заказу: " + ЗначениеПоля(Ст, кИтого) + " ₽");
		КонецЕсли;
		Пишу("      - " + ЗначениеПоля(Ст, кИмя) + " (арт. " + ЗначениеПоля(Ст, кАртикул) + "): "
			+ ЗначениеПоля(Ст, кШтук) + " шт (по " + ЗначениеПоля(Ст, кВУпак) + " в уп.) x " + ЗначениеПоля(Ст, кЦена) + " ₽ = " + ЗначениеПоля(Ст, кСумма) + " ₽"
			+ ?(ПустаяСтрока(ЗначениеПоля(Ст, кПоставка)), "", "; поставка № " + ЗначениеПоля(Ст, кПоставка)));
	КонецЦикла;
	Пишу("");
	Пишу("Заказов: " + Формат(Заказов, "ЧГ=0") + ". Оформите их в 1С, потом нажмите пункт 10 (подтвердить), чтобы они больше не приходили.");

КонецПроцедуры

Процедура ДействиеЗаказыПодтвердить()

	Если ЭтоАвто Тогда
		Пишу("Автоматическое подтверждение заказов запрещено: сотрудник должен создать документ и зарезервировать товар.");
		Возврат;
	КонецЕсли;
	Таблица = ЗагрузитьЗаказы();
	Если Таблица = Неопределено Или Таблица.Количество() < 2 Тогда
		Пишу("Новых заказов нет: подтверждать нечего.");
		Возврат;
	КонецЕсли;
	кИд = Колонка(Таблица[0], "order_id");
	кНомер = Колонка(Таблица[0], "order_number");
	кФирма = Колонка(Таблица[0], "counterparty_name");
	Очередь = Новый Массив;
	Уже = Новый Соответствие;
	Для Номер = 1 По Таблица.Количество() - 1 Цикл
		Ст = Таблица[Номер];
		Ид = ЗначениеПоля(Ст, кИд);
		Если ПустаяСтрока(Ид) Или Уже.Получить(Ид) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уже.Вставить(Ид, Истина);
		НомерЗаказа = ЗначениеПоля(Ст, кНомер);
		Если ПустаяСтрока(НомерЗаказа) Тогда
			НомерЗаказа = "САЙТ-" + Ид;
		КонецЕсли;
		Очередь.Добавить(Новый Структура("Ид, Номер, Клиент", Ид, НомерЗаказа, ЗначениеПоля(Ст, кФирма)));
	КонецЦикла;
	Пишу("Подтверждайте каждый заказ отдельно и только ПОСЛЕ создания документа в 1С и резерва товара.");
	Подтверждения = Новый Массив;
	Для Каждого Заказ Из Очередь Цикл
		Если Не Подтвердить("Заказ " + Заказ.Номер + ", клиент " + Заказ.Клиент + "." + Символы.ПС
			+ "Документ создан в 1С и товар зарезервирован?") Тогда
			Пишу(Заказ.Номер + ": оставлен новым, будет выгружен снова.");
			Продолжить;
		КонецЕсли;
		Номер1С = СпроситьСтроку(Заказ.Номер + ": номер созданного документа 1С (можно оставить пустым)", "", 64);
		Если Номер1С = Неопределено Тогда
			Пишу(Заказ.Номер + ": подтверждение отменено, заказ оставлен новым.");
			Продолжить;
		КонецЕсли;
		Поля = Новый Массив;
		Поля.Добавить("""number"":" + JSONСтрока(Заказ.Номер));
		Если Не ПустаяСтрока(Номер1С) Тогда
			Поля.Добавить("""onec_number"":" + JSONСтрока(Номер1С));
		КонецЕсли;
		Подтверждения.Добавить("{" + СоединитьСтроки(Поля, ",") + "}");
	КонецЦикла;
	Если Подтверждения.Количество() = 0 Тогда
		Пишу("Ни один заказ не подтверждён. На сайт ничего не отправлено.");
		Возврат;
	КонецЕсли;
	Тело = "{""orders"":[" + СоединитьСтроки(Подтверждения, ",") + "]}";
	Ответ = ВызватьСайт("POST", "/api/1c/orders/ack", Тело);
	Если Не ПустаяСтрока(Ответ.Ошибка) Или Ответ.Код <> 200 Тогда
		Пишу("Не удалось подтвердить заказы: " + ОписатьОтвет(Ответ));
		Возврат;
	КонецЕсли;
	Подтверждено = ЧислоИзОтвета(Ответ.Текст, "acked");
	Если Подтверждено = Неопределено Тогда
		Пишу("Неожиданный ответ сайта: " + ОписатьОтвет(Ответ));
	Иначе
		Пишу("Сайт подтвердил заказов: " + Формат(Подтверждено, "ЧГ=0") + " из " + Формат(Подтверждения.Количество(), "ЧГ=0") + ".");
		Если Подтверждено <> Подтверждения.Количество() Тогда
			Пишу("Есть неподтверждённые заказы. Проверьте ошибки ниже и не считайте всю очередь перенесённой.");
		КонецЕсли;
	КонецЕсли;
	Если Найти(Ответ.Текст, """errors"":[{") > 0 Тогда
		Пишу(Лев(Ответ.Текст, 1500));
	КонецЕсли;

КонецПроцедуры

Процедура ДействиеЗаказСтатус()

	Если ЭтоАвто Тогда
		Пишу("Ручная отправка статуса недоступна в автообмене.");
		Возврат;
	КонецЕсли;
	НомерЗаказа = СпроситьСтроку("Номер заказа на сайте: САЙТ-57 или просто 57", "", 40);
	Если НомерЗаказа = Неопределено Или ПустаяСтрока(НомерЗаказа) Тогда
		Пишу("Отправка статуса отменена.");
		Возврат;
	КонецЕсли;
	Если ВРег(Лев(НомерЗаказа, 5)) = "САЙТ-" Тогда
		ЦифрыНомера = Сред(НомерЗаказа, 6);
	Иначе
		ЦифрыНомера = НомерЗаказа;
	КонецЕсли;
	Попытка
		НомерЧислом = Число(ЦифрыНомера);
		Если НомерЧислом <= 0 Тогда
			Пишу("Номер заказа должен быть положительным числом.");
			Возврат;
		КонецЕсли;
	Исключение
		Пишу("Не понятен номер заказа. Введите, например, САЙТ-57 или 57.");
		Возврат;
	КонецПопытки;
	НомерЗаказа = "САЙТ-" + Формат(НомерЧислом, "ЧГ=0");
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить("Подтверждён");
	СписокСтатусов.Добавить("В работе");
	СписокСтатусов.Добавить("Отправлен");
	СписокСтатусов.Добавить("Выполнен");
	СписокСтатусов.Добавить("Отменён");
	Выбран = СписокСтатусов.ВыбратьЭлемент("Новый статус заказа " + НомерЗаказа);
	Если Выбран = Неопределено Тогда
		Пишу("Отправка статуса отменена.");
		Возврат;
	КонецЕсли;
	НовыйСтатус = Выбран.Значение;
	Номер1С = СпроситьСтроку("Номер документа 1С (необязательно)", "", 64);
	Если Номер1С = Неопределено Тогда
		Пишу("Отправка статуса отменена.");
		Возврат;
	КонецЕсли;
	Комментарий = СпроситьСтроку("Внутренняя заметка сотрудника (необязательно, клиент её не видит)", "", 500);
	Если Комментарий = Неопределено Тогда
		Пишу("Отправка статуса отменена.");
		Возврат;
	КонецЕсли;
	ТекстПодтверждения = "Отправить на сайт статус «" + НовыйСтатус + "» для " + НомерЗаказа + "?";
	Если НовыйСтатус = "Отменён" Тогда
		ТекстПодтверждения = ТекстПодтверждения + Символы.ПС + "ВНИМАНИЕ: товар будет возвращён на сайт, а клиент получит уведомление об отмене.";
	КонецЕсли;
	Если Не Подтвердить(ТекстПодтверждения) Тогда
		Пишу("Отправка статуса отменена.");
		Возврат;
	КонецЕсли;
	Поля = Новый Массив;
	Поля.Добавить("""number"":" + JSONСтрока(НомерЗаказа));
	Поля.Добавить("""status"":" + JSONСтрока(НовыйСтатус));
	Если Не ПустаяСтрока(Номер1С) Тогда
		Поля.Добавить("""onec_number"":" + JSONСтрока(Номер1С));
	КонецЕсли;
	Если Не ПустаяСтрока(Комментарий) Тогда
		Поля.Добавить("""comment"":" + JSONСтрока(Комментарий));
	КонецЕсли;
	Тело = "{""orders"":[{" + СоединитьСтроки(Поля, ",") + "}]}";
	Ответ = ВызватьСайт("POST", "/api/1c/orders/status", Тело);
	Если Не ПустаяСтрока(Ответ.Ошибка) Или Ответ.Код <> 200 Тогда
		Пишу("Не удалось отправить статус: " + ОписатьОтвет(Ответ));
		Возврат;
	КонецЕсли;
	Изменено = ЧислоИзОтвета(Ответ.Текст, "updated");
	БезИзменений = ЧислоИзОтвета(Ответ.Текст, "unchanged");
	Пишу("Ответ сайта: статусов изменено " + Формат(Изменено, "ЧГ=0") + ", без изменений " + Формат(БезИзменений, "ЧГ=0") + ".");
	Если Найти(Ответ.Текст, """errors"":[{") > 0 Тогда
		Пишу("Статус НЕ применён. Ошибка: " + Лев(Ответ.Текст, 1500));
	КонецЕсли;

КонецПроцедуры

