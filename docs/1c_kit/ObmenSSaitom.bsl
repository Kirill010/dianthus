// Показывает длинный текст в окне, которое можно прокручивать и копировать
Процедура ПоказатьЖурнал(Заголовок)

	Текст = СоединитьСтроки(Журнал, Символы.ПС);
	Попытка
		Папка = КаталогНастроек();
		Если Не Новый Файл(Папка).Существует() Тогда
			СоздатьКаталог(Папка);
		КонецЕсли;
		Файл = Новый ТекстовыйДокумент;
		Файл.УстановитьТекст(Текст);
		Файл.Записать(Папка + "last_report.txt", КодировкаТекста.UTF8);
	Исключение
	КонецПопытки;
	Если ЭтоАвто Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Копия = Текст;
		ВвестиСтроку(Копия, Заголовок + "  (Ctrl+A, Ctrl+C - скопировать; OK - закрыть)", 0, Истина);
	Исключение
		Сообщить(Текст);
	КонецПопытки;

КонецПроцедуры

// ----------------------------------------------------------------------------
// Связь с сайтом
// ----------------------------------------------------------------------------

// https://host[:port] -> Структура(Хост, Порт, Ошибка)
Функция РазобратьАдрес(Адрес)

	Результат = Новый Структура("Хост, Порт, Ошибка", "", 443, "");
	Хост = СокрЛП(Адрес);
	Если НРег(Лев(Хост, 8)) = "https://" Тогда
		Хост = Сред(Хост, 9);
	ИначеЕсли НРег(Лев(Хост, 7)) = "http://" Тогда
		Результат.Ошибка = "нужен адрес, начинающийся с https://";
		Возврат Результат;
	КонецЕсли;
	Пока Прав(Хост, 1) = "/" Цикл
		Хост = Лев(Хост, СтрДлина(Хост) - 1);
	КонецЦикла;
	Позиция = Найти(Хост, ":");
	Если Позиция > 0 Тогда
		Попытка
			Результат.Порт = Число(Сред(Хост, Позиция + 1));
		Исключение
			Результат.Ошибка = "неверный порт в адресе";
		КонецПопытки;
		Хост = Лев(Хост, Позиция - 1);
	КонецЕсли;
	Результат.Хост = Хост;
	Возврат Результат;

КонецФункции

// Метод: "GET" или "POST". Путь: "/api/1c/ping". Тело - текст JSON или Неопределено.
// Возвращает Структура(Код, Текст, Ошибка). Сначала средства 1С, при сбое - компонент Windows.
Функция ВызватьСайт(Метод, Путь, Тело = Неопределено, Ключ = Неопределено)

	Результат = Новый Структура("Код, Текст, Ошибка", 0, "", "");
	Адрес = РазобратьАдрес(Нас("site"));
	Если Не ПустаяСтрока(Адрес.Ошибка) Или ПустаяСтрока(Адрес.Хост) Тогда
		Результат.Ошибка = ?(ПустаяСтрока(Адрес.Ошибка), "не указан адрес сайта", Адрес.Ошибка);
		Возврат Результат;
	КонецЕсли;
	КлючДоступа = ?(Ключ = Неопределено, Нас("key"), Ключ);

	Попытка
		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , 120, Новый ЗащищенноеСоединениеOpenSSL());
		Запрос = Новый HTTPЗапрос(Путь);
		Если Не ПустаяСтрока(КлючДоступа) Тогда
			Запрос.Заголовки.Вставить("X-API-Key", КлючДоступа);
		КонецЕсли;
		Если Тело <> Неопределено Тогда
			Запрос.Заголовки.Вставить("Content-Type", "application/json");
			Запрос.УстановитьТелоИзСтроки(Тело, "UTF-8");
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Иначе
			Ответ = Соединение.Получить(Запрос);
		КонецЕсли;
		Результат.Код = Ответ.КодСостояния;
		Результат.Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		Возврат Результат;
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		Объект = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
		ПолныйАдрес = "https://" + Адрес.Хост + ?(Адрес.Порт = 443, "", ":" + Формат(Адрес.Порт, "ЧГ=0")) + Путь;
		Объект.Open(Метод, ПолныйАдрес, Ложь);
		Объект.SetTimeouts(30000, 30000, 120000, 120000);
		Если Не ПустаяСтрока(КлючДоступа) Тогда
			Объект.SetRequestHeader("X-API-Key", КлючДоступа);
		КонецЕсли;
		Если Тело <> Неопределено Тогда
			Объект.SetRequestHeader("Content-Type", "application/json");
			Объект.Send(Тело);
		Иначе
			Объект.Send();
		КонецЕсли;
		Результат.Код = Объект.Status;
		Результат.Текст = Объект.ResponseText;
		Результат.Ошибка = "";
	Исключение
		Результат.Ошибка = Результат.Ошибка + " | COM: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ОписатьОтвет(Ответ)

	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Возврат "НЕ УДАЛОСЬ: " + Ответ.Ошибка;
	КонецЕсли;
	Текст = Ответ.Текст;
	Если КодСимвола(Лев(Текст, 1)) = 65279 Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Текст = Лев(СтрЗаменить(Текст, Символы.ПС, " "), 300);
	Подсказка = "";
	Если Ответ.Код = 401 Тогда
		Подсказка = "  <- ключ неверный или отключён: создайте новый в админке сайта («Интеграция с 1С»)";
	ИначеЕсли Ответ.Код = 403 Тогда
		Подсказка = "  <- ключ ограничен по IP-адресу, а этот компьютер в список не входит";
	ИначеЕсли Ответ.Код = 503 Тогда
		Подсказка = "  <- на сайте обмен выключен: нет ни одного ключа";
	КонецЕсли;
	Возврат "ответ сайта, код " + Формат(Ответ.Код, "ЧГ=0") + ": " + Текст + Подсказка;

КонецФункции

// Короткий итог ответа на загрузку: «создано 3, обновлено 115 ...»
Процедура ИтогОтвета(Ответ, Названия)

	Если Не ПустаяСтрока(Ответ.Ошибка) Или Ответ.Код <> 200 Тогда
		Пишу("Ответ сайта: " + ОписатьОтвет(Ответ));
		Возврат;
	КонецЕсли;
	Строки = Новый Массив;
	Для Каждого Пара Из Названия Цикл
		Значение = ЧислоИзОтвета(Ответ.Текст, Пара.Ключ);
		Если Значение <> Неопределено Тогда
			Строки.Добавить(Пара.Значение + ": " + Формат(Значение, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	Пишу("Ответ сайта: " + СоединитьСтроки(Строки, ", "));
	Ошибок = ЧислоИзОтвета(Ответ.Текст, "errors_total");
	Если Ошибок <> Неопределено И Ошибок > 0 Тогда
		Пишу("Строки с ошибками (первые):");
		Текст = Ответ.Текст;
		Позиция = Найти(Текст, """errors""");
		Если Позиция > 0 Тогда
			Пишу(Лев(Сред(Текст, Позиция), 1500));
		КонецЕсли;
	КонецЕсли;
	Позиция = Найти(Ответ.Текст, """warnings""");
	Если Позиция > 0 Тогда
		Пишу(Лев(Сред(Ответ.Текст, Позиция), 600));
	КонецЕсли;

КонецПроцедуры

// ----------------------------------------------------------------------------
// Поиск объектов и полей в метаданных
// ----------------------------------------------------------------------------

// Имя первого поля из коллекции (измерения/ресурсы/реквизиты), совпавшего с вариантом
Функция ПервоеПоле(Коллекция, Варианты)

	Для Каждого Вариант Из РазделитьСтроку(Варианты, "|") Цикл
		Если Коллекция.Найти(Вариант) <> Неопределено Тогда
			Возврат Вариант;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ИменаПолей(КоллекцияПолей)

	Имена = Новый Массив;
	Для Каждого Поле Из КоллекцияПолей Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	Возврат СоединитьСтроки(Имена, ", ");

КонецФункции

// Справочник, имя которого совпало с одним из вариантов («ТипыЦенНоменклатуры|ВидыЦен»)
Функция НайтиСправочник(Варианты)

	Для Каждого Вариант Из РазделитьСтроку(Варианты, "|") Цикл
		ОбъектМД = Метаданные.Справочники.Найти(Вариант);
		Если ОбъектМД <> Неопределено Тогда
			Возврат ОбъектМД;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Элемент справочника по названию из настроек (точное совпадение); пустая ссылка, если нет
Функция НайтиЭлемент(ИмяСправочника, Название)

	Если ПустаяСтрока(Название) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники[ИмяСправочника].НайтиПоНаименованию(Название, Истина);

КонецФункции

// Список «название -> ссылка» из справочника (для выбора в диалоге)
Функция СписокЭлементов(ИмяСправочника, Группы = Ложь, Лимит = 60)

	Список = Новый СписокЗначений;
	ОбъектМД = Метаданные.Справочники.Найти(ИмяСправочника);
	Если ОбъектМД = Неопределено Тогда
		Возврат Список;
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0"));
	Строки.Добавить("	С.Ссылка КАК Ссылка,");
	Строки.Добавить("	С.Наименование КАК Имя");
	Строки.Добавить("ИЗ Справочник." + ИмяСправочника + " КАК С");
	Строки.Добавить("ГДЕ С.ПометкаУдаления = ЛОЖЬ");
	Если ОбъектМД.Иерархический Тогда
		Если Группы Тогда
			Строки.Добавить("	И С.ЭтоГруппа = ИСТИНА");
			Строки.Добавить("	И С.Родитель = ЗНАЧЕНИЕ(Справочник." + ИмяСправочника + ".ПустаяСсылка)");
		Иначе
			Строки.Добавить("	И С.ЭтоГруппа = ЛОЖЬ");
		КонецЕсли;
	КонецЕсли;
	Строки.Добавить("УПОРЯДОЧИТЬ ПО С.Наименование");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Имя, Выборка.Имя);
	КонецЦикла;
	Возврат Список;

КонецФункции

// ----------------------------------------------------------------------------
// Первая настройка
// ----------------------------------------------------------------------------

Процедура Настроить()

	Пишу("НАСТРОЙКА. Файл настроек: " + КаталогНастроек() + "settings.ini");

	Значение = СпроситьСтроку("Адрес сайта (начинается с https://)", Нас("site"));
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Настройки.Вставить("site", Значение);

	Значение = СпроситьСтроку("Ключ доступа из админки сайта («Интеграция с 1С»); начинается с dnt_", Нас("key"), 100);
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Настройки.Вставить("key", Значение);

	Попытка
		Список = СписокЭлементов("Номенклатура", Истина);
		Если Список.Количество() > 0 Тогда
			Элемент = Список.ВыбратьЭлемент("Какую группу номенклатуры показывать на сайте? (например, «Срезанные цветы»)");
			Если Элемент <> Неопределено Тогда
				Настройки.Вставить("group", Элемент.Значение);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Пишу("Группы номенклатуры не прочитаны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Список = СписокЭлементов("Склады");
		Если Список.Количество() > 0 Тогда
			Элемент = Список.ВыбратьЭлемент("С какого склада брать остатки для сайта?");
			Если Элемент <> Неопределено Тогда
				Настройки.Вставить("warehouse", Элемент.Значение);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Пишу("Склады не прочитаны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		МДТипов = НайтиСправочник("ТипыЦенНоменклатуры|ВидыЦен|ТипыЦен");
		Если МДТипов <> Неопределено Тогда
			Список = СписокЭлементов(МДТипов.Имя);
			Если Список.Количество() > 0 Тогда
				Элемент = Список.ВыбратьЭлемент("Какой тип цен показывать оптовым клиентам на сайте?");
				Если Элемент <> Неопределено Тогда
					Настройки.Вставить("price_type", Элемент.Значение);
				КонецЕсли;
			КонецЕсли;
		Иначе
			Пишу("Справочник типов цен не найден: впишите price_type в settings.ini вручную.");
		КонецЕсли;
	Исключение
		Пишу("Типы цен не прочитаны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	СохранитьНастройки();
	Пишу("");
	Пишу("Сохранено:");
	ПоказатьНастройки();

КонецПроцедуры

Процедура ПоказатьНастройки()

	Пишу("  Сайт:               " + Нас("site"));
	Пишу("  Ключ:               " + КлючКратко());
	Пишу("  Группа товаров:     " + Нас("group"));
	Пишу("  Склад:              " + Нас("warehouse"));
	Пишу("  Тип цен:            " + ?(ПустаяСтрока(Нас("price_type")), "(не выбран)", Нас("price_type")));
	Пишу("  Признаки упаковки:  " + Нас("pack_words") + "  (если не найдена, по умолчанию " + Нас("default_pack") + " шт)");
	Пишу("  Вычитать резервы:   " + ?(Нас("use_reserves") = "1", "да", "нет"));
	Пишу("  Инвойсы:            слова «" + Нас("invoice_words") + "», за " + Нас("invoice_days") + " дн., «в пути» = " + ?(Нас("transit_rule") = "future", "дата в будущем", "не проведён"));
	Пишу("  Автообмен:          каталог " + ?(Нас("auto_catalog") = "1", "ВКЛ", "выкл") + ", инвойсы " + ?(Нас("auto_invoices") = "1", "ВКЛ", "выкл"));

КонецПроцедуры

// ----------------------------------------------------------------------------
// Сведения о товарах: цена, остаток, упаковка
// ----------------------------------------------------------------------------

// Склады из настроек (массив ссылок)
Функция СкладыИзНастроек()

	Результат = Новый Массив;
	Для Каждого Название Из РазделитьСтроку(Нас("warehouse"), ";") Цикл
		Ссылка = НайтиЭлемент("Склады", СокрЛП(Название));
		Если Ссылка <> Неопределено И ЗначениеЗаполнено(Ссылка) Тогда
			Результат.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Остатки по товарам: Соответствие «ссылка -> количество в единицах хранения»
Функция ОстаткиТоваров(ИмяРегистра, Ссылки, Склады)

	Результат = Новый Соответствие;
	ОбъектМД = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если ОбъектМД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Поле = ПервоеПоле(ОбъектМД.Ресурсы, "Количество|ВНаличии|КоличествоОстаток");
	Если ПустаяСтрока(Поле) Или ОбъектМД.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Пишу("Регистр «" + ИмяРегистра + "»: не нашёл ресурс количества или измерение «Номенклатура». Ресурсы: "
			+ ИменаПолей(ОбъектМД.Ресурсы) + ". Измерения: " + ИменаПолей(ОбъектМД.Измерения));
		Возврат Результат;
	КонецЕсли;
	Условие = "Номенклатура В (&Ссылки)";
	Если Склады.Количество() > 0 И ОбъектМД.Измерения.Найти("Склад") <> Неопределено Тогда
		Условие = "Склад В (&Склады) И " + Условие;
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ О.Номенклатура КАК Товар, СУММА(О." + Поле + "Остаток) КАК Кол");
	Строки.Добавить("ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки(, " + Условие + ") КАК О");
	Строки.Добавить("СГРУППИРОВАТЬ ПО О.Номенклатура");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.УстановитьПараметр("Склады", Склады);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Товар, ЧислоИлиНоль(Выборка.Кол));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Запрос цен выбранного типа: Соответствие «ссылка -> Структура(Цена, Коэф)»
Функция ВыполнитьЗапросЦен(ПолеЦены, ПолеТипа, ТипЦен, Ссылки, СЕдиницей)

	Результат = Новый Соответствие;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ Ц.Номенклатура КАК Товар, Ц." + ПолеЦены + " КАК Цена"
		+ ?(СЕдиницей, ", Ц.ЕдиницаИзмерения.Коэффициент КАК Коэф", ""));
	Строки.Добавить("ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, " + ПолеТипа + " = &ТипЦен И Номенклатура В (&Ссылки)) КАК Ц");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цена = ЧислоИлиНоль(Выборка.Цена);
		Если Цена <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Коэф = 1;
		Если СЕдиницей Тогда
			Коэф = ЧислоИлиНоль(Выборка.Коэф);
			Если Коэф <= 0 Тогда
				Коэф = 1;
			КонецЕсли;
		ИначеЕсли Нас("price_unit") = "pack" Тогда
			Коэф = 0;     // цена за упаковку: переведём, когда узнаем размер упаковки
		КонецЕсли;
		Результат.Вставить(Выборка.Товар, Новый Структура("Цена, Коэф", Цена, Коэф));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Цены: Соответствие «ссылка -> цена за штуку»
Функция ЦеныТоваров(Ссылки, Инфо)

	Результат = Новый Соответствие;
	МДЦен = Метаданные.РегистрыСведений.Найти("ЦеныНоменклатуры");
	Если МДЦен = Неопределено Тогда
		Пишу("ОШИБКА: нет регистра сведений «ЦеныНоменклатуры».");
		Возврат Результат;
	КонецЕсли;
	ПолеТипа = ПервоеПоле(МДЦен.Измерения, "ТипЦен|ТипЦены|ВидЦены|ВидЦен");
	ПолеЦены = ПервоеПоле(МДЦен.Ресурсы, "Цена");
	Если ПустаяСтрока(ПолеТипа) Или ПустаяСтрока(ПолеЦены) Или МДЦен.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Пишу("Регистр «ЦеныНоменклатуры»: не нашёл нужные поля. Измерения: " + ИменаПолей(МДЦен.Измерения)
			+ ". Ресурсы: " + ИменаПолей(МДЦен.Ресурсы));
		Возврат Результат;
	КонецЕсли;
	МДТипов = НайтиСправочник("ТипыЦенНоменклатуры|ВидыЦен|ТипыЦен");
	Если МДТипов = Неопределено Или ПустаяСтрока(Нас("price_type")) Тогда
		Пишу("Не выбран тип цен: пункт 2 (первая настройка).");
		Возврат Результат;
	КонецЕсли;
	ТипЦен = НайтиЭлемент(МДТипов.Имя, Нас("price_type"));
	Если Не ЗначениеЗаполнено(ТипЦен) Тогда
		Пишу("Тип цен «" + Нас("price_type") + "» не найден в справочнике «" + МДТипов.Имя + "».");
		Возврат Результат;
	КонецЕсли;
	ЕстьЕдиница = МДЦен.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено;
	Попытка
		Результат = ВыполнитьЗапросЦен(ПолеЦены, ПолеТипа, ТипЦен, Ссылки, ЕстьЕдиница);
	Исключение
		Если ЕстьЕдиница Тогда
			Пишу("Цены вместе с единицей измерения не прочитаны (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
				+ "); читаю без неё: цена считается за штуку (или за упаковку, если price_unit=pack).");
			ЕстьЕдиница = Ложь;
			Результат = ВыполнитьЗапросЦен(ПолеЦены, ПолеТипа, ТипЦен, Ссылки, Ложь);
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	Инфо.Вставить("ЦенаПоЕдинице", ЕстьЕдиница);
	Возврат Результат;

КонецФункции

// Единицы измерения: Соответствие «ссылка товара -> массив структур(Имя, Коэф)»
Функция ЕдиницыТоваров(Ссылки)

	Результат = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Е.Владелец КАК Товар, Е.Наименование КАК Имя, Е.Коэффициент КАК Коэф"
			+ Символы.ПС + "ИЗ Справочник.ЕдиницыИзмерения КАК Е"
			+ Символы.ПС + "ГДЕ Е.Владелец В (&Ссылки) И Е.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Список = Результат.Получить(Выборка.Товар);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				Результат.Вставить(Выборка.Товар, Список);
			КонецЕсли;
			Список.Добавить(Новый Структура("Имя, Коэф", Выборка.Имя, Выборка.Коэф));
		КонецЦикла;
	Исключение
		Пишу("Единицы измерения не прочитаны (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ "): размер упаковки возьму из настройки default_pack.");
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Все сведения о товарах по списку ссылок: Соответствие «ссылка -> Структура»
Функция СведенияОТоварах(Ссылки)

	Результат = Новый Соответствие;
	МДН = Метаданные.Справочники.Найти("Номенклатура");
	Если МДН = Неопределено Тогда
		Пишу("ОШИБКА: в базе нет справочника «Номенклатура».");
		Возврат Результат;
	КонецЕсли;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ЕстьАртикул = МДН.Реквизиты.Найти("Артикул") <> Неопределено;
	ЕстьЕдХран = МДН.Реквизиты.Найти("ЕдиницаХраненияОстатков") <> Неопределено;

	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ");
	Строки.Добавить("	Н.Ссылка КАК Ссылка,");
	Строки.Добавить("	Н.Код КАК Код,");
	Строки.Добавить("	Н.Наименование КАК Имя,");
	Строки.Добавить("	Н.Родитель.Наименование КАК Группа" + ?(ЕстьАртикул Или ЕстьЕдХран, ",", ""));
	Если ЕстьАртикул Тогда
		Строки.Добавить("	Н.Артикул КАК Артикул" + ?(ЕстьЕдХран, ",", ""));
	КонецЕсли;
	Если ЕстьЕдХран Тогда
		Строки.Добавить("	Н.ЕдиницаХраненияОстатков.Наименование КАК ЕдХранИмя,");
		Строки.Добавить("	Н.ЕдиницаХраненияОстатков.Коэффициент КАК ЕдХранКоэф");
	КонецЕсли;
	Строки.Добавить("ИЗ Справочник.Номенклатура КАК Н");
	Строки.Добавить("ГДЕ Н.Ссылка В (&Ссылки)");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Карточки = Запрос.Выполнить().Выгрузить();

	Склады = СкладыИзНастроек();
	Остатки = ОстаткиТоваров("ТоварыНаСкладах", Ссылки, Склады);
	Резервы = Новый Соответствие;
	Если Нас("use_reserves") = "1" Тогда
		Резервы = ОстаткиТоваров("ТоварыВРезервеНаСкладах", Ссылки, Склады);
	КонецЕсли;
	Инфо = Новый Структура;
	Цены = ЦеныТоваров(Ссылки, Инфо);
	Единицы = ЕдиницыТоваров(Ссылки);
	ПоУмолчанию = 25;
	Попытка
		ПоУмолчанию = Число(Нас("default_pack"));
	Исключение
	КонецПопытки;

	Для Каждого Карта Из Карточки Цикл
		Св = Новый Структура;
		Св.Вставить("Ссылка", Карта.Ссылка);
		Св.Вставить("GUID", Строка(Карта.Ссылка.УникальныйИдентификатор()));
		Св.Вставить("Код", Карта.Код);
		Св.Вставить("Имя", СокрЛП(Карта.Имя));
		Св.Вставить("Группа", ?(Карта.Группа = Null, "", Карта.Группа));
		Артикул = "";
		Если ЕстьАртикул Тогда
			Артикул = СокрЛП(Строка(Карта.Артикул));
		КонецЕсли;
		Св.Вставить("Артикул", Артикул);
		ЕдХранИмя = "";
		КоэфХран = 1;
		Если ЕстьЕдХран Тогда
			ЕдХранИмя = СокрЛП(Строка(Карта.ЕдХранИмя));
			Если ЧислоИлиНоль(Карта.ЕдХранКоэф) > 0 Тогда
				КоэфХран = Карта.ЕдХранКоэф;
			КонецЕсли;
		КонецЕсли;
		Св.Вставить("ЕдХранИмя", ЕдХранИмя);
		Св.Вставить("КоэфХран", КоэфХран);

		// размер упаковки: из единиц измерения («пачка» = 25 шт), иначе из настройки
		Упаковка = 0;
		ИзЕдиниц = Ложь;
		СписокЕд = Единицы.Получить(Карта.Ссылка);
		Если СписокЕд <> Неопределено Тогда
			Для Каждого Ед Из СписокЕд Цикл
				Если ЧислоИлиНоль(Ед.Коэф) > 1 И СодержитСлово(Ед.Имя, "", Нас("pack_words")) Тогда
					Упаковка = Окр(Ед.Коэф);
					ИзЕдиниц = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Упаковка = 0 И КоэфХран > 1 И СодержитСлово(ЕдХранИмя, "", Нас("pack_words")) Тогда
			Упаковка = Окр(КоэфХран);
			ИзЕдиниц = Истина;
		КонецЕсли;
		Если Упаковка = 0 Тогда
			Упаковка = ?(ПоУмолчанию >= 1, Окр(ПоУмолчанию), 1);
		КонецЕсли;
		Св.Вставить("Упаковка", Упаковка);
		Св.Вставить("УпаковкаИзЕдиниц", ИзЕдиниц);

		// цена за штуку
		ЦенаШт = 0;
		Ц = Цены.Получить(Карта.Ссылка);
		Если Ц <> Неопределено Тогда
			Если Ц.Коэф > 0 Тогда
				ЦенаШт = Ц.Цена / Ц.Коэф;
			Иначе
				ЦенаШт = Ц.Цена / Упаковка;
			КонецЕсли;
		КонецЕсли;
		Св.Вставить("ЦенаШт", Окр(ЦенаШт, 2));

		// остаток в штуках = (остаток - резерв) * штук в единице хранения
		Ост = Остатки.Получить(Карта.Ссылка);
		Рез = Резервы.Получить(Карта.Ссылка);
		Остаток = ?(Ост = Неопределено, 0, Ост) - ?(Рез = Неопределено, 0, Рез);
		Св.Вставить("ОстатокЕд", ?(Ост = Неопределено, 0, Ост));
		Св.Вставить("РезервЕд", ?(Рез = Неопределено, 0, Рез));
		Св.Вставить("Стеблей", Макс(0, Окр(Остаток * КоэфХран)));
		Результат.Вставить(Карта.Ссылка, Св);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------------
// Каталог: подготовка, предпросмотр, отправка
// ----------------------------------------------------------------------------

// Строки каталога для сайта (массив структур) или Неопределено, если не получилось
Функция ПодготовитьКаталог()

	МДН = Метаданные.Справочники.Найти("Номенклатура");
	Если МДН = Неопределено Тогда
		Пишу("ОШИБКА: в базе нет справочника «Номенклатура».");
		Возврат Неопределено;
	КонецЕсли;
	Группы = Новый Массив;
	Для Каждого Название Из РазделитьСтроку(Нас("group"), ";") Цикл
		Ссылка = НайтиЭлемент("Номенклатура", СокрЛП(Название));
		Если Ссылка = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
			Пишу("Группа номенклатуры «" + СокрЛП(Название) + "» не найдена: пункт 2 (первая настройка).");
			Возврат Неопределено;
		КонецЕсли;
		Группы.Добавить(Ссылка);
	КонецЦикла;
	Если Группы.Количество() = 0 Тогда
		Пишу("Не выбрана группа товаров: пункт 2 (первая настройка).");
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Н.Ссылка КАК Ссылка ИЗ Справочник.Номенклатура КАК Н"
		+ Символы.ПС + "ГДЕ Н.ЭтоГруппа = ЛОЖЬ И Н.ПометкаУдаления = ЛОЖЬ И Н.Ссылка В ИЕРАРХИИ (&Группы)";
	Запрос.УстановитьПараметр("Группы", Группы);
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Пишу("Товаров в группе «" + Нас("group") + "»: " + Формат(Ссылки.Количество(), "ЧГ=0"));
	Сведения = СведенияОТоварах(Ссылки);

	Строки = Новый Массив;
	БезЦены = 0;
	БезОстатка = 0;
	Для Каждого Ссылка Из Ссылки Цикл
		Св = Сведения.Получить(Ссылка);
		Если Св = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Св.ЦенаШт <= 0 Тогда
			БезЦены = БезЦены + 1;
		ИначеЕсли Св.Стеблей <= 0 Тогда
			БезОстатка = БезОстатка + 1;
		Иначе
			Строки.Добавить(Св);
		КонецЕсли;
	КонецЦикла;
	Пишу("Без цены (не отправляются): " + Формат(БезЦены, "ЧГ=0") + "; без остатка (не отправляются, на сайте исчезнут): "
		+ Формат(БезОстатка, "ЧГ=0") + "; к отправке: " + Формат(Строки.Количество(), "ЧГ=0"));
	Возврат Строки;

КонецФункции

Процедура ПоказатьПримеры(Строки, Сколько = 25)

	Пишу("");
	Пишу("Первые " + Формат(Мин(Сколько, Строки.Количество()), "ЧГ=0") + " строк (так увидит сайт):");
	Пишу("название | упаковка | цена за штуку | остаток, шт | как посчитано");
	Номер = 0;
	Для Каждого Св Из Строки Цикл
		Номер = Номер + 1;
		Если Номер > Сколько Тогда
			Прервать;
		КонецЕсли;
		Откуда = "";
		Если Св.УпаковкаИзЕдиниц Тогда
			Откуда = "упаковка из единиц измерения";
		Иначе
			Откуда = "упаковка по умолчанию " + Формат(Св.Упаковка, "ЧГ=0") + " (единица «пачка» не найдена)";
		КонецЕсли;
		Пишу(Св.Имя + " | " + Формат(Св.Упаковка, "ЧГ=0") + " шт | " + Формат(Св.ЦенаШт, "ЧДЦ=2; ЧРД=,; ЧГ=0") + " ₽ | "
			+ Формат(Св.Стеблей, "ЧГ=0") + " | остаток 1С " + Формат(Св.ОстатокЕд, "ЧДЦ=2; ЧРД=,; ЧГ=0") + " " + Св.ЕдХранИмя
			+ " (резерв " + Формат(Св.РезервЕд, "ЧДЦ=2; ЧРД=,; ЧГ=0") + ", в штуке единицы хранения " + Формат(Св.КоэфХран, "ЧДЦ=2; ЧРД=,; ЧГ=0") + "); " + Откуда);
	КонецЦикла;

КонецПроцедуры

Функция СтрокаТовараJSON(Св)

	Части = Новый Массив;
	Части.Добавить("""id"":" + JSONСтрока(Св.GUID));
	Если Не ПустаяСтрока(Св.Артикул) Тогда
		Части.Добавить("""sku"":" + JSONСтрока(Св.Артикул));
	КонецЕсли;
	Части.Добавить("""name"":" + JSONСтрока(Св.Имя));
	Части.Добавить("""price_per_stem"":" + ЧислоJSON(Св.ЦенаШт, 2));
	Части.Добавить("""stock_stems"":" + ЧислоJSON(Св.Стеблей, 0));
	Если Св.УпаковкаИзЕдиниц Тогда
		Части.Добавить("""package_size"":" + ЧислоJSON(Св.Упаковка, 0));
	Иначе
		Части.Добавить("""package_size_hint"":" + ЧислоJSON(Св.Упаковка, 0));
	КонецЕсли;
	Возврат "{" + СоединитьСтроки(Части, ",") + "}";

КонецФункции

Функция ТелоКаталога(Строки)

	Документ = Новый ТекстовыйДокумент;
	Документ.ДобавитьСтроку("{""full"":true,""products"":[");
	Номер = 0;
	Для Каждого Св Из Строки Цикл
		Номер = Номер + 1;
		Документ.ДобавитьСтроку(СтрокаТовараJSON(Св) + ?(Номер < Строки.Количество(), ",", ""));
	КонецЦикла;
	Документ.ДобавитьСтроку("]}");
	Возврат Документ.ПолучитьТекст();

КонецФункции

Процедура ДействиеКаталогПоказать()

	Строки = ПодготовитьКаталог();
	Если Строки <> Неопределено Тогда
		ПоказатьПримеры(Строки);
		Пишу("");
		Пишу("Ничего не отправлено. Если цены, остатки и упаковки похожи на правду, сделайте пункт 4 (проверка на сайте).");
	КонецЕсли;

КонецПроцедуры

// ПроверкаБезСохранения: Истина - сайт только посчитает и ничего не сохранит
Процедура ОтправитьКаталог(ПроверкаБезСохранения)

	Если ПустаяСтрока(Нас("key")) Тогда
		Пишу("Не задан ключ доступа: пункт 2 (первая настройка).");
		Возврат;
	КонецЕсли;
	Строки = ПодготовитьКаталог();
	Если Строки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Строки.Количество() = 0 Тогда
		Пишу("К отправке 0 товаров: проверьте группу, склад и тип цен (пункт 2). На сайт ничего не ушло.");
		Возврат;
	КонецЕсли;
	Прошлое = 0;
	Попытка
		Прошлое = Число(Нас("last_count"));
	Исключение
	КонецПопытки;
	Если Не ПроверкаБезСохранения И Прошлое >= 20 И Строки.Количество() < Прошлое / 2 Тогда
		Пишу("СТОП: к отправке " + Формат(Строки.Количество(), "ЧГ=0") + " товаров, а в прошлый раз было " + Формат(Прошлое, "ЧГ=0")
			+ ". Так резко товаров убывать не должно: возможно, выбран не тот склад или тип цен. На сайт ничего не ушло."
			+ " Если так и должно быть, сначала сделайте пункт 4 (проверка), затем снова пункт 5.");
		Возврат;
	КонецЕсли;
	Если Не ПроверкаБезСохранения Тогда
		Если Не Подтвердить("Отправить на сайт " + Формат(Строки.Количество() + 0, "ЧГ=0") + " товаров ПО-НАСТОЯЩЕМУ?"
			+ Символы.ПС + "Всё, чего нет в этом списке, исчезнет с витрины сайта (остаток 0)."
			+ Символы.ПС + "Сначала лучше сделать пункт 4 (проверка на сайте).") Тогда
			Пишу("Отправка отменена.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Ответ = ВызватьСайт("POST", "/api/1c/products/sync" + ?(ПроверкаБезСохранения, "?dry_run=1", ""), ТелоКаталога(Строки));
	Пишу(?(ПроверкаБезСохранения, "ПРОВЕРКА на сайте (ничего не сохранено)", "ОТПРАВКА каталога на сайт") + ": " + Формат(Строки.Количество(), "ЧГ=0") + " товаров.");
	Названия = Новый Соответствие;
	Названия.Вставить("created", "создано новых");
	Названия.Вставить("updated", "обновлено");
	Названия.Вставить("deactivated", "снято с витрины");
	Названия.Вставить("errors_total", "ошибок в строках");
	ИтогОтвета(Ответ, Названия);
	Если ПроверкаБезСохранения Тогда
		Пишу("");
		Пишу("Как читать: если «создано новых» почти равно числу товаров, а «обновлено» почти ноль, то названия/артикулы не совпали");
		Пишу("с товарами на сайте и настоящая загрузка заведёт дубли: НЕ отправляйте, пришлите этот отчёт мне.");
	ИначеЕсли Ответ.Код = 200 Тогда
		Настройки.Вставить("last_count", Формат(Строки.Количество(), "ЧГ=0"));
		СохранитьНастройки();
	КонецЕсли;

КонецПроцедуры

// ----------------------------------------------------------------------------
// Инвойсы «в пути»
// ----------------------------------------------------------------------------

Функция СтранаПоТексту(Текст)

	Образец = НРег(Текст);
	Если Найти(Образец, "эквадор") > 0 Тогда
		Возврат "Эквадор";
	ИначеЕсли Найти(Образец, "колумб") > 0 Тогда
		Возврат "Колумбия";
	ИначеЕсли Найти(Образец, "кени") > 0 Тогда
		Возврат "Кения";
	ИначеЕсли Найти(Образец, "голланд") > 0 Или Найти(Образец, "нидерланд") > 0 Тогда
		Возврат "Голландия";
	ИначеЕсли Найти(Образец, "эфиоп") > 0 Тогда
		Возврат "Эфиопия";
	ИначеЕсли Найти(Образец, "росси") > 0 Тогда
		Возврат "Россия";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ТабличнаяЧастьТоваров(ОбъектМД)

	Лучшая = Неопределено;
	Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
		Если ТЧ.Реквизиты.Найти("Номенклатура") <> Неопределено И ТЧ.Реквизиты.Найти("Количество") <> Неопределено Тогда
			Если Лучшая = Неопределено Или ТЧ.Имя = "Товары" Тогда
				Лучшая = ТЧ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Лучшая;

КонецФункции

// Массив структур-инвойсов (Ид, Номер, Дата, Статус, Страна, Поставщик, Вид, Строки)
Функция ПодготовитьИнвойсы()

	Результат = Новый Массив;
	Дней = 21;
	Попытка
		Дней = Число(Нас("invoice_days"));
	Исключение
	КонецПопытки;
	От = НачалоДня(ТекущаяДата()) - Дней * 86400;
	Найдено = 0;

	Для Каждого ОбъектМД Из Метаданные.Документы Цикл
		Если Не СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Нас("invoice_words")) Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		ТЧ = ТабличнаяЧастьТоваров(ОбъектМД);
		Если ТЧ = Неопределено Тогда
			Пишу("Документ «" + ОбъектМД.Синоним + "»: не нашёл табличную часть с товарами (нужны поля Номенклатура и Количество). Пропущен.");
			Продолжить;
		КонецЕсли;
		ЕстьПоставщик = ОбъектМД.Реквизиты.Найти("Контрагент") <> Неопределено;
		Строки = Новый Массив;
		Строки.Добавить("ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.Номер КАК Номер, Д.Дата КАК ДатаДок, Д.Проведен КАК Проведен, Д.ПометкаУдаления КАК Удален"
			+ ?(ЕстьПоставщик, ", Д.Контрагент.Наименование КАК Поставщик", ""));
		Строки.Добавить("ИЗ Документ." + ОбъектМД.Имя + " КАК Д");
		Строки.Добавить("ГДЕ Д.Дата >= &От");
		Строки.Добавить("УПОРЯДОЧИТЬ ПО Д.Дата");
		Запрос = Новый Запрос;
		Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
		Запрос.УстановитьПараметр("От", От);
		ТаблДокументов = Запрос.Выполнить().Выгрузить();

		// строки товаров: один запрос на все документы этого вида
		ЕстьКоэф = ТЧ.Реквизиты.Найти("Коэффициент") <> Неопределено;
		Запрос2 = Новый Запрос;
		Запрос2.Текст = "ВЫБРАТЬ Т.Ссылка КАК Док, Т.Номенклатура КАК Товар, Т.Количество КАК Кол"
			+ ?(ЕстьКоэф, ", Т.Коэффициент КАК Коэф", "")
			+ Символы.ПС + "ИЗ Документ." + ОбъектМД.Имя + "." + ТЧ.Имя + " КАК Т"
			+ Символы.ПС + "ГДЕ Т.Ссылка В (&Документы)";
		Запрос2.УстановитьПараметр("Документы", ТаблДокументов.ВыгрузитьКолонку("Ссылка"));
		СтрокиДок = Запрос2.Выполнить().Выгрузить();
		ПоДокументам = Новый Соответствие;
		Товары = Новый Массив;
		Для Каждого Ст Из СтрокиДок Цикл
			Список = ПоДокументам.Получить(Ст.Док);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				ПоДокументам.Вставить(Ст.Док, Список);
			КонецЕсли;
			Коэф = 1;
			Если ЕстьКоэф Тогда
				Если ЧислоИлиНоль(Ст.Коэф) > 0 Тогда
					Коэф = Ст.Коэф;
				КонецЕсли;
			КонецЕсли;
			Список.Добавить(Новый Структура("Товар, Количество", Ст.Товар, Ст.Кол * Коэф));
			Товары.Добавить(Ст.Товар);
		КонецЦикла;
		Сведения = СведенияОТоварах(Товары);

		Страна = СтранаПоТексту(ОбъектМД.Синоним + " " + ОбъектМД.Имя);
		Для Каждого Док Из ТаблДокументов Цикл
			Инв = Новый Структура;
			Инв.Вставить("Ид", ОбъектМД.Имя + "-" + СокрЛП(Док.Номер));
			Инв.Вставить("Номер", СокрЛП(Док.Номер));
			Инв.Вставить("Дата", Док.ДатаДок);
			Инв.Вставить("Вид", ОбъектМД.Синоним);
			Инв.Вставить("Страна", Страна);
			Поставщик = "";
			Если ЕстьПоставщик Тогда
				Поставщик = СокрЛП(Строка(Док.Поставщик));
			КонецЕсли;
			Инв.Вставить("Поставщик", Поставщик);
			Инв.Вставить("Проведен", Док.Проведен);
			Если Док.Удален Тогда
				Статус = "cancelled";
			ИначеЕсли Нас("transit_rule") = "future" Тогда
				Статус = ?(Док.ДатаДок > ТекущаяДата(), "in_transit", "received");
			Иначе
				Статус = ?(Док.Проведен, "received", "in_transit");
			КонецЕсли;
			Инв.Вставить("Статус", Статус);

			// строки: складываем одинаковые товары; в штуках
			Свод = Новый Соответствие;
			Порядок = Новый Массив;
			Список = ПоДокументам.Получить(Док.Ссылка);
			Если Список <> Неопределено Тогда
				Для Каждого Эл Из Список Цикл
					Св = Сведения.Получить(Эл.Товар);
					Если Св = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Накоплено = Свод.Получить(Эл.Товар);
					Если Накоплено = Неопределено Тогда
						Свод.Вставить(Эл.Товар, Эл.Количество * Св.КоэфХран);
						Порядок.Добавить(Эл.Товар);
					Иначе
						Свод.Вставить(Эл.Товар, Накоплено + Эл.Количество * Св.КоэфХран);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			СтрокиИнв = Новый Массив;
			Для Каждого Товар Из Порядок Цикл
				Св = Сведения.Получить(Товар);
				СтрокиИнв.Добавить(Новый Структура("Св, Штук", Св, Окр(Свод.Получить(Товар))));
			КонецЦикла;
			Инв.Вставить("Строки", СтрокиИнв);
			Результат.Добавить(Инв);
		КонецЦикла;
	КонецЦикла;
	Если Найдено = 0 Тогда
		Пишу("Документов с названием, содержащим «" + Нас("invoice_words") + "», не найдено (настройка invoice_words).");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ДействиеИнвойсыПоказать()

	Инвойсы = ПодготовитьИнвойсы();
	Пишу("Инвойсов за " + Нас("invoice_days") + " дн. (и будущие): " + Формат(Инвойсы.Количество(), "ЧГ=0")
		+ ". «В пути» = " + ?(Нас("transit_rule") = "future", "дата документа в будущем", "документ не проведён") + ".");
	Пишу("номер | дата | вид | поставщик | страна | проведён | будет отправлено как | строк | штук | без цены");
	Для Каждого Инв Из Инвойсы Цикл
		Штук = 0;
		БезЦены = 0;
		Для Каждого Ст Из Инв.Строки Цикл
			Штук = Штук + Ст.Штук;
			Если Ст.Св.ЦенаШт <= 0 Тогда
				БезЦены = БезЦены + 1;
			КонецЕсли;
		КонецЦикла;
		Пишу(Инв.Номер + " | " + Формат(Инв.Дата, "ДФ=dd.MM.yyyy") + " | " + Инв.Вид + " | " + Инв.Поставщик + " | "
			+ ?(ПустаяСтрока(Инв.Страна), "(страна не определена)", Инв.Страна) + " | " + ?(Инв.Проведен, "да", "нет") + " | " + Инв.Статус
			+ " | " + Формат(Инв.Строки.Количество(), "ЧГ=0") + " | " + Формат(Штук, "ЧГ=0") + " | " + Формат(БезЦены, "ЧГ=0"));
	КонецЦикла;
	Пишу("");
	Пишу("Ничего не отправлено. in_transit = в пути (клиенты увидят «Товары в пути»), received = уже оприходован, cancelled = отменён.");

КонецПроцедуры

Функция ТелоИнвойсов(Инвойсы)

	Документ = Новый ТекстовыйДокумент;
	Документ.ДобавитьСтроку("{""supplies"":[");
	Номер = 0;
	Для Каждого Инв Из Инвойсы Цикл
		Номер = Номер + 1;
		Части = Новый Массив;
		Части.Добавить("""id"":" + JSONСтрока(Инв.Ид));
		Части.Добавить("""number"":" + JSONСтрока(Инв.Номер));
		Части.Добавить("""status"":" + JSONСтрока(Инв.Статус));
		Если Инв.Статус = "in_transit" Тогда
			Части.Добавить("""date"":" + JSONСтрока(Формат(Инв.Дата, "ДФ=yyyy-MM-dd")));
			Если Не ПустаяСтрока(Инв.Страна) Тогда
				Части.Добавить("""country"":" + JSONСтрока(Инв.Страна));
			КонецЕсли;
			Если Не ПустаяСтрока(Инв.Поставщик) Тогда
				Части.Добавить("""supplier"":" + JSONСтрока(Инв.Поставщик));
			КонецЕсли;
			Линии = Новый Массив;
			Для Каждого Ст Из Инв.Строки Цикл
				Если Ст.Штук <= 0 Тогда
					Продолжить;
				КонецЕсли;
				Св = Ст.Св;
				Поля = Новый Массив;
				Поля.Добавить("""id"":" + JSONСтрока(Св.GUID));
				Если Не ПустаяСтрока(Св.Артикул) Тогда
					Поля.Добавить("""sku"":" + JSONСтрока(Св.Артикул));
				КонецЕсли;
				Поля.Добавить("""name"":" + JSONСтрока(Св.Имя));
				Поля.Добавить("""price_per_stem"":" + ЧислоJSON(Св.ЦенаШт, 2));
				Поля.Добавить("""quantity_stems"":" + ЧислоJSON(Ст.Штук, 0));
				Если Св.УпаковкаИзЕдиниц Тогда
					Поля.Добавить("""package_size"":" + ЧислоJSON(Св.Упаковка, 0));
				Иначе
					Поля.Добавить("""package_size_hint"":" + ЧислоJSON(Св.Упаковка, 0));
				КонецЕсли;
				Линии.Добавить("{" + СоединитьСтроки(Поля, ",") + "}");
			КонецЦикла;
			Части.Добавить("""items"":[" + СоединитьСтроки(Линии, ",") + "]");
		КонецЕсли;
		Документ.ДобавитьСтроку("{" + СоединитьСтроки(Части, ",") + "}" + ?(Номер < Инвойсы.Количество(), ",", ""));
	КонецЦикла;
	Документ.ДобавитьСтроку("]}");
	Возврат Документ.ПолучитьТекст();

КонецФункции

Процедура ОтправитьИнвойсы(ПроверкаБезСохранения)

	Если ПустаяСтрока(Нас("key")) Тогда
		Пишу("Не задан ключ доступа: пункт 2 (первая настройка).");
		Возврат;
	КонецЕсли;
	Инвойсы = ПодготовитьИнвойсы();
	Если Инвойсы.Количество() = 0 Тогда
		Пишу("Инвойсов для отправки нет. На сайт ничего не ушло.");
		Возврат;
	КонецЕсли;
	Если Не ПроверкаБезСохранения Тогда
		Если Не Подтвердить("Отправить на сайт " + Формат(Инвойсы.Количество(), "ЧГ=0") + " инвойсов ПО-НАСТОЯЩЕМУ?"
			+ Символы.ПС + "«В пути» увидят клиенты и смогут сделать предзаказ."
			+ Символы.ПС + "Сначала лучше сделать пункт 7 (проверка на сайте).") Тогда
			Пишу("Отправка отменена.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Ответ = ВызватьСайт("POST", "/api/1c/supplies/sync" + ?(ПроверкаБезСохранения, "?dry_run=1", ""), ТелоИнвойсов(Инвойсы));
	Пишу(?(ПроверкаБезСохранения, "ПРОВЕРКА на сайте (ничего не сохранено)", "ОТПРАВКА инвойсов на сайт") + ": " + Формат(Инвойсы.Количество(), "ЧГ=0") + " шт.");
	Названия = Новый Соответствие;
	Названия.Вставить("created", "новых «в пути»");
	Названия.Вставить("updated", "обновлено");
	Названия.Вставить("received", "принято (оприходовано)");
	Названия.Вставить("cancelled", "отменено");
	Названия.Вставить("skipped", "пропущено");
	Названия.Вставить("lines", "строк товаров");
	Названия.Вставить("products_created", "новых товаров");
	Названия.Вставить("preorders_fulfilled", "предзаказов выполнено");
	Названия.Вставить("errors_total", "ошибок");
	ИтогОтвета(Ответ, Названия);

КонецПроцедуры

// ----------------------------------------------------------------------------
// Заказы с сайта: показать и подтвердить
// ----------------------------------------------------------------------------

Функция ЗагрузитьЗаказы()

	Ответ = ВызватьСайт("GET", "/api/1c/orders/export?new=1&format=csv");
	Если Не ПустаяСтрока(Ответ.Ошибка) Или Ответ.Код <> 200 Тогда
		Пишу("Не удалось получить заказы: " + ОписатьОтвет(Ответ));
		Возврат Неопределено;
	КонецЕсли;
	Текст = Ответ.Текст;
	Если КодСимвола(Лев(Текст, 1)) = 65279 Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Возврат РазобратьCSV(Текст);

КонецФункции

Функция Колонка(Заголовок, Имя)

	Индекс = Заголовок.Найти(Имя);
	Возврат ?(Индекс = Неопределено, -1, Индекс);

КонецФункции

Функция ЗначениеПоля(Линия, Индекс)

	Если Индекс < 0 Или Индекс >= Линия.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Линия[Индекс];

КонецФункции

Процедура ДействиеЗаказыПоказать()

	Таблица = ЗагрузитьЗаказы();
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Таблица.Количество() < 2 Тогда
		Пишу("Новых заказов на сайте нет.");
		Возврат;
	КонецЕсли;
	Шапка = Таблица[0];
	кНомер = Колонка(Шапка, "order_number");
	кКогда = Колонка(Шапка, "created_at_local");
	кНужно = Колонка(Шапка, "desired_date");
	кСпособ = Колонка(Шапка, "delivery_method");
	кАдрес = Колонка(Шапка, "delivery_address");
	кФирма = Колонка(Шапка, "company");
	кИНН = Колонка(Шапка, "inn");
	кКонтакт = Колонка(Шапка, "contact");
	кТелефон = Колонка(Шапка, "phone");
	кКомм = Колонка(Шапка, "comment");
	кСкидка = Колонка(Шапка, "discount_percent");
	кИтого = Колонка(Шапка, "order_total");
	кАртикул = Колонка(Шапка, "sku");
	кИмя = Колонка(Шапка, "name");
	кУпак = Колонка(Шапка, "packs");
	кВУпак = Колонка(Шапка, "pieces_per_pack");
	кШтук = Колонка(Шапка, "pieces");
	кЦена = Колонка(Шапка, "price_per_piece");
	кСумма = Колонка(Шапка, "line_sum");

	Последний = "";
	Заказов = 0;
	Для Номер = 1 По Таблица.Количество() - 1 Цикл
		Ст = Таблица[Номер];
		НомерЗаказа = ЗначениеПоля(Ст, кНомер);
		Если НомерЗаказа <> Последний Тогда
			Последний = НомерЗаказа;
			Заказов = Заказов + 1;
			Пишу("");
			Пишу("=== ЗАКАЗ " + НомерЗаказа + " от " + ЗначениеПоля(Ст, кКогда) + "; нужен к " + ?(ПустаяСтрока(ЗначениеПоля(Ст, кНужно)), "(не указано)", ЗначениеПоля(Ст, кНужно)));
			Пишу("    Клиент: " + ЗначениеПоля(Ст, кФирма) + ", ИНН " + ЗначениеПоля(Ст, кИНН) + ", " + ЗначениеПоля(Ст, кКонтакт) + ", " + ЗначениеПоля(Ст, кТелефон));
			Пишу("    Получение: " + ?(ЗначениеПоля(Ст, кСпособ) = "delivery", "доставка, " + ЗначениеПоля(Ст, кАдрес), ?(ЗначениеПоля(Ст, кСпособ) = "pickup", "самовывоз", "(не указано)")));
			Если Не ПустаяСтрока(ЗначениеПоля(Ст, кКомм)) Тогда
				Пишу("    Комментарий клиента: " + ЗначениеПоля(Ст, кКомм));
			КонецЕсли;
			Пишу("    Скидка клиента: " + ЗначениеПоля(Ст, кСкидка) + "%;  итого по заказу: " + ЗначениеПоля(Ст, кИтого) + " ₽");
		КонецЕсли;
		Пишу("      - " + ЗначениеПоля(Ст, кИмя) + " (арт. " + ЗначениеПоля(Ст, кАртикул) + "): " + ЗначениеПоля(Ст, кУпак) + " уп. x " + ЗначениеПоля(Ст, кВУпак) + " = "
			+ ЗначениеПоля(Ст, кШтук) + " шт x " + ЗначениеПоля(Ст, кЦена) + " ₽ = " + ЗначениеПоля(Ст, кСумма) + " ₽");
	КонецЦикла;
	Пишу("");
	Пишу("Заказов: " + Формат(Заказов, "ЧГ=0") + ". Оформите их в 1С, потом нажмите пункт 10 (подтвердить), чтобы они больше не приходили.");

КонецПроцедуры

Процедура ДействиеЗаказыПодтвердить()

	Таблица = ЗагрузитьЗаказы();
	Если Таблица = Неопределено Или Таблица.Количество() < 2 Тогда
		Пишу("Новых заказов нет: подтверждать нечего.");
		Возврат;
	КонецЕсли;
	кИд = Колонка(Таблица[0], "order_id");
	Идентификаторы = Новый Массив;
	Для Номер = 1 По Таблица.Количество() - 1 Цикл
		Ид = ЗначениеПоля(Таблица[Номер], кИд);
		Если Не ПустаяСтрока(Ид) И Идентификаторы.Найти(Ид) = Неопределено Тогда
			Идентификаторы.Добавить(Ид);
		КонецЕсли;
	КонецЦикла;
	Если Не Подтвердить("Подтвердить сайту, что " + Формат(Идентификаторы.Количество(), "ЧГ=0") + " заказ(ов) перенесены в 1С?"
		+ Символы.ПС + "После этого они перестанут приходить как новые.") Тогда
		Пишу("Подтверждение отменено.");
		Возврат;
	КонецЕсли;
	Ответ = ВызватьСайт("POST", "/api/1c/orders/ack?numbers=" + СоединитьСтроки(Идентификаторы, ","), "{}");
	Пишу("Подтверждено заказов: " + СоединитьСтроки(Идентификаторы, ", "));
	Пишу("Ответ сайта: " + ОписатьОтвет(Ответ));

КонецПроцедуры

// ----------------------------------------------------------------------------
// Связь и описание базы
// ----------------------------------------------------------------------------

Процедура ДействиеСвязь()

	Пишу("Адрес: " + Нас("site"));
	Ответ = ВызватьСайт("GET", "/login", Неопределено, "");
	Пишу("1) Сайт доступен без ключа (/login): " + ОписатьОтвет(Ответ));
	Если ПустаяСтрока(Нас("key")) Тогда
		Пишу("2) Ключ не задан: пункт 2 (первая настройка).");
	Иначе
		Ответ = ВызватьСайт("GET", "/api/1c/ping");
		Пишу("2) Ключ " + КлючКратко() + " (/api/1c/ping): " + ОписатьОтвет(Ответ));
	КонецЕсли;

КонецПроцедуры

Функция ТипыСтрокой(ОписаниеТипа)

	Части = Новый Массив;
	Попытка
		Для Каждого ТипЗначения Из ОписаниеТипа.Типы() Цикл
			Если ТипЗначения = Тип("Строка") Тогда
				Части.Добавить("Строка");
			ИначеЕсли ТипЗначения = Тип("Число") Тогда
				Части.Добавить("Число");
			ИначеЕсли ТипЗначения = Тип("Дата") Тогда
				Части.Добавить("Дата");
			ИначеЕсли ТипЗначения = Тип("Булево") Тогда
				Части.Добавить("Булево");
			Иначе
				ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
				Если ОбъектМД <> Неопределено Тогда
					Части.Добавить(ОбъектМД.ПолноеИмя());
				Иначе
					Части.Добавить(Строка(ТипЗначения));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Части.Добавить("(тип не определён)");
	КонецПопытки;
	Возврат СоединитьСтроки(Части, " | ");

КонецФункции

Процедура ОписатьПоля(КоллекцияПолей, Отступ, Метка)

	Для Каждого Поле Из КоллекцияПолей Цикл
		Пишу(Отступ + Метка + " " + Поле.Имя + "   «" + Поле.Синоним + "»   " + ТипыСтрокой(Поле.Тип));
	КонецЦикла;

КонецПроцедуры

Процедура ОписатьОбъект(ОбъектМД, Вид)

	Пишу("");
	Пишу("=== " + ОбъектМД.ПолноеИмя() + "   «" + ОбъектМД.Синоним + "»");
	Попытка
		Если Вид = "Справочник" Или Вид = "Документ" Тогда
			ОписатьПоля(ОбъектМД.Реквизиты, "    ", "поле");
			Для Каждого ТабЧасть Из ОбъектМД.ТабличныеЧасти Цикл
				Пишу("    [табличная часть] " + ТабЧасть.Имя + "   «" + ТабЧасть.Синоним + "»");
				ОписатьПоля(ТабЧасть.Реквизиты, "        ", "-");
			КонецЦикла;
		Иначе
			ОписатьПоля(ОбъектМД.Измерения, "    ", "измерение");
			ОписатьПоля(ОбъектМД.Ресурсы, "    ", "ресурс");
			ОписатьПоля(ОбъектМД.Реквизиты, "    ", "реквизит");
		КонецЕсли;
	Исключение
		Пишу("    (описание прервано: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")");
	КонецПопытки;

КонецПроцедуры

Процедура ИскатьПоле(КоллекцияПолей, ПутьОбъекта, Слово, Счетчик)

	Для Каждого Поле Из КоллекцияПолей Цикл
		Если Счетчик.Значение >= 40 Тогда
			Возврат;
		КонецЕсли;
		Если СодержитСлово(Поле.Имя, Поле.Синоним, Слово) Тогда
			Счетчик.Значение = Счетчик.Значение + 1;
			Пишу("    " + ПутьОбъекта + "." + Поле.Имя + "   «" + Поле.Синоним + "»   " + ТипыСтрокой(Поле.Тип));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура НайтиПоле(Слово)

	Пишу("");
	Пишу("--- Где встречается «" + Слово + "» (в названиях объектов и полей) ---");
	Счетчик = Новый Структура("Значение", 0);
	Для Каждого ОбъектМД Из Метаданные.Справочники Цикл
		Попытка
			Если СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Слово) И Счетчик.Значение < 40 Тогда
				Счетчик.Значение = Счетчик.Значение + 1;
				Пишу("    [объект] " + ОбъектМД.ПолноеИмя() + "   «" + ОбъектМД.Синоним + "»");
			КонецЕсли;
			ИскатьПоле(ОбъектМД.Реквизиты, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
		Исключение
		КонецПопытки;
	КонецЦикла;
	Для Каждого ОбъектМД Из Метаданные.Документы Цикл
		Попытка
			Если СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Слово) И Счетчик.Значение < 40 Тогда
				Счетчик.Значение = Счетчик.Значение + 1;
				Пишу("    [объект] " + ОбъектМД.ПолноеИмя() + "   «" + ОбъектМД.Синоним + "»");
			КонецЕсли;
			ИскатьПоле(ОбъектМД.Реквизиты, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
			Для Каждого ТабЧасть Из ОбъектМД.ТабличныеЧасти Цикл
				ИскатьПоле(ТабЧасть.Реквизиты, ОбъектМД.ПолноеИмя() + "." + ТабЧасть.Имя, Слово, Счетчик);
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Для Каждого ОбъектМД Из Метаданные.РегистрыСведений Цикл
		Попытка
			Если СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Слово) И Счетчик.Значение < 40 Тогда
				Счетчик.Значение = Счетчик.Значение + 1;
				Пишу("    [объект] " + ОбъектМД.ПолноеИмя() + "   «" + ОбъектМД.Синоним + "»");
			КонецЕсли;
			ИскатьПоле(ОбъектМД.Измерения, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
			ИскатьПоле(ОбъектМД.Ресурсы, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
			ИскатьПоле(ОбъектМД.Реквизиты, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
		Исключение
		КонецПопытки;
	КонецЦикла;
	Если Счетчик.Значение = 0 Тогда
		Пишу("    (не найдено)");
	КонецЕсли;

КонецПроцедуры

Процедура ОбразцыНазваний(ИмяСправочника, Сколько)

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Сколько, "ЧГ=0") + " Т.Наименование КАК Название ИЗ Справочник." + ИмяСправочника + " КАК Т";
		Выборка = Запрос.Выполнить().Выбрать();
		Список = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Список.Добавить(СокрЛП(Строка(Выборка.Название)));
		КонецЦикла;
		Пишу("    Образцы названий: " + СоединитьСтроки(Список, "; "));
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ДействиеОписатьБазу()

	Пишу("ОПИСАНИЕ БАЗЫ ДЛЯ НАСТРОЙКИ ОБМЕНА (только названия, без данных клиентов и сумм)");
	Пишу("Платформа: " + СистемнаяИнформация.ВерсияПриложения);
	Пишу("Конфигурация: " + Метаданные.Имя + "   «" + Метаданные.Синоним + "»   версия " + Метаданные.Версия);
	Попытка
		Пишу("Режим совместимости: " + Строка(Метаданные.РежимСовместимости));
	Исключение
	КонецПопытки;
	Попытка
		Пишу("Компьютер: " + ИмяКомпьютера());
	Исключение
	КонецПопытки;

	Пишу("");
	Пишу("######## ЧТО ИЩЕТ ОБМЕН (найдено ли в вашей базе) ########");
	Для Каждого Имя Из РазделитьСтроку("Номенклатура,Контрагенты,ДоговорыКонтрагентов,ЕдиницыИзмерения,ТипыЦенНоменклатуры,Склады", ",") Цикл
		ОбъектМД = Метаданные.Справочники.Найти(Имя);
		Пишу("  Справочник." + Имя + ": " + ?(ОбъектМД = Неопределено, "НЕТ", "есть"));
		Если ОбъектМД <> Неопределено Тогда
			ОписатьОбъект(ОбъектМД, "Справочник");
			Если Имя = "Склады" Или Имя = "ТипыЦенНоменклатуры" Или Имя = "ЕдиницыИзмерения" Тогда
				ОбразцыНазваний(Имя, 15);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из РазделитьСтроку("ЦеныНоменклатуры", ",") Цикл
		ОбъектМД = Метаданные.РегистрыСведений.Найти(Имя);
		Пишу("  РегистрСведений." + Имя + ": " + ?(ОбъектМД = Неопределено, "НЕТ", "есть"));
		Если ОбъектМД <> Неопределено Тогда
			ОписатьОбъект(ОбъектМД, "РегистрСведений");
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из РазделитьСтроку("ТоварыНаСкладах,ТоварыВРезервеНаСкладах", ",") Цикл
		ОбъектМД = Метаданные.РегистрыНакопления.Найти(Имя);
		Пишу("  РегистрНакопления." + Имя + ": " + ?(ОбъектМД = Неопределено, "НЕТ", "есть"));
		Если ОбъектМД <> Неопределено Тогда
			ОписатьОбъект(ОбъектМД, "РегистрНакопления");
		КонецЕсли;
	КонецЦикла;

	Пишу("");
	Пишу("######## ДОКУМЕНТЫ-ИНВОЙСЫ И ПРОДАЖИ ########");
	Для Каждого ОбъектМД Из Метаданные.Документы Цикл
		Если СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Нас("invoice_words") + ",Реализац,Заказ,Счет,Счёт") Тогда
			ОписатьОбъект(ОбъектМД, "Документ");
		КонецЕсли;
	КонецЦикла;

	Пишу("");
	Пишу("######## ГДЕ ВСТРЕЧАЮТСЯ НУЖНЫЕ СЛОВА (скидки клиентов и т.п.) ########");
	Для Каждого Слово Из РазделитьСтроку("Скидк,Бонус,Дисконт,ИНН,Артикул,Страна,Длина", ",") Цикл
		НайтиПоле(Слово);
	КонецЦикла;

	Пишу("");
	Пишу("######## ЧТО ЕЩЁ ЕСТЬ В КОНФИГУРАЦИИ (по именам) ########");
	Пишу("Обработки: " + ИменаПолей(Метаданные.Обработки));
	Пишу("Отчёты: " + ИменаПолей(Метаданные.Отчеты));
	Попытка
		Пишу("Планы обмена: " + ИменаПолей(Метаданные.ПланыОбмена));
	Исключение
	КонецПопытки;
	Попытка
		Пишу("HTTP-сервисы: " + ИменаПолей(Метаданные.HTTPСервисы));
	Исключение
		Пишу("HTTP-сервисы: в этом режиме совместимости недоступны");
	КонецПопытки;
	Пишу("");
	Пишу("КОНЕЦ ОПИСАНИЯ. В базе ничего не менялось.");

КонецПроцедуры

