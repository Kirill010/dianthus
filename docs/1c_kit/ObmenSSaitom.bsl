// ============================================================================
// ОБМЕН 1С С САЙТОМ «ДИАНТУС»  (версия 3, 10.11.2026; страна и пачка берутся из карточки товара и строк инвойса)
// Для «1С:Управление торговлей», ред. 10.2. Работает в «толстом» клиенте.
//
// Как запустить: «1С:Предприятие» -> Файл -> Открыть -> этот файл (.epf).
// Откроется меню. Порядок: пункт 2 (настройка), 1 (проверка связи), потом 6, 7 и 8.
// Пункт 10 подтверждает заказы по одному; пункт 13 вручную меняет их статус на сайте.
// Пункт 14 («Сверка») печатает все строки инвойсов: поставщик, страна, пачка и откуда они взяты.
//
// СТРАНА товара берётся из карточки («Страна происхождения»), иначе по группе товара, названию («РФ») или
// организации. Вид документа («Инвойс срезка эквадор») страну НЕ определяет: так оформляют и российских поставщиков.
// ПАЧКА (штук в пачке): из строки инвойса («Колво»), иначе из единицы измерения, из других инвойсов этого товара,
// иначе «обычно у такой группы и вида»; такие догадки печатаются в списке «ПРОВЕРЬТЕ РАЗМЕР ПАЧКИ».
// АВТООБМЕН: запуск с параметром /C "авто" (задача Планировщика Windows), включается в пункте 12;
// история запусков - файл auto_log.txt рядом с settings.ini.
//
// ВАЖНО
//  * Пункты «показать» и «проверка» ничего не меняют ни в 1С, ни на сайте.
//  * Данные уходят на сайт только по пунктам «ОТПРАВИТЬ» и только после вашего «Да».
//  * В базе 1С эта обработка НИЧЕГО не создаёт, не изменяет и не удаляет:
//    она только читает справочники, цены, остатки и документы-инвойсы.
//  * Написана без новых возможностей языка (JSON, СтрСоединить и т.п.), чтобы
//    работать при любом режиме совместимости базы.
//  * Сайт работает ПО ПОСТАВКАМ (инвойсам): пункты 6-8. Пункты 3-5 («каталог без
//    поставки») нужны, только если часть товара лежит без инвойса; присылать один и тот же
//    остаток обоими способами нельзя - товар на сайте будет виден дважды.
//  * Везде одни названия полей: price - цена за ШТУКУ, quantity - количество в ШТУКАХ.
// ============================================================================

#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда

Перем Настройки;      // Соответствие «имя -> значение» (всё строки)
Перем Журнал;         // Массив строк текущего действия
Перем ЭтоАвто;        // Истина - запуск без диалогов (по расписанию Windows)
Перем СтатИнвойсов;   // Счётчики последней подготовки инвойсов
Перем ПачкиИстория;   // Соответствие «товар -> последний размер пачки, указанный в строках инвойсов»

// ----------------------------------------------------------------------------
// Строки, числа, JSON (без новых возможностей платформы)
// ----------------------------------------------------------------------------

Процедура Пишу(ТекстСтроки = "")

	Журнал.Добавить(ТекстСтроки);

КонецПроцедуры

// Версия сборки: меняйте при каждой правке исходного текста. Номера в имени файла больше нет
// (файл называется просто ОбменССайтом.epf), поэтому по заголовку меню видно, какая сборка открыта.
Функция ВерсияОбработки()

	Возврат "2026-11-10, страна по дереву групп + автозаказы";

КонецФункции

Функция СоединитьСтроки(Элементы, Разделитель = ", ")

	Результат = "";
	Первый = Истина;
	Для Каждого Элемент Из Элементы Цикл
		Если Не Первый Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Строка(Элемент);
		Первый = Ложь;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазделитьСтроку(Знач Текст, Разделитель = ",")

	Результат = Новый Массив;
	Пока Истина Цикл
		Позиция = Найти(Текст, Разделитель);
		Если Позиция = 0 Тогда
			Результат.Добавить(Текст);
			Прервать;
		КонецЕсли;
		Результат.Добавить(Лев(Текст, Позиция - 1));
		Текст = Сред(Текст, Позиция + СтрДлина(Разделитель));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Подходит ли имя/синоним под одно из слов списка (буквы любого регистра)
Функция СодержитСлово(Имя, Синоним, СписокСлов)

	Образец = НРег(Имя + " " + Синоним);
	Для Каждого Слово Из РазделитьСтроку(СписокСлов, ",") Цикл
		Искомое = НРег(СокрЛП(Слово));
		Если Не ПустаяСтрока(Искомое) И Найти(Образец, Искомое) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Число из поля запроса: пусто (Null) -> 0, чтобы не сравнивать «ничто» с числом
Функция ЧислоИлиНоль(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Число из значения любого типа: число отдаём как есть, из текста берём первое число
// («60 см» -> 60, «62,5» -> 62.5); 0, если чисел нет
Функция ПерваяЧисло(Знач Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = Строка(Значение);
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли (Символ = "," Или Символ = ".") И Цифры <> "" И Найти(Цифры, ".") = 0 Тогда
			Цифры = Цифры + ".";
		ИначеЕсли Цифры <> "" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Прав(Цифры, 1) = "." Тогда
		Цифры = Лев(Цифры, СтрДлина(Цифры) - 1);
	КонецЕсли;
	Если ПустаяСтрока(Цифры) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Цифры);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Текст значения любого типа (ссылка, строка, число); пусто для пустых ссылок и Неопределено
Функция ТекстЗначения(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Результат = СокрЛП(Строка(Значение));
	Если Результат = "<Не задан>" Или Результат = "Неопределено" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Имя реквизита: сначала по точному имени (варианты через «|»), потом по словам в синониме (через «,»).
// Пусто, если не нашлось.
Функция ПолеТЧ(КоллекцияПолей, Имена, Слова = "")

	Для Каждого Вариант Из РазделитьСтроку(Имена, "|") Цикл
		Если КоллекцияПолей.Найти(Вариант) <> Неопределено Тогда
			Возврат Вариант;
		КонецЕсли;
	КонецЦикла;
	Если Не ПустаяСтрока(Слова) Тогда
		Для Каждого Поле Из КоллекцияПолей Цикл
			Если СодержитСлово("", Поле.Синоним, Слова) Тогда
				Возврат Поле.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат "";

КонецФункции

// Цена строки инвойса за штуку: из строки документа, а если там пусто - из регистра цен
Функция ЦенаСтроки(Ст)

	Возврат ?(Ст.Цена > 0, Ст.Цена, Ст.Св.ЦенаШт);

КонецФункции

// Высота строки инвойса: из документа, а если там пусто - из карточки товара
Функция ВысотаСтроки(Ст)

	Возврат ?(Ст.Высота > 0, Ст.Высота, Ст.Св.Высота);

КонецФункции

// Сколько штук в пачке для НОВОГО товара, если в 1С размер пачки не указан: по виду товара,
// иначе настройка default_pack. Для товара, который уже есть на сайте, размер пачки сайт не меняет.
Функция ПачкаПоВиду(Вид, Имя = "")

	Образец = НРег(Вид);
	// кустовые розы и российские розы («РФ» в названии) обычно по 10 штук, а не по 25, как эквадорские
	Если Найти(Образец, "роза") > 0 И (Найти(НРег(Имя), "кустов") > 0 Или Найти(Имя, " РФ") > 0) Тогда
		Возврат 10;
	КонецЕсли;
	// аксессуары, горшечные и посадочные растения продаются поштучно
	Если Найти(Образец, "аксессуар") > 0 Или Найти(Образец, "горшеч") > 0 Или Найти(Образец, "грунт") > 0 Или Найти(Образец, "растени") > 0 Тогда
		Возврат 1;
	КонецЕсли;
	// штучные экзотические цветы и растения продаются по одному
	Если Найти(Образец, "антуриум") > 0 Или Найти(Образец, "протея") > 0 Или Найти(Образец, "гиппеаструм") > 0 Или Найти(Образец, "орхиде") > 0
		Или Найти(Образец, "калла") > 0 Или Найти(Образец, "стрелиц") > 0 Или Найти(НРег(Имя), "ванда") > 0 Или Найти(НРег(Имя), "банксия") > 0 Тогда
		Возврат 1;
	КонецЕсли;
	Если Найти(Образец, "гипсофил") > 0 Тогда
		Возврат 25;
	КонецЕсли;
	Если Найти(Образец, "гвоздик") > 0 Тогда
		Возврат 20;
	ИначеЕсли Найти(Образец, "тюльпан") > 0 Тогда
		Возврат 50;
	ИначеЕсли Найти(Образец, "пион") > 0 Или Найти(Образец, "хризантем") > 0 Или Найти(Образец, "альстромер") > 0 Тогда
		Возврат 10;
	ИначеЕсли Найти(Образец, "роза") > 0 Тогда
		Возврат 25;
	КонецЕсли;
	ПоУмолчанию = 10;
	Попытка
		ПоУмолчанию = Число(Нас("default_pack"));
	Исключение
	КонецПопытки;
	Возврат ?(ПоУмолчанию >= 1, Окр(ПоУмолчанию), 1);

КонецФункции

// Название страны для сайта: известные приводим к привычному виду («ЭКВАДОР» -> «Эквадор»,
// «НИДЕРЛАНДЫ» -> «Голландия»), остальные пишем с большой буквы
Функция НазваниеСтраны(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Результат = СтранаПоТексту(Текст);
	Если ПустаяСтрока(Результат) Тогда
		Результат = ВРег(Лев(Текст, 1)) + НРег(Сред(Текст, 2));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Страна по ГРУППЕ товара в справочнике номенклатуры («РОУЗХИЛЛ», «Ступино» - Россия, «ECUANROS» - Эквадор...).
// Слова и страны берутся из настройки group_countries (settings.ini), потому что группы называют по поставщикам.
Функция СтранаПоГруппе(Группа)

	Если ПустаяСтрока(Группа) Тогда
		Возврат "";
	КонецЕсли;
	Образец = НРег(Группа);
	Для Каждого Пара Из РазделитьСтроку(Нас("group_countries"), ";") Цикл
		Позиция = Найти(Пара, "=");
		Если Позиция > 1 Тогда
			Слово = НРег(СокрЛП(Лев(Пара, Позиция - 1)));
			Если Не ПустаяСтрока(Слово) И Найти(Образец, Слово) > 0 Тогда
				Возврат СокрЛП(Сред(Пара, Позиция + 1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат СтранаПоТексту(Группа);

КонецФункции

// Имена групп номенклатуры от родителя товара вверх до корня: Массив строк («Ultra Flo», «КЕНИЯ», «Срезанные цветы»).
// Кэш - Соответствие «ссылка на группу -> массив», чтобы каждую группу читать из базы один раз.
Функция ПутьГрупп(Группа, Кэш)

	Если Группа = Null Или Группа = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Готово = Кэш.Получить(Группа);
	Если Готово <> Неопределено Тогда
		Возврат Готово;
	КонецЕсли;
	Результат = Новый Массив;
	Текущая = Группа;
	Для Шаг = 1 По 12 Цикл
		Если Текущая.Пустая() Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(СокрЛП(Текущая.Наименование));
		Текущая = Текущая.Родитель;
	КонецЦикла;
	Кэш.Вставить(Группа, Результат);
	Возврат Результат;

КонецФункции

// Путь групп сверху вниз текстом: «Срезанные цветы / КЕНИЯ / Ultra Flo»
Функция ПутьТекстом(Путь)

	Части = Новый Массив;
	Если Путь <> Неопределено Тогда
		Для Номер = 1 По Путь.Количество() Цикл
			Части.Добавить(Путь[Путь.Количество() - Номер]);
		КонецЦикла;
	КонецЕсли;
	Возврат СоединитьСтроки(Части, " / ");

КонецФункции

// Страна по ДЕРЕВУ групп номенклатуры: ближайшая к товару группа, чьё название - страна («КЕНИЯ», «ГОЛЛАНДИЯ», «РОССИЯ РОЗА»,
// «Зелень Россия»). В вашей базе группы поставщиков («Ultra Flo», «PORINI», «ECUANROS») лежат ВНУТРИ группы страны, поэтому
// страну ищем не у ближайшей группы, а вверх по дереву. Результат: Структура(Страна, Группа).
Функция СтранаПоДереву(Путь)

	Результат = Новый Структура("Страна, Группа", "", "");
	Если Путь = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Имя Из Путь Цикл
		Страна = СтранаПоТексту(Имя);
		Если Не ПустаяСтрока(Страна) Тогда
			Результат.Страна = Страна;
			Результат.Группа = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Страна строки инвойса и откуда она взята. Порядок от надёжного к догадке:
//  1) «Страна строка» в инвойсе; 2) «Страна» в шапке инвойса; 3) ДЕРЕВО групп номенклатуры 1С («КЕНИЯ» -> «Ultra Flo» -> товар):
//  так владелец раскладывает товар по странам, и это главный источник; 4) «Страна происхождения» в карточке товара
//  (в карточках бывают ошибки: у кенийских роз стояла «Россия»); 5) группа товара по словам из настройки group_countries;
//  6) название товара («РФ», «(Р)», «Кения»...); 7) организация - только если включена настройка use_org_country.
// Вид документа («Инвойс срезка эквадор») страну НЕ определяет: так оформляют и российских поставщиков.
Функция ОпределитьСтрану(Инв, Ст)

	Результат = Новый Структура("Страна, Откуда", "", "");
	Св = Ст.Св;
	ПоДереву = СтранаПоДереву(Св.ПутьГрупп);
	Если Не ПустаяСтрока(Ст.СтранаСтр) Тогда
		Результат.Страна = Ст.СтранаСтр;
		Результат.Откуда = "строка инвойса";
	ИначеЕсли Не ПустаяСтрока(Инв.СтранаШапки) Тогда
		Результат.Страна = НазваниеСтраны(Инв.СтранаШапки);
		Результат.Откуда = "шапка инвойса";
	ИначеЕсли Не ПустаяСтрока(ПоДереву.Страна) Тогда
		Результат.Страна = ПоДереву.Страна;
		Результат.Откуда = "дерево групп 1С «" + ПоДереву.Группа + "»";
	ИначеЕсли Не ПустаяСтрока(Св.СтранаТовара) Тогда
		Результат.Страна = Св.СтранаТовара;
		Результат.Откуда = "карточка товара";
	Иначе
		ПоГруппе = СтранаПоГруппе(Св.Группа);
		Если Не ПустаяСтрока(ПоГруппе) Тогда
			Результат.Страна = ПоГруппе;
			Результат.Откуда = "группа товара «" + Св.Группа + "»";
		ИначеЕсли Найти(Св.Имя, " РФ") > 0 Или Найти(Св.Имя, "(Р)") > 0 Тогда
			Результат.Страна = "Россия";
			Результат.Откуда = "название товара";
		ИначеЕсли Не ПустаяСтрока(СтранаПоТексту(Св.Имя)) Тогда
			Результат.Страна = СтранаПоТексту(Св.Имя);
			Результат.Откуда = "название товара";
		ИначеЕсли Нас("use_org_country") = "1" И Не ПустаяСтрока(Нас("russian_org")) И Инв.Организация = Нас("russian_org") Тогда
			Результат.Страна = "Россия";
			Результат.Откуда = "организация " + Инв.Организация;
		КонецЕсли;
