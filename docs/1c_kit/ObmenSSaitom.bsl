КонецПроцедуры

Процедура ЗагрузитьНастройки()

	Настройки = Новый Соответствие;
	ЗаполнитьУмолчания();
	Путь = КаталогНастроек() + "settings.ini";
	Попытка
		Если ФайлЕсть(Путь) Тогда
			Документ = Новый ТекстовыйДокумент;
			Документ.Прочитать(Путь, КодировкаТекста.UTF8);
			Для Номер = 1 По Документ.КоличествоСтрок() Цикл
				Линия = Документ.ПолучитьСтроку(Номер);
				Позиция = Найти(Линия, "=");
				Если Позиция > 1 И Лев(СокрЛП(Линия), 1) <> ";" Тогда
					Настройки.Вставить(СокрЛП(Лев(Линия, Позиция - 1)), СокрЛП(Сред(Линия, Позиция + 1)));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура СохранитьНастройки()

	Попытка
		Папка = КаталогНастроек();
		Если Не ФайлЕсть(Папка) Тогда
			СоздатьКаталог(Папка);
		КонецЕсли;
		Документ = Новый ТекстовыйДокумент;
		Документ.ДобавитьСтроку("; Настройки обмена 1С с сайтом Диантус. Можно править в Блокноте.");
		Для Каждого Пара Из Настройки Цикл
			Документ.ДобавитьСтроку(Пара.Ключ + "=" + Пара.Значение);
		КонецЦикла;
		Документ.Записать(Папка + "settings.ini", КодировкаТекста.UTF8);
	Исключение
		Пишу("Не удалось сохранить настройки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция Нас(Имя)

	Значение = Настройки.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

// «dnt_abcd…» - чтобы ключ не светился в окнах
Функция КлючКратко()

	Ключ = Нас("key");
	Если ПустаяСтрока(Ключ) Тогда
		Возврат "(не задан)";
	КонецЕсли;
	Возврат Лев(Ключ, 8) + "…";

КонецФункции

// ----------------------------------------------------------------------------
// Диалоги
// ----------------------------------------------------------------------------

Функция Подтвердить(Текст)

	Если ЭтоАвто Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Возврат Вопрос(Текст, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "Обмен с сайтом Диантус") = КодВозвратаДиалога.Да;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Строка от пользователя; Неопределено, если нажали «Отмена»
Функция СпроситьСтроку(Подсказка, Значение, Длина = 120)

	Результат = Значение;
	Если ВвестиСтроку(Результат, Подсказка, Длина) Тогда
		Возврат СокрЛП(Результат);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Показывает длинный текст в окне, которое можно прокручивать и копировать
Процедура ПоказатьЖурнал(Заголовок)

	Текст = СоединитьСтроки(Журнал, Символы.ПС);
	Попытка
		Папка = КаталогНастроек();
		Если Не ФайлЕсть(Папка) Тогда
			СоздатьКаталог(Папка);
		КонецЕсли;
		Файл = Новый ТекстовыйДокумент;
		Файл.УстановитьТекст(Текст);
		Файл.Записать(Папка + "last_report.txt", КодировкаТекста.UTF8);
	Исключение
	КонецПопытки;
	Если ЭтоАвто Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Копия = Текст;
		ВвестиСтроку(Копия, Заголовок + "  (Ctrl+A, Ctrl+C - скопировать; OK - закрыть)", 0, Истина);
	Исключение
		Сообщить(Текст);
	КонецПопытки;

КонецПроцедуры

