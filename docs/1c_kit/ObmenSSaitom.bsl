Процедура Пишу(ТекстСтроки = "")

	Журнал.Добавить(ТекстСтроки);

КонецПроцедуры

Функция СоединитьСтроки(Элементы, Разделитель = ", ")

	Результат = "";
	Первый = Истина;
	Для Каждого Элемент Из Элементы Цикл
		Если Не Первый Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Строка(Элемент);
		Первый = Ложь;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазделитьСтроку(Знач Текст, Разделитель = ",")

	Результат = Новый Массив;
	Пока Истина Цикл
		Позиция = Найти(Текст, Разделитель);
		Если Позиция = 0 Тогда
			Результат.Добавить(Текст);
			Прервать;
		КонецЕсли;
		Результат.Добавить(Лев(Текст, Позиция - 1));
		Текст = Сред(Текст, Позиция + СтрДлина(Разделитель));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Подходит ли имя/синоним под одно из слов списка (буквы любого регистра)
Функция СодержитСлово(Имя, Синоним, СписокСлов)

	Образец = НРег(Имя + " " + Синоним);
	Для Каждого Слово Из РазделитьСтроку(СписокСлов, ",") Цикл
		Искомое = НРег(СокрЛП(Слово));
		Если Не ПустаяСтрока(Искомое) И Найти(Образец, Искомое) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Число из поля запроса: пусто (Null) -> 0, чтобы не сравнивать «ничто» с числом
Функция ЧислоИлиНоль(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Число из значения любого типа: число отдаём как есть, из текста берём первое число
// («60 см» -> 60, «62,5» -> 62.5); 0, если чисел нет
Функция ПерваяЧисло(Знач Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = Строка(Значение);
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли (Символ = "," Или Символ = ".") И Цифры <> "" И Найти(Цифры, ".") = 0 Тогда
			Цифры = Цифры + ".";
		ИначеЕсли Цифры <> "" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Прав(Цифры, 1) = "." Тогда
		Цифры = Лев(Цифры, СтрДлина(Цифры) - 1);
	КонецЕсли;
	Если ПустаяСтрока(Цифры) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Цифры);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Текст значения любого типа (ссылка, строка, число); пусто для пустых ссылок и Неопределено
Функция ТекстЗначения(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Результат = СокрЛП(Строка(Значение));
	Если Результат = "<Не задан>" Или Результат = "Неопределено" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Имя реквизита: сначала по точному имени (варианты через «|»), потом по словам в синониме (через «,»).
// Пусто, если не нашлось.
Функция ПолеТЧ(КоллекцияПолей, Имена, Слова = "")

	Для Каждого Вариант Из РазделитьСтроку(Имена, "|") Цикл
		Если КоллекцияПолей.Найти(Вариант) <> Неопределено Тогда
			Возврат Вариант;
		КонецЕсли;
	КонецЦикла;
	Если Не ПустаяСтрока(Слова) Тогда
		Для Каждого Поле Из КоллекцияПолей Цикл
			Если СодержитСлово("", Поле.Синоним, Слова) Тогда
				Возврат Поле.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат "";

КонецФункции

// Цена строки инвойса за штуку: из строки документа, а если там пусто - из регистра цен
Функция ЦенаСтроки(Ст)

	Возврат ?(Ст.Цена > 0, Ст.Цена, Ст.Св.ЦенаШт);

КонецФункции

// Высота строки инвойса: из документа, а если там пусто - из карточки товара
Функция ВысотаСтроки(Ст)

	Возврат ?(Ст.Высота > 0, Ст.Высота, Ст.Св.Высота);

КонецФункции

// Сколько штук в пачке для НОВОГО товара, если в 1С размер пачки не указан: по виду товара,
// иначе настройка default_pack. Для товара, который уже есть на сайте, размер пачки сайт не меняет.
Функция ПачкаПоВиду(Вид, Имя = "")

	Образец = НРег(Вид);
	// кустовые розы и российские розы («РФ» в названии) обычно по 10 штук, а не по 25, как эквадорские
	Если Найти(Образец, "роза") > 0 И (Найти(НРег(Имя), "кустов") > 0 Или Найти(Имя, " РФ") > 0) Тогда
		Возврат 10;
	КонецЕсли;
	Если Найти(Образец, "гвоздик") > 0 Тогда
		Возврат 20;
	ИначеЕсли Найти(Образец, "тюльпан") > 0 Тогда
		Возврат 50;
	ИначеЕсли Найти(Образец, "пион") > 0 Или Найти(Образец, "хризантем") > 0 Или Найти(Образец, "альстромер") > 0 Тогда
		Возврат 10;
	ИначеЕсли Найти(Образец, "роза") > 0 Тогда
		Возврат 25;
	КонецЕсли;
	ПоУмолчанию = 10;
	Попытка
		ПоУмолчанию = Число(Нас("default_pack"));
	Исключение
	КонецПопытки;
	Возврат ?(ПоУмолчанию >= 1, Окр(ПоУмолчанию), 1);

КонецФункции

// Название страны для сайта: известные приводим к привычному виду («ЭКВАДОР» -> «Эквадор»,
// «НИДЕРЛАНДЫ» -> «Голландия»), остальные пишем с большой буквы
Функция НазваниеСтраны(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Результат = СтранаПоТексту(Текст);
	Если ПустаяСтрока(Результат) Тогда
		Результат = ВРег(Лев(Текст, 1)) + НРег(Сред(Текст, 2));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Страна строки инвойса для сайта: если страна инвойса известна (шапка, вид документа), то она;
// иначе страна из строки документа; иначе страна происхождения из карточки товара
Функция СтранаСтроки(Инв, Ст)

	Если Не ПустаяСтрока(Инв.СтранаДок) Тогда
		Возврат Инв.СтранаДок;
	КонецЕсли;
	Если Не ПустаяСтрока(Ст.СтранаСтр) Тогда
		Возврат Ст.СтранаСтр;
	КонецЕсли;
	Возврат Ст.Св.СтранаТовара;

КонецФункции

Функция ЧислоВHex(Знач Значение, Цифр = 4)

	Алфавит = "0123456789abcdef";
	Результат = "";
	Для Счетчик = 1 По Цифр Цикл
		Результат = Сред(Алфавит, (Значение % 16) + 1, 1) + Результат;
		Значение = Цел(Значение / 16);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строка JSON в «чистом ASCII»: всё, кроме латиницы и цифр, - через \uXXXX,
// поэтому кодировка при передаче не имеет значения.
Функция JSONСтрока(Значение)

	Текст = Строка(Значение);
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Код = КодСимвола(Символ);
		Если Символ = """" Тогда
			Результат = Результат + "\""";
		ИначеЕсли Символ = "\" Тогда
			Результат = Результат + "\\";
		ИначеЕсли Код < 32 Или Код > 126 Тогда
			Результат = Результат + "\u" + ЧислоВHex(Код);
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат """" + Результат + """";

КонецФункции

Функция ЧислоJSON(Значение, Знаков = 2)

	Если Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;
	Возврат Формат(Значение, "ЧДЦ=" + Формат(Знаков, "ЧГ=0") + "; ЧРД=.; ЧГ=0");

КонецФункции

// Целое число после «"поле":» в тексте ответа сайта; Неопределено, если поля нет
Функция ЧислоИзОтвета(Текст, ИмяПоля)

	Позиция = Найти(Текст, """" + ИмяПоля + """");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Остаток = Сред(Текст, Позиция + СтрДлина(ИмяПоля) + 2);
	Пока Лев(Остаток, 1) = ":" Или Лев(Остаток, 1) = " " Цикл
		Остаток = Сред(Остаток, 2);
	КонецЦикла;
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Цифры) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

// Разбор CSV: разделитель «;», кавычки, переводы строк внутри кавычек
Функция РазобратьCSV(Текст)

	Строки = Новый Массив;
	Поля = Новый Массив;
	Поле = "";
	ВКавычках = Ложь;
	Длина = СтрДлина(Текст);
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(Текст, Индекс + 1, 1) = """" Тогда
					Поле = Поле + """";
					Индекс = Индекс + 1;
				Иначе
					ВКавычках = Ложь;
				КонецЕсли;
			Иначе
				Поле = Поле + Символ;
			КонецЕсли;
		Иначе
			Если Символ = """" Тогда
				ВКавычках = Истина;
			ИначеЕсли Символ = ";" Тогда
				Поля.Добавить(Поле);
				Поле = "";
			ИначеЕсли Символ = Символы.ПС Тогда
				Поля.Добавить(Поле);
				Поле = "";
				Строки.Добавить(Поля);
				Поля = Новый Массив;
			ИначеЕсли Символ <> Символы.ВК Тогда
				Поле = Поле + Символ;
			КонецЕсли;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Поле <> "" Или Поля.Количество() > 0 Тогда
		Поля.Добавить(Поле);
		Строки.Добавить(Поля);
	КонецЕсли;
	Возврат Строки;

КонецФункции

// ----------------------------------------------------------------------------
// Настройки (простой текстовый файл «имя=значение» в «Документах» пользователя)
// ----------------------------------------------------------------------------

// Есть ли файл или каталог. Метод у «Новый Файл(...)» вызывать нельзя: в режиме совместимости 8.2
// платформа отвечает «Ожидается ключевое слово Тогда», поэтому сначала объект кладём в переменную
Функция ФайлЕсть(Путь)

	ОбъектФайл = Новый Файл(Путь);
	Возврат ОбъектФайл.Существует();

КонецФункции

Функция КаталогНастроек()

	Путь = КаталогДокументов();
	Если Прав(Путь, 1) <> "\" Тогда
		Путь = Путь + "\";
	КонецЕсли;
	Возврат Путь + "Dianthus1C\";

КонецФункции

