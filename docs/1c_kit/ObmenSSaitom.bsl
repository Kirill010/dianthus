// https://host[:port] -> Структура(Хост, Порт, Ошибка)
Функция РазобратьАдрес(Адрес)

	Результат = Новый Структура("Хост, Порт, Ошибка", "", 443, "");
	Хост = СокрЛП(Адрес);
	Если НРег(Лев(Хост, 8)) = "https://" Тогда
		Хост = Сред(Хост, 9);
	ИначеЕсли НРег(Лев(Хост, 7)) = "http://" Тогда
		Результат.Ошибка = "нужен адрес, начинающийся с https://";
		Возврат Результат;
	КонецЕсли;
	Пока Прав(Хост, 1) = "/" Цикл
		Хост = Лев(Хост, СтрДлина(Хост) - 1);
	КонецЦикла;
	Позиция = Найти(Хост, ":");
	Если Позиция > 0 Тогда
		Попытка
			Результат.Порт = Число(Сред(Хост, Позиция + 1));
		Исключение
			Результат.Ошибка = "неверный порт в адресе";
		КонецПопытки;
		Хост = Лев(Хост, Позиция - 1);
	КонецЕсли;
	Результат.Хост = Хост;
	Возврат Результат;

КонецФункции

// Метод: "GET" или "POST". Путь: "/api/1c/ping". Тело - текст JSON или Неопределено.
// Возвращает Структура(Код, Текст, Ошибка). Сначала средства 1С, при сбое - компонент Windows.
Функция ВызватьСайт(Метод, Путь, Тело = Неопределено, Ключ = Неопределено)

	Результат = Новый Структура("Код, Текст, Ошибка", 0, "", "");
	Адрес = РазобратьАдрес(Нас("site"));
	Если Не ПустаяСтрока(Адрес.Ошибка) Или ПустаяСтрока(Адрес.Хост) Тогда
		Результат.Ошибка = ?(ПустаяСтрока(Адрес.Ошибка), "не указан адрес сайта", Адрес.Ошибка);
		Возврат Результат;
	КонецЕсли;
	КлючДоступа = ?(Ключ = Неопределено, Нас("key"), Ключ);

	Попытка
		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , 120, Новый ЗащищенноеСоединениеOpenSSL());
		Запрос = Новый HTTPЗапрос(Путь);
		Если Не ПустаяСтрока(КлючДоступа) Тогда
			Запрос.Заголовки.Вставить("X-API-Key", КлючДоступа);
		КонецЕсли;
		Если Тело <> Неопределено Тогда
			Запрос.Заголовки.Вставить("Content-Type", "application/json");
			Запрос.УстановитьТелоИзСтроки(Тело, "UTF-8");
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Иначе
			Ответ = Соединение.Получить(Запрос);
		КонецЕсли;
		Результат.Код = Ответ.КодСостояния;
		Результат.Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		Возврат Результат;
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		Объект = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
		ПолныйАдрес = "https://" + Адрес.Хост + ?(Адрес.Порт = 443, "", ":" + Формат(Адрес.Порт, "ЧГ=0")) + Путь;
		Объект.Open(Метод, ПолныйАдрес, Ложь);
		Объект.SetTimeouts(30000, 30000, 120000, 120000);
		Если Не ПустаяСтрока(КлючДоступа) Тогда
			Объект.SetRequestHeader("X-API-Key", КлючДоступа);
		КонецЕсли;
		Если Тело <> Неопределено Тогда
			Объект.SetRequestHeader("Content-Type", "application/json");
			Объект.Send(Тело);
		Иначе
			Объект.Send();
		КонецЕсли;
		Результат.Код = Объект.Status;
		Результат.Текст = Объект.ResponseText;
		Результат.Ошибка = "";
	Исключение
		Результат.Ошибка = Результат.Ошибка + " | COM: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ОписатьОтвет(Ответ)

	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Возврат "НЕ УДАЛОСЬ: " + Ответ.Ошибка;
	КонецЕсли;
	Текст = Ответ.Текст;
	Если КодСимвола(Лев(Текст, 1)) = 65279 Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Текст = Лев(СтрЗаменить(Текст, Символы.ПС, " "), 300);
	Подсказка = "";
	Если Ответ.Код = 401 Тогда
		Подсказка = "  <- ключ неверный или отключён: создайте новый в админке сайта («Интеграция с 1С»)";
	ИначеЕсли Ответ.Код = 403 Тогда
		Подсказка = "  <- ключ ограничен по IP-адресу, а этот компьютер в список не входит";
	ИначеЕсли Ответ.Код = 503 Тогда
		Подсказка = "  <- на сайте обмен выключен: нет ни одного ключа";
	КонецЕсли;
	Возврат "ответ сайта, код " + Формат(Ответ.Код, "ЧГ=0") + ": " + Текст + Подсказка;

КонецФункции

// Короткий итог ответа на загрузку: «создано 3, обновлено 115 ...»
Процедура ИтогОтвета(Ответ, Названия)

	Если Не ПустаяСтрока(Ответ.Ошибка) Или Ответ.Код <> 200 Тогда
		Пишу("Ответ сайта: " + ОписатьОтвет(Ответ));
		Возврат;
	КонецЕсли;
	Строки = Новый Массив;
	Для Каждого Пара Из Названия Цикл
		Значение = ЧислоИзОтвета(Ответ.Текст, Пара.Ключ);
		Если Значение <> Неопределено Тогда
			Строки.Добавить(Пара.Значение + ": " + Формат(Значение, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	Пишу("Ответ сайта: " + СоединитьСтроки(Строки, ", "));
	Ошибок = ЧислоИзОтвета(Ответ.Текст, "errors_total");
	Если Ошибок <> Неопределено И Ошибок > 0 Тогда
		Пишу("Строки с ошибками (первые):");
		Текст = Ответ.Текст;
		Позиция = Найти(Текст, """errors""");
		Если Позиция > 0 Тогда
			Пишу(Лев(Сред(Текст, Позиция), 1500));
		КонецЕсли;
	КонецЕсли;
	Позиция = Найти(Ответ.Текст, """warnings""");
	Если Позиция > 0 Тогда
		Пишу(Лев(Сред(Ответ.Текст, Позиция), 600));
	КонецЕсли;

КонецПроцедуры

