		Список.Добавить("13", "13. Заказ: отправить статус на сайт (вручную)");
		Список.Добавить("14", "14. Сверка: все строки инвойсов с поставщиком, страной, пачкой (только чтение)");
		Список.Добавить("15", "15. Сведения о базе (подключение) и образцы документов продаж (только чтение)");
		Список.Добавить("16", "16. Автозаказы: пробная сборка накладных по заказам сайта (НИЧЕГО не записывается)");
		Список.Добавить("17", "17. Автозаказы: СОЗДАТЬ накладные по заказам сайта (только в базах из orders_bases)");
		Список.Добавить("18", "18. Автозаказы: отправить на сайт статусы документов «САЙТ-N» (подтверждён, отправлен, отменён)");
		Список.Добавить("19", "19. Автозаказы: самопроверка на выдуманном заказе (НИЧЕГО не записывается)");
		Список.Добавить("20", "20. Фото из папки Документы\Dianthus1C\photos: проверка (на сайте ничего не сохраняется)");
		Список.Добавить("21", "21. Фото из папки Документы\Dianthus1C\photos: ОТПРАВИТЬ на сайт (имя файла = название товара)");
		Элемент = Список.ВыбратьЭлемент("Обмен 1С с сайтом Диантус, сборка " + ВерсияОбработки() + " (закрыть - Отмена)");
		Если Элемент = Неопределено Тогда
			Прервать;
		КонецЕсли;
		ВыполнитьПункт(Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

Процедура Запуск()

	Журнал = Новый Массив;
	ЭтоАвто = Ложь;
	ЗагрузитьНастройки();
	Режим = "";
	Попытка
		Режим = НРег(СокрЛП(ПараметрЗапуска));
	Исключение
	КонецПопытки;
	Если Режим = "авто" Или Режим = "auto" Тогда
		ВыполнитьАвтоматически();
	Иначе
		ПоказатьМеню();
	КонецЕсли;

КонецПроцедуры

