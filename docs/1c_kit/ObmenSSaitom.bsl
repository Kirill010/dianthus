// ----------------------------------------------------------------------------
// Сведения о базе и образцы документов продаж (только чтение)
// ----------------------------------------------------------------------------

// Один образец документа продаж: заполненные реквизиты шапки и первые две строки таблицы «Товары».
// Контрагенты, адреса и контакты не выводятся: нужны только названия видов операций, складов, типов цен и т.п.
Процедура ОписатьОбразецДокумента(Док, Номер)

	МД = Док.Метаданные();
	Пишу("");
	Пишу("--- образец " + Формат(Номер, "ЧГ=0") + ": " + МД.Имя + " " + Док.Номер + " от " + Формат(Док.Дата, "ДФ=dd.MM.yyyy") + "; проведён: " + ?(Док.Проведен, "да", "нет") + " ---");
	Для Каждого Рек Из МД.Реквизиты Цикл
		Если Найти(Рек.Имя, "Контрагент") > 0 Или Найти(Рек.Имя, "Грузо") > 0 Или Рек.Имя = "АдресДоставки" Или Найти(Рек.Имя, "Штрих") > 0 Или Найти(Рек.Имя, "Контакт") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Текст = ТекстЗначения(Док[Рек.Имя]);
		Если Не ПустаяСтрока(Текст) И Текст <> "0" И Текст <> "Нет" Тогда
			Пишу("    " + Рек.Имя + " = " + Лев(Текст, 90));
		КонецЕсли;
	КонецЦикла;
	Строки = Док.Товары;
	Пишу("    строк в таблице «Товары»: " + Формат(Строки.Количество(), "ЧГ=0"));
	Для Индекс = 0 По Мин(1, Строки.Количество() - 1) Цикл
		Части = Новый Массив;
		Для Каждого Рек Из МД.ТабличныеЧасти.Товары.Реквизиты Цикл
			Текст = ТекстЗначения(Строки[Индекс][Рек.Имя]);
			Если Не ПустаяСтрока(Текст) И Текст <> "0" И Текст <> "Нет" Тогда
				Части.Добавить(Рек.Имя + "=" + Лев(Текст, 40));
			КонецЕсли;
		КонецЦикла;
		Пишу("    строка " + Формат(Индекс + 1, "ЧГ=0") + ": " + СоединитьСтроки(Части, "; "));
	КонецЦикла;

КонецПроцедуры

