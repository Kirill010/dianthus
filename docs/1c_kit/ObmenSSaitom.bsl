// ----------------------------------------------------------------------------
// Автозаказы: заказ с сайта -> непроведённая «Расходная накладная» (документ «Реализация товаров и услуг»)
//
// Что делает: берёт новые заказы сайта, находит контрагента (по ИНН) и товары (по идентификатору 1С), собирает накладную по образцу
// последней проведённой накладной (шапка и строка копируются, чтобы не угадывать десятки служебных реквизитов вашей конфигурации),
// записывает её БЕЗ проведения, номер сайта «САЙТ-N» кладёт в «Номер заказа», подтверждает заказ на сайте и шлёт статусы
// (непроведена - «Подтверждён», проведена - «Отправлен», помечена на удаление - «Отменён»).
// Склад не списывается, пока накладную не проведёт сотрудник. Чтобы за это время товар не продали второй раз, количество из
// непроведённых накладных «САЙТ-N» вычитается из остатка, который уходит на сайт (функция ШтукиВЗаказахСайта).
//
// БЕЗОПАСНОСТЬ: документы создаются ТОЛЬКО в базах из настройки orders_bases (имя базы из строки соединения, через «;»).
// Рабочая база там не указана, пока владелец сам не добавит её после приёмки на копии-черновике.
// Пункт 16 («пробная сборка») ничего не записывает и безопасен в любой базе.
// ----------------------------------------------------------------------------

// Имя базы из строки соединения: Srvr="192.168.201.2";Ref="flowerkim"; -> flowerkim (для файловой базы - имя её папки)
Функция ИмяБазы()

	СтрокаСоед = СтрокаСоединенияИнформационнойБазы();
	Образец = НРег(СтрокаСоед);
	Для Каждого Метка Из РазделитьСтроку("ref=""|file=""", "|") Цикл
		Позиция = Найти(Образец, Метка);
		Если Позиция > 0 Тогда
			Остаток = Сред(СтрокаСоед, Позиция + СтрДлина(Метка));
			Конец = Найти(Остаток, """");
			Результат = ?(Конец = 0, Остаток, Лев(Остаток, Конец - 1));
			Пока Найти(Результат, "\") > 0 Цикл
				Результат = Сред(Результат, Найти(Результат, "\") + 1);
			КонецЦикла;
			Возврат СокрЛП(Результат);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Можно ли создавать документы в этой базе
Функция СозданиеДокументовРазрешено()

	Имя = НРег(ИмяБазы());
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Разрешенная Из РазделитьСтроку(Нас("orders_bases"), ";") Цикл
		Если НРег(СокрЛП(Разрешенная)) = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Сколько штук (в единицах хранения) по каждому товару лежит в НЕпроведённых накладных, созданных по заказам сайта.
// Эти накладные склад ещё не списали, но товар уже продан: вычитаем его из остатка, который уходит на сайт.
Функция ШтукиВЗаказахСайта()

	Результат = Новый Соответствие;
	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Т.Номенклатура КАК Номенклатура, СУММА(Т.Количество) КАК Количество"
			+ " ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Т"
			+ " ГДЕ Т.Ссылка.НомерЗаказа ПОДОБНО ""САЙТ-%"" И НЕ Т.Ссылка.Проведен И НЕ Т.Ссылка.ПометкаУдаления"
			+ " СГРУППИРОВАТЬ ПО Т.Номенклатура";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Номенклатура, Выборка.Количество);
		КонецЦикла;
	Исключение
		Пишу("Не удалось учесть заказы сайта в остатках: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Заказы сайта одним списком: Массив структур. Одна строка таблицы CSV = одна позиция заказа.
Функция РазобратьЗаказыСайта(Таблица)

	Результат = Новый Массив;
	Если Таблица = Неопределено Или Таблица.Количество() < 2 Тогда
		Возврат Результат;
	КонецЕсли;
	Шапка = Таблица[0];
	Колонки = Новый Структура;
	Для Каждого Имя Из РазделитьСтроку("order_number,order_id,date,desired_date,delivery_method,delivery_address,comment,discount_percent,order_total,counterparty_external_id,counterparty_name,counterparty_inn,counterparty_phone,supply_number,external_id,sku,name,package_size,price,quantity,sum", ",") Цикл
		Колонки.Вставить(Имя, Колонка(Шапка, Имя));
	КонецЦикла;
	Текущий = Неопределено;
	Для Номер = 1 По Таблица.Количество() - 1 Цикл
		Ст = Таблица[Номер];
		Ид = ЗначениеПоля(Ст, Колонки.order_id);
		Если ПустаяСтрока(Ид) Тогда
			Продолжить;
		КонецЕсли;
		Если Текущий = Неопределено Или Текущий.Ид <> Ид Тогда
			НомерСайта = ЗначениеПоля(Ст, Колонки.order_number);
			Текущий = Новый Структура;
			Текущий.Вставить("Ид", Ид);
			Текущий.Вставить("Номер", ?(ПустаяСтрока(НомерСайта), "САЙТ-" + Ид, НомерСайта));
			Текущий.Вставить("Когда", ЗначениеПоля(Ст, Колонки.date));
			Текущий.Вставить("НуженК", ЗначениеПоля(Ст, Колонки.desired_date));
			Текущий.Вставить("Способ", ЗначениеПоля(Ст, Колонки.delivery_method));
			Текущий.Вставить("Адрес", ЗначениеПоля(Ст, Колонки.delivery_address));
			Текущий.Вставить("Комментарий", ЗначениеПоля(Ст, Колонки.comment));
			Текущий.Вставить("Скидка", ПерваяЧисло(ЗначениеПоля(Ст, Колонки.discount_percent)));
			Текущий.Вставить("Итого", ПерваяЧисло(ЗначениеПоля(Ст, Колонки.order_total)));
			Текущий.Вставить("КлиентИд1С", ЗначениеПоля(Ст, Колонки.counterparty_external_id));
			Текущий.Вставить("Клиент", ЗначениеПоля(Ст, Колонки.counterparty_name));
			Текущий.Вставить("ИНН", ЗначениеПоля(Ст, Колонки.counterparty_inn));
			Текущий.Вставить("Телефон", ЗначениеПоля(Ст, Колонки.counterparty_phone));
			Текущий.Вставить("Строки", Новый Массив);
			Результат.Добавить(Текущий);
		КонецЕсли;
		Текущий.Строки.Добавить(Новый Структура("GUID, Артикул, Имя, ВПачке, Цена, Штук, Сумма, Поставка",
			ЗначениеПоля(Ст, Колонки.external_id), ЗначениеПоля(Ст, Колонки.sku), ЗначениеПоля(Ст, Колонки.name),
			ПерваяЧисло(ЗначениеПоля(Ст, Колонки.package_size)), ПерваяЧисло(ЗначениеПоля(Ст, Колонки.price)),
			ПерваяЧисло(ЗначениеПоля(Ст, Колонки.quantity)), ПерваяЧисло(ЗначениеПоля(Ст, Колонки.sum)),
			ЗначениеПоля(Ст, Колонки.supply_number)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Контрагент 1С для заказа: 1) по идентификатору 1С, который сайт уже знает, 2) по ИНН, 3) по точному названию.
// Нашли ровно одного - возвращаем ссылку; иначе Неопределено, а в Причина.Текст - что делать. Новых контрагентов НЕ создаём.
Функция НайтиКонтрагента(Заказ, Причина)

	Если Не ПустаяСтрока(Заказ.КлиентИд1С) Тогда
		Попытка
			Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Заказ.КлиентИд1С));
			Если Не ПустаяСтрока(Строка(Ссылка.Наименование)) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Запрос = Новый Запрос;
	Если Не ПустаяСтрока(Заказ.ИНН) Тогда
		Запрос.Текст = "ВЫБРАТЬ К.Ссылка КАК Ссылка ИЗ Справочник.Контрагенты КАК К ГДЕ К.ИНН = &ИНН И НЕ К.ПометкаУдаления И НЕ К.ЭтоГруппа";
		Запрос.УстановитьПараметр("ИНН", СокрЛП(Заказ.ИНН));
		Найденные = Запрос.Выполнить().Выгрузить();
		Если Найденные.Количество() = 1 Тогда
			Возврат Найденные[0].Ссылка;
		КонецЕсли;
		Если Найденные.Количество() > 1 Тогда
			Причина.Текст = "в 1С несколько контрагентов с ИНН " + Заказ.ИНН + ": оставьте одного или создайте накладную вручную";
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ К.Ссылка КАК Ссылка ИЗ Справочник.Контрагенты КАК К ГДЕ К.Наименование = &Имя И НЕ К.ПометкаУдаления И НЕ К.ЭтоГруппа";
	Запрос.УстановитьПараметр("Имя", СокрЛП(Заказ.Клиент));
	Найденные = Запрос.Выполнить().Выгрузить();
	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0].Ссылка;
	КонецЕсли;
	Причина.Текст = "контрагент не найден в 1С (ИНН " + Заказ.ИНН + ", «" + Заказ.Клиент + "»): заведите карточку контрагента с этим ИНН и повторите";
	Возврат Неопределено;

КонецФункции

// Товар 1С для строки заказа: по идентификатору 1С (его сайт получил от обмена), запасные пути - артикул и точное название
Функция НайтиТоварСтроки(Стр)

	Если Не ПустаяСтрока(Стр.GUID) Тогда
		Попытка
			Ссылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.GUID));
			Если Не ПустаяСтрока(Строка(Ссылка.Наименование)) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Запрос = Новый Запрос;
	Если Не ПустаяСтрока(Стр.Артикул) Тогда
		Запрос.Текст = "ВЫБРАТЬ Н.Ссылка КАК Ссылка ИЗ Справочник.Номенклатура КАК Н ГДЕ Н.Артикул = &Артикул И НЕ Н.ПометкаУдаления И НЕ Н.ЭтоГруппа";
		Запрос.УстановитьПараметр("Артикул", Стр.Артикул);
		Найденные = Запрос.Выполнить().Выгрузить();
		Если Найденные.Количество() = 1 Тогда
			Возврат Найденные[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ Н.Ссылка КАК Ссылка ИЗ Справочник.Номенклатура КАК Н ГДЕ Н.Наименование = &Имя И НЕ Н.ПометкаУдаления И НЕ Н.ЭтоГруппа";
	Запрос.УстановитьПараметр("Имя", Стр.Имя);
	Найденные = Запрос.Выполнить().Выгрузить();
	Возврат ?(Найденные.Количество() = 1, Найденные[0].Ссылка, Неопределено);

КонецФункции

// Образец для копирования служебных реквизитов: последняя проведённая «Расходная накладная» нашей организации, в которой есть строки
Функция ОбразецНакладной()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 8 Д.Ссылка КАК Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Д"
		+ " ГДЕ Д.НазвДокумента ПОДОБНО ""Реализация%"" И Д.Проведен И НЕ Д.ПометкаУдаления И Д.Организация.Наименование = &Организация"
		+ " УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ";
	Запрос.УстановитьПараметр("Организация", Нас("orders_org"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Образец = Выборка.Ссылка.ПолучитьОбъект();
		Если Образец.Товары.Количество() > 0 Тогда
			Возврат Образец;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Уже есть документ по этому заказу сайта (в том числе помеченный на удаление)? Повторно не создаём: ищем по «Номеру заказа»
Функция ДокументЗаказаСайта(НомерЗаказа)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Д ГДЕ Д.НомерЗаказа = &Номер";
	Запрос.УстановитьПараметр("Номер", НомерЗаказа);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Дата из текста сайта «2026-11-12T00:00:00»; пустая дата, если не разобрать
Функция ДатаИзТекстаСайта(Текст)

	Попытка
		Возврат Дата(Число(Лев(Текст, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция ТекстКомментарияНакладной(Заказ)

	Части = Новый Массив;
	Части.Добавить("Заказ с сайта " + Заказ.Номер);
	Если Не ПустаяСтрока(Заказ.НуженК) Тогда
		Части.Добавить("нужен к " + Сред(Заказ.НуженК, 9, 2) + "." + Сред(Заказ.НуженК, 6, 2) + "." + Лев(Заказ.НуженК, 4));
	КонецЕсли;
	Части.Добавить(?(Заказ.Способ = "delivery", "доставка", ?(Заказ.Способ = "pickup", "самовывоз", "способ получения не указан")));
	Если Не ПустаяСтрока(Заказ.Телефон) Тогда
		Части.Добавить("тел. " + Заказ.Телефон);
	КонецЕсли;
	Если Заказ.Скидка > 0 Тогда
		Части.Добавить("скидка клиента " + Формат(Заказ.Скидка, "ЧДЦ=2; ЧРД=,; ЧГ=0") + "%");
	КонецЕсли;
	Если Не ПустаяСтрока(Заказ.Комментарий) Тогда
		Части.Добавить("комментарий клиента: " + Заказ.Комментарий);
	КонецЕсли;
	Возврат Лев(СоединитьСтроки(Части, "; "), 250);

КонецФункции

// Собирает накладную по заказу. Записывает её (без проведения), если Записать = Истина; иначе только возвращает объект.
// Проблемы - Массив строк: что помешало. Результат: Структура(Объект, НехватаетТовара) или Неопределено.
Функция СобратьНакладную(Заказ, Образец, Проблемы, Записать)

	Причина = Новый Структура("Текст", "");
	Клиент = НайтиКонтрагента(Заказ, Причина);
	Если Клиент = Неопределено Тогда
		Проблемы.Добавить(Заказ.Номер + ": " + Причина.Текст);
		Возврат Неопределено;
	КонецЕсли;
	Товары = Новый Массив;
	Для Каждого Стр Из Заказ.Строки Цикл
		Товар = НайтиТоварСтроки(Стр);
		Если Товар = Неопределено Тогда
			Проблемы.Добавить(Заказ.Номер + ": товар не найден в 1С: «" + Стр.Имя + "» (id " + Стр.GUID + ", арт. " + Стр.Артикул + ")");
			Возврат Неопределено;
		КонецЕсли;
		Товары.Добавить(Товар);
	КонецЦикла;
	Если Товары.Количество() = 0 Тогда
		Проблемы.Добавить(Заказ.Номер + ": в заказе нет позиций");
		Возврат Неопределено;
	КонецЕсли;

	МДД = Образец.Метаданные();
	Накладная = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Накладная.Дата = ТекущаяДата();
	// служебные реквизиты шапки - с образца (склад, тип цен, организация, подразделение, НДС, вид накладной...)
	Для Каждого Имя Из РазделитьСтроку("ВидОперации,Организация,ОтражатьВУправленческомУчете,ОтражатьВБухгалтерскомУчете,ОтражатьВНалоговомУчете,Подразделение,Склад,ТипЦен,ВалютаДокумента,УчитыватьНДС,СуммаВключаетНДС,КурсВзаиморасчетов,КратностьВзаиморасчетов,ВидПередачи,ПодразделениеАзалии,ВидНакладной,НазвДокумента,ТипЦенГолландия,ТипЦенЭквадор,СтавкаНДСДокумента,ОтключитьСкидкуПоСуммеДокумента,АвтоНомерУстановка,ТорговоеНаправление,Ответственный", ",") Цикл
		Если МДД.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Накладная[Имя] = Образец[Имя];
		КонецЕсли;
	КонецЦикла;
	Накладная.Контрагент = Клиент;
	Если МДД.Реквизиты.Найти("ДоговорКонтрагента") <> Неопределено Тогда
		Накладная.ДоговорКонтрагента = Клиент.ОсновнойДоговорКонтрагента;
	КонецЕсли;
	Накладная.НомерЗаказа = Заказ.Номер;
	Накладная.Комментарий = ТекстКомментарияНакладной(Заказ);
	Если Заказ.Способ = "delivery" Тогда
		Накладная.НеобходимаДоставка = Истина;
		Накладная.АдресДоставки = Лев(Заказ.Адрес, 200);
	КонецЕсли;
	ДатаНужна = ДатаИзТекстаСайта(Заказ.НуженК);
	Если ДатаНужна > Дата(1, 1, 1) Тогда
		Накладная.ДатаДоставки = ДатаНужна;
	КонецЕсли;
	Попытка
		Пользователь1С = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя(), Истина);
		Если Не Пользователь1С.Пустая() Тогда
			Накладная.Ответственный = Пользователь1С;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Направление = Товары[0].ТорговоеНаправление;
	Если ЗначениеЗаполнено(Направление) Тогда
		Накладная.ТорговоеНаправление = Направление;
	КонецЕсли;

	// строки: все поля копируем с первой строки образца, потом перезаписываем то, что зависит от товара и цены
	СтрокаОбразца = Образец.Товары[0];
	РеквизитыСтрок = МДД.ТабличныеЧасти.Товары.Реквизиты;
	Склады = СкладыИзНастроек();
	Остатки = ОстаткиТоваров("ТоварыНаСкладах", Товары, Склады);
	Скидка = Заказ.Скидка;
	НехватаетТовара = Новый Массив;
	СуммаДок = 0;
	Индекс = 0;
	Для Каждого Стр Из Заказ.Строки Цикл
		Товар = Товары[Индекс];
		Индекс = Индекс + 1;
		Новая = Накладная.Товары.Добавить();
		Для Каждого Рек Из РеквизитыСтрок Цикл
			Новая[Рек.Имя] = СтрокаОбразца[Рек.Имя];
		КонецЦикла;
		Коэф = 1;
		Если ЧислоИлиНоль(Товар.ЕдиницаХраненияОстатков.Коэффициент) > 0 Тогда
			Коэф = Товар.ЕдиницаХраненияОстатков.Коэффициент;
		КонецЕсли;
		Количество = Стр.Штук / Коэф;
		ЦенаЗаЕд = Стр.Цена * Коэф;
		ЦенаСоСкидкой = Окр(ЦенаЗаЕд * (1 - Скидка / 100), 2);
		СуммаСтроки = Окр(ЦенаСоСкидкой * Количество, 2);
		СуммаДок = СуммаДок + СуммаСтроки;
		Новая.Номенклатура = Товар;
		Новая.ЕдиницаИзмерения = Товар.ЕдиницаХраненияОстатков;
		Новая.Коэффициент = Коэф;
		Новая.Количество = Количество;
		Новая.Цена = ЦенаСоСкидкой;
		Новая.Сумма = СуммаСтроки;
		Для Каждого Пара Из Новый Структура("ЦенаТекущая, ЦенаРасчетная, ЦенаОпт", ЦенаЗаЕд, ЦенаСоСкидкой, ЦенаЗаЕд) Цикл
			Если РеквизитыСтрок.Найти(Пара.Ключ) <> Неопределено Тогда
				Новая[Пара.Ключ] = Пара.Значение;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Пара Из Новый Структура("СуммаТекущая, СуммаРасчетная", Окр(ЦенаЗаЕд * Количество, 2), СуммаСтроки) Цикл
			Если РеквизитыСтрок.Найти(Пара.Ключ) <> Неопределено Тогда
				Новая[Пара.Ключ] = Пара.Значение;
			КонецЕсли;
		КонецЦикла;
		// то, что нельзя унаследовать от образца: розничная и закупочная цены (посчитает 1С при проведении), автоскидки, основание строки
		Для Каждого Имя Из РазделитьСтроку("ЦенаРозница,СуммаРозница,ЦенаЗакупочная,СуммаЗакупочная,СуммаНДС,ПроцентАвтоматическихСкидок,ПроцентНакопительнойСкидки,НакопительнаяСкидкаСумма", ",") Цикл
			Если РеквизитыСтрок.Найти(Имя) <> Неопределено Тогда
				Новая[Имя] = 0;
			КонецЕсли;
		КонецЦикла;
		Если РеквизитыСтрок.Найти("ПроцентАвтоматическихСкидокРасчетная") <> Неопределено Тогда
			Новая.ПроцентАвтоматическихСкидокРасчетная = Скидка;
		КонецЕсли;
		Если РеквизитыСтрок.Найти("ПроцентСкидкиНаценки") <> Неопределено Тогда
			Новая.ПроцентСкидкиНаценки = Скидка;
		КонецЕсли;
		Если РеквизитыСтрок.Найти("ЕстьСкидка") <> Неопределено Тогда
			Новая.ЕстьСкидка = Скидка > 0;
		КонецЕсли;
		Если РеквизитыСтрок.Найти("РучноеИзменение") <> Неопределено Тогда
			Новая.РучноеИзменение = Истина;
		КонецЕсли;
		Если РеквизитыСтрок.Найти("ДокуменОснованиеСтрока") <> Неопределено Тогда
			Новая.ДокуменОснованиеСтрока = Неопределено;
		КонецЕсли;
		Если РеквизитыСтрок.Найти("ПолноеНаименование") <> Неопределено Тогда
			Новая.ПолноеНаименование = СокрЛП(Товар.НаименованиеПолное);
		КонецЕсли;
		Если РеквизитыСтрок.Найти("СтранаПроисхождения") <> Неопределено Тогда
			Новая.СтранаПроисхождения = Товар.СтранаПроисхождения;
		КонецЕсли;
		Если РеквизитыСтрок.Найти("ТорговоеНаправление") <> Неопределено Тогда
			Новая.ТорговоеНаправление = Товар.ТорговоеНаправление;
		КонецЕсли;
		Если РеквизитыСтрок.Найти("ВидтовараСтрока") <> Неопределено Тогда
			Новая.ВидтовараСтрока = Товар.ВидТовара;
		КонецЕсли;
		Есть = Остатки.Получить(Товар);
		Если ?(Есть = Неопределено, 0, Есть) < Количество Тогда
			НехватаетТовара.Добавить(Стр.Имя + ": заказано " + Формат(Стр.Штук, "ЧГ=0") + " шт, на складе " + Формат(?(Есть = Неопределено, 0, Есть) * Коэф, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	Накладная.СуммаДокумента = СуммаДок;
	Если НехватаетТовара.Количество() > 0 Тогда
		Накладная.Комментарий = Лев("НЕ ХВАТАЕТ ТОВАРА! " + Накладная.Комментарий, 250);
	КонецЕсли;

	Если Записать Тогда
		Попытка
			Накладная.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Проблемы.Добавить(Заказ.Номер + ": не удалось записать накладную: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("Объект, НехватаетТовара, Сумма", Накладная, НехватаетТовара, СуммаДок);

КонецФункции

// Пункт 16: что будет создано по новым заказам сайта. Ничего не записывается ни в 1С, ни на сайт.
Процедура ДействиеЗаказыПробная()

	Пишу("ПРОБНАЯ СБОРКА НАКЛАДНЫХ ПО ЗАКАЗАМ САЙТА (ничего не записывается). База: «" + ИмяБазы() + "», создание документов здесь "
		+ ?(СозданиеДокументовРазрешено(), "РАЗРЕШЕНО", "запрещено (настройка orders_bases)") + ".");
	Заказы = РазобратьЗаказыСайта(ЗагрузитьЗаказы());
	Если Заказы.Количество() = 0 Тогда
		Пишу("Новых заказов на сайте нет.");
		Возврат;
	КонецЕсли;
	Образец = ОбразецНакладной();
	Если Образец = Неопределено Тогда
		Пишу("Нет образца: не нашлось проведённой накладной организации «" + Нас("orders_org") + "» со строками (настройка orders_org).");
		Возврат;
	КонецЕсли;
	Пишу("Образец служебных реквизитов: " + Образец.Номер + " от " + Формат(Образец.Дата, "ДФ=dd.MM.yyyy"));
	Проблемы = Новый Массив;
	Для Каждого Заказ Из Заказы Цикл
		Пишу("");
		Пишу("=== " + Заказ.Номер + ": " + Заказ.Клиент + ", ИНН " + Заказ.ИНН + ", позиций " + Формат(Заказ.Строки.Количество(), "ЧГ=0") + ", итого " + Формат(Заказ.Итого, "ЧДЦ=2; ЧРД=,; ЧГ=0") + " руб.");
		Существует = ДокументЗаказаСайта(Заказ.Номер);
		Если Существует <> Неопределено Тогда
			Пишу("    Накладная уже есть: " + Строка(Существует) + ". Повторно не создаётся, будет только подтверждён заказ на сайте.");
			Продолжить;
		КонецЕсли;
		Итог = СобратьНакладную(Заказ, Образец, Проблемы, Ложь);
		Если Итог = Неопределено Тогда
			Пишу("    НЕ ПОЛУЧИТСЯ: " + Проблемы[Проблемы.Количество() - 1]);
			Продолжить;
		КонецЕсли;
		ОписатьСобраннуюНакладную(Заказ, Итог);
	КонецЦикла;
	Пишу("");
	Пишу("Проблем: " + Формат(Проблемы.Количество(), "ЧГ=0") + ". Ничего не создано.");

КонецПроцедуры

// Что получилось в собранной (не записанной) накладной: служебные реквизиты, сумма, строки, нехватка товара
Процедура ОписатьСобраннуюНакладную(Заказ, Итог)

	Накладная = Итог.Объект;
	Пишу("    Накладная: организация " + Строка(Накладная.Организация) + ", склад " + Строка(Накладная.Склад) + ", тип цен " + Строка(Накладная.ТипЦен)
		+ ", вид «" + Строка(Накладная.ВидНакладной) + "», название «" + Строка(Накладная.НазвДокумента) + "», подразделение " + Строка(Накладная.ПодразделениеАзалии)
		+ ", направление " + Строка(Накладная.ТорговоеНаправление) + ", ответственный " + Строка(Накладная.Ответственный));
	Пишу("    Контрагент найден. Сумма накладной " + Формат(Итог.Сумма, "ЧДЦ=2; ЧРД=,; ЧГ=0") + " (на сайте " + Формат(Заказ.Итого, "ЧДЦ=2; ЧРД=,; ЧГ=0") + "). Комментарий: " + Накладная.Комментарий);
	Если Заказ.Итого > 0 И Окр(Итог.Сумма, 0) <> Окр(Заказ.Итого, 0) Тогда
		Пишу("    ВНИМАНИЕ: сумма накладной отличается от суммы заказа на сайте - проверьте скидку и округление.");
	КонецЕсли;
	Для Каждого Строка1 Из Накладная.Товары Цикл
		Пишу("      - " + Строка(Строка1.Номенклатура) + ": " + Формат(Строка1.Количество, "ЧГ=0") + " x " + Формат(Строка1.Цена, "ЧДЦ=2; ЧРД=,; ЧГ=0")
			+ " = " + Формат(Строка1.Сумма, "ЧДЦ=2; ЧРД=,; ЧГ=0") + "; страна " + Строка(Строка1.СтранаПроисхождения) + "; склад " + Строка(Строка1.Склад));
	КонецЦикла;
	Для Каждого Текст Из Итог.НехватаетТовара Цикл
		Пишу("    НЕ ХВАТАЕТ ТОВАРА: " + Текст);
	КонецЦикла;

КонецПроцедуры

// Пункт 19: самопроверка на ВЫДУМАННОМ заказе - клиент и товары берутся из последней проведённой накладной. Ничего не записывается.
// Так проверяется весь код сборки накладной (поиск, копирование образца, расчёт цен) без настоящего заказа с сайта.
Процедура ДействиеЗаказыСамопроверка()

	Пишу("САМОПРОВЕРКА АВТОЗАКАЗОВ на выдуманном заказе (ничего не записывается ни в 1С, ни на сайт).");
	Образец = ОбразецНакладной();
	Если Образец = Неопределено Тогда
		Пишу("Нет образца: не нашлось проведённой накладной организации «" + Нас("orders_org") + "» со строками (настройка orders_org).");
		Возврат;
	КонецЕсли;
	Пишу("Образец: накладная " + Образец.Номер + " от " + Формат(Образец.Дата, "ДФ=dd.MM.yyyy") + ".");
	Клиент = Образец.Контрагент;
	Заказ = Новый Структура;
	Заказ.Вставить("Ид", "0");
	Заказ.Вставить("Номер", "САЙТ-САМОПРОВЕРКА");
	Заказ.Вставить("Когда", "");
	Заказ.Вставить("НуженК", "2026-11-12T00:00:00");
	Заказ.Вставить("Способ", "delivery");
	Заказ.Вставить("Адрес", "тестовый адрес");
	Заказ.Вставить("Комментарий", "самопроверка, не настоящий заказ");
	Заказ.Вставить("Скидка", 5);
	Заказ.Вставить("Итого", 0);
	Заказ.Вставить("КлиентИд1С", "");
	Заказ.Вставить("Клиент", СокрЛП(Клиент.Наименование));
	Заказ.Вставить("ИНН", СокрЛП(Клиент.ИНН));
	Заказ.Вставить("Телефон", "+7 000 000-00-00");
	Заказ.Вставить("Строки", Новый Массив);
	Для Индекс = 0 По Мин(1, Образец.Товары.Количество() - 1) Цикл
		Товар = Образец.Товары[Индекс].Номенклатура;
		Заказ.Строки.Добавить(Новый Структура("GUID, Артикул, Имя, ВПачке, Цена, Штук, Сумма, Поставка",
			Строка(Товар.УникальныйИдентификатор()), "", СокрЛП(Товар.Наименование), 1, 100, 10, 1000, ""));
	КонецЦикла;
	Проблемы = Новый Массив;
	Итог = СобратьНакладную(Заказ, Образец, Проблемы, Ложь);
	Если Итог = Неопределено Тогда
		Пишу("САМОПРОВЕРКА НЕ ПРОШЛА: " + ?(Проблемы.Количество() > 0, Проблемы[0], "причина не указана"));
		Возврат;
	КонецЕсли;
	ОписатьСобраннуюНакладную(Заказ, Итог);
	Пишу("");
	Пишу("Самопроверка прошла: накладная собрана в памяти, ничего не записано.");

КонецПроцедуры

// Путь к файлу, где помним, какой статус документа уже отправлен на сайт
Функция ФайлСостоянийЗаказов()

	Возврат КаталогНастроек() + "order_states.txt";

КонецФункции

Функция ПрочитатьСостоянияЗаказов()

	Результат = Новый Соответствие;
	Попытка
		Если ФайлЕсть(ФайлСостоянийЗаказов()) Тогда
			Текст = Новый ТекстовыйДокумент;
			Текст.Прочитать(ФайлСостоянийЗаказов(), КодировкаТекста.UTF8);
			Для Номер = 1 По Текст.КоличествоСтрок() Цикл
				Линия = Текст.ПолучитьСтроку(Номер);
				Позиция = Найти(Линия, "=");
				Если Позиция > 1 Тогда
					Результат.Вставить(СокрЛП(Лев(Линия, Позиция - 1)), СокрЛП(Сред(Линия, Позиция + 1)));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура СохранитьСостоянияЗаказов(Состояния)

	Попытка
		Папка = КаталогНастроек();
		Если Не ФайлЕсть(Папка) Тогда
			СоздатьКаталог(Папка);
		КонецЕсли;
		Текст = Новый ТекстовыйДокумент;
		Для Каждого Пара Из Состояния Цикл
			Текст.ДобавитьСтроку(Пара.Ключ + "=" + Пара.Значение);
		КонецЦикла;
		Текст.Записать(ФайлСостоянийЗаказов(), КодировкаТекста.UTF8);
	Исключение
		Пишу("Не удалось сохранить состояния заказов: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Статусы заказов 1С -> сайт: смотрим документы «САЙТ-N» и шлём только то, что изменилось. Назад по статусам не идём,
// «Выполнен» не ставим (это решает человек после оплаты).
Процедура СинхронизироватьСтатусыЗаказов()

	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Д.НомерЗаказа КАК НомерЗаказа, Д.Номер КАК Номер, Д.Проведен КАК Проведен, Д.ПометкаУдаления КАК Удален"
		+ " ИЗ Документ.РеализацияТоваровУслуг КАК Д ГДЕ Д.НомерЗаказа ПОДОБНО ""САЙТ-%""";
	Выборка = Запрос.Выполнить().Выбрать();
	Состояния = ПрочитатьСостоянияЗаказов();
	Порядок = Новый Соответствие;
	Порядок.Вставить("Подтверждён", 1);
	Порядок.Вставить("Отправлен", 3);
	Порядок.Вставить("Отменён", 9);
	Очередь = Новый Массив;
	Пока Выборка.Следующий() Цикл
		НовыйСтатус = ?(Выборка.Удален, "Отменён", ?(Выборка.Проведен, "Отправлен", "Подтверждён"));
		Было = Состояния.Получить(Выборка.НомерЗаказа);
		Если Было = НовыйСтатус Тогда
			Продолжить;
		КонецЕсли;
		// назад по статусам не идём: если уже отправили «Отправлен», не возвращаем «Подтверждён»
		Если Было <> Неопределено Тогда
			ПорядокБыло = Порядок.Получить(Было);
			Если ПорядокБыло <> Неопределено И ПорядокБыло > Порядок.Получить(НовыйСтатус) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Очередь.Добавить(Новый Структура("Номер1С, НомерСайта, Статус", Выборка.Номер, Выборка.НомерЗаказа, НовыйСтатус));
	КонецЦикла;
	Если Очередь.Количество() = 0 Тогда
		Пишу("Статусы заказов: изменений нет.");
		Возврат;
	КонецЕсли;
	Для Каждого Эл Из Очередь Цикл
		Тело = "{""orders"":[{""number"":" + JSONСтрока(Эл.НомерСайта) + ",""status"":" + JSONСтрока(Эл.Статус) + ",""onec_number"":" + JSONСтрока(Эл.Номер1С) + "}]}";
		Ответ = ВызватьСайт("POST", "/api/1c/orders/status", Тело);
		Если Не ПустаяСтрока(Ответ.Ошибка) Или Ответ.Код <> 200 Или Найти(Ответ.Текст, """errors"":[{") > 0 Тогда
			Пишу("Статус " + Эл.НомерСайта + " -> «" + Эл.Статус + "» не принят: " + Лев(ОписатьОтвет(Ответ), 300));
			Продолжить;
		КонецЕсли;
		Состояния.Вставить(Эл.НомерСайта, Эл.Статус);
		Пишу("Статус заказа " + Эл.НомерСайта + " -> «" + Эл.Статус + "» (документ 1С " + Эл.Номер1С + "): ответ сайта принят.");
	КонецЦикла;
	СохранитьСостоянияЗаказов(Состояния);

КонецПроцедуры

// Создаёт накладные по новым заказам сайта, подтверждает перенос и шлёт статусы. Только в базах из orders_bases.
Процедура СоздатьНакладныеЗаказов()

	Если Не СозданиеДокументовРазрешено() Тогда
		Пишу("Создание документов в базе «" + ИмяБазы() + "» не разрешено: имя базы не указано в настройке orders_bases (settings.ini). Сначала приёмка на копии-черновике.");
		Возврат;
	КонецЕсли;
	Заказы = РазобратьЗаказыСайта(ЗагрузитьЗаказы());
	Если Заказы.Количество() = 0 Тогда
		Пишу("Новых заказов на сайте нет.");
		СинхронизироватьСтатусыЗаказов();
		Возврат;
	КонецЕсли;
	Образец = ОбразецНакладной();
	Если Образец = Неопределено Тогда
		Пишу("СТОП: не нашлось образца - проведённой накладной организации «" + Нас("orders_org") + "» со строками (настройка orders_org).");
		Возврат;
	КонецЕсли;
	Проблемы = Новый Массив;
	Подтверждения = Новый Массив;
	Подтвердить1 = Новый Массив;
	Для Каждого Заказ Из Заказы Цикл
		Номер1С = "";
		Существует = ДокументЗаказаСайта(Заказ.Номер);
		Если Существует <> Неопределено Тогда
			Номер1С = Строка(Существует.Номер);
			Пишу(Заказ.Номер + ": накладная уже есть (" + Номер1С + "), повторно не создаю.");
		Иначе
			Итог = СобратьНакладную(Заказ, Образец, Проблемы, Истина);
			Если Итог = Неопределено Тогда
				Пишу("Заказ " + Заказ.Номер + " оставлен новым: " + Проблемы[Проблемы.Количество() - 1]);
				Продолжить;
			КонецЕсли;
			Номер1С = Строка(Итог.Объект.Номер);
			Пишу(Заказ.Номер + ": создана накладная " + Номер1С + " (не проведена), сумма " + Формат(Итог.Сумма, "ЧДЦ=2; ЧРД=,; ЧГ=0")
				+ ?(Итог.НехватаетТовара.Количество() > 0, "; НЕ ХВАТАЕТ ТОВАРА: " + СоединитьСтроки(Итог.НехватаетТовара, "; "), ""));
		КонецЕсли;
		Подтверждения.Добавить("{""number"":" + JSONСтрока(Заказ.Номер) + ",""onec_number"":" + JSONСтрока(Номер1С) + "}");
	КонецЦикла;
	Если Подтверждения.Количество() > 0 Тогда
		Ответ = ВызватьСайт("POST", "/api/1c/orders/ack", "{""orders"":[" + СоединитьСтроки(Подтверждения, ",") + "]}");
		Если Не ПустаяСтрока(Ответ.Ошибка) Или Ответ.Код <> 200 Тогда
			Пишу("Не удалось подтвердить перенос заказов на сайте: " + ОписатьОтвет(Ответ));
		Иначе
			Пишу("Сайт подтвердил перенос заказов: " + Формат(ЧислоИзОтвета(Ответ.Текст, "acked"), "ЧГ=0") + " из " + Формат(Подтверждения.Количество(), "ЧГ=0") + ".");
		КонецЕсли;
	КонецЕсли;
	Если Проблемы.Количество() > 0 Тогда
		Пишу("Не перенесены (останутся новыми и придут снова): " + Формат(Проблемы.Количество(), "ЧГ=0") + ".");
	КонецЕсли;
	СинхронизироватьСтатусыЗаказов();

КонецПроцедуры

// Пункт 17
Процедура ДействиеЗаказыСоздать()

	Если ЭтоАвто Тогда
		СоздатьНакладныеЗаказов();
		Возврат;
	КонецЕсли;
	Если Не СозданиеДокументовРазрешено() Тогда
		Пишу("Создание документов в базе «" + ИмяБазы() + "» не разрешено: имя базы не указано в настройке orders_bases (settings.ini).");
		Пишу("Это защита рабочей базы. Сначала проверьте работу на копии-черновике и добавьте её имя в orders_bases.");
		Возврат;
	КонецЕсли;
	Если Не Подтвердить("Создать в базе «" + ИмяБазы() + "» НЕпроведённые накладные по новым заказам сайта и подтвердить перенос на сайте?" + Символы.ПС + "Заранее посмотрите пункт 16.") Тогда
		Пишу("Отменено.");
		Возврат;
	КонецЕсли;
	СоздатьНакладныеЗаказов();

КонецПроцедуры

// ----------------------------------------------------------------------------
// Фото товаров из папки -> сайт (пункты 20 и 21)
// Сотрудник снимает пачку на телефон, кладёт файл в папку Документы\Dianthus1C\photos, называет файл ТОЧНО как товар в 1С
// («Мондиал 60 Tessa.jpg»; второе фото — «Мондиал 60 Tessa #2.jpg») и нажимает пункт 21. Тот же ключ, тот же канал, что и у обмена
// (/api/1c/products/photo): доступа на сервер не нужно. Повторная отправка того же файла ничего не меняет.
// ----------------------------------------------------------------------------

// Название для сравнения: регистр, «ё» и лишние пробелы не важны
Функция НормаНазвания(Текст)

	Результат = НРег(СтрЗаменить(СокрЛП(Текст), Символы.НПП, " "));
	Результат = СтрЗаменить(Результат, "ё", "е");
	Пока Найти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// «Название по нормализованному виду -> ссылка на товар»; Null, если в 1С несколько товаров с таким названием
Функция КартаНоменклатурыПоНазванию()

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Н.Ссылка КАК Ссылка, Н.Наименование КАК Имя ИЗ Справочник.Номенклатура КАК Н ГДЕ НЕ Н.ЭтоГруппа И НЕ Н.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НормаНазвания(Выборка.Имя);
		Если Результат.Получить(Ключ) = Неопределено Тогда
			Результат.Вставить(Ключ, Выборка.Ссылка);
		Иначе
			Результат.Вставить(Ключ, Null);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Одно фото на сайт: тело запроса - сама картинка. Результат: Структура(Код, Текст, Ошибка)
Функция ОтправитьФотоНаСайт(GUID, Номер, Двоичные, ПроверкаБезСохранения)

	Результат = Новый Структура("Код, Текст, Ошибка", 0, "", "");
	Адрес = РазобратьАдрес(Нас("site"));
	Если Не ПустаяСтрока(Адрес.Ошибка) Или ПустаяСтрока(Адрес.Хост) Тогда
		Результат.Ошибка = ?(ПустаяСтрока(Адрес.Ошибка), "не указан адрес сайта", Адрес.Ошибка);
		Возврат Результат;
	КонецЕсли;
	Попытка
		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , 120, Новый ЗащищенноеСоединениеOpenSSL());
		Запрос = Новый HTTPЗапрос("/api/1c/products/photo?id=" + GUID + "&n=" + Формат(Номер, "ЧГ=0") + ?(ПроверкаБезСохранения, "&dry_run=1", ""));
		Запрос.Заголовки.Вставить("X-API-Key", Нас("key"));
		Запрос.Заголовки.Вставить("Content-Type", "application/octet-stream");
		Запрос.УстановитьТелоИзДвоичныхДанных(Двоичные);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Результат.Код = Ответ.КодСостояния;
		Результат.Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура ДействиеФото(ПроверкаБезСохранения)

	Папка = КаталогНастроек() + "photos\";
	Если Не ФайлЕсть(Папка) Тогда
		Попытка
			СоздатьКаталог(Папка);
		Исключение
			Пишу("Не удалось создать папку " + Папка + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	Пишу("ФОТО ТОВАРОВ -> САЙТ " + ?(ПроверкаБезСохранения, "(проверка, на сайте ничего не сохраняется)", "(отправка)"));
	Пишу("Папка с фото: " + Папка);
	Пишу("Правило: имя файла = название товара в 1С (регистр, «ё» и лишние пробелы не важны). Второе фото того же товара: «Название #2.jpg», третье - «#3». Форматы jpg, png, webp. Снимайте пачку целиком на светлом фоне. Товар должен быть на сайте (в наличии или в пути).");
	Рабочие = Новый Массив;
	Для Каждого Файл Из НайтиФайлы(Папка, "*.*") Цикл
		Расш = НРег(Файл.Расширение);
		Если Не Файл.ЭтоКаталог() И (Расш = ".jpg" Или Расш = ".jpeg" Или Расш = ".png" Или Расш = ".webp") Тогда
			Рабочие.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;
	Если Рабочие.Количество() = 0 Тогда
		Пишу("");
		Пишу("В папке пока нет фото. Проверяю только канал связи (нужного товара нет, поэтому ждём ответ 404 «такого товара на сайте нет» - он значит, что адрес и ключ работают).");
		Пробная = Base64Значение("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==");
		Ответ = ОтправитьФотоНаСайт("00000000-0000-0000-0000-000000000000", 1, Пробная, Истина);
		Пишу("Ответ канала: " + ?(ПустаяСтрока(Ответ.Ошибка), "код " + Формат(Ответ.Код, "ЧГ=0") + " " + Лев(Ответ.Текст, 200), "НЕ УДАЛОСЬ: " + Ответ.Ошибка));
		Возврат;
	КонецЕсли;
	Карта = КартаНоменклатурыПоНазванию();
	Хорошо = 0;
	Плохо = 0;
	Для Каждого Файл Из Рабочие Цикл
		Имя = Файл.ИмяБезРасширения;
		Номер = 1;
		Позиция = Найти(Имя, " #");
		Если Позиция > 0 Тогда
			Попытка
				Номер = Число(Сред(Имя, Позиция + 2));
			Исключение
				Номер = 1;
			КонецПопытки;
			Имя = Лев(Имя, Позиция - 1);
		КонецЕсли;
		Товар = Карта.Получить(НормаНазвания(Имя));
		Если Товар = Неопределено Или Товар = Null Тогда
			Пишу(Файл.Имя + ": " + ?(Товар = Null, "в 1С несколько товаров с таким названием - назовите файл иначе или фото загрузите на сайте вручную", "в 1С нет товара с таким названием - проверьте имя файла"));
			Плохо = Плохо + 1;
			Продолжить;
		КонецЕсли;
		Ответ = ОтправитьФотоНаСайт(Строка(Товар.УникальныйИдентификатор()), Номер, Новый ДвоичныеДанные(Файл.ПолноеИмя), ПроверкаБезСохранения);
		Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
			Пишу(Файл.Имя + ": ОШИБКА связи: " + Ответ.Ошибка);
			Плохо = Плохо + 1;
		ИначеЕсли Ответ.Код = 200 Тогда
			Итог = "принято";
			Если Найти(Ответ.Текст, """result"":""saved""") > 0 Тогда
				Итог = "сохранено на сайте";
			ИначеЕсли Найти(Ответ.Текст, """result"":""unchanged""") > 0 Тогда
				Итог = "такое же фото уже есть";
			ИначеЕсли Найти(Ответ.Текст, """result"":""would_save""") > 0 Тогда
				Итог = "проверка пройдена, при отправке будет сохранено";
			КонецЕсли;
			Пишу(Файл.Имя + " -> «" + Строка(Товар.Наименование) + "», фото №" + Формат(Номер, "ЧГ=0") + ": " + Итог);
			Хорошо = Хорошо + 1;
		Иначе
			Пишу(Файл.Имя + ": сайт не принял: " + ОписатьОтвет(Ответ));
			Плохо = Плохо + 1;
		КонецЕсли;
	КонецЦикла;
	Пишу("");
	Пишу("Файлов: " + Формат(Рабочие.Количество(), "ЧГ=0") + ", принято: " + Формат(Хорошо, "ЧГ=0") + ", не принято: " + Формат(Плохо, "ЧГ=0") + ".");

КонецПроцедуры

