// Список «название -> ссылка» из справочника (для выбора в диалоге)
Функция СписокЭлементов(ИмяСправочника, Группы = Ложь, Лимит = 60)

	Список = Новый СписокЗначений;
	ОбъектМД = Метаданные.Справочники.Найти(ИмяСправочника);
	Если ОбъектМД = Неопределено Тогда
		Возврат Список;
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0"));
	Строки.Добавить("	С.Ссылка КАК Ссылка,");
	Строки.Добавить("	С.Наименование КАК Имя");
	Строки.Добавить("ИЗ Справочник." + ИмяСправочника + " КАК С");
	Строки.Добавить("ГДЕ С.ПометкаУдаления = ЛОЖЬ");
	Если ОбъектМД.Иерархический Тогда
		Если Группы Тогда
			Строки.Добавить("	И С.ЭтоГруппа = ИСТИНА");
			Строки.Добавить("	И С.Родитель = ЗНАЧЕНИЕ(Справочник." + ИмяСправочника + ".ПустаяСсылка)");
		Иначе
			Строки.Добавить("	И С.ЭтоГруппа = ЛОЖЬ");
		КонецЕсли;
	КонецЕсли;
	Строки.Добавить("УПОРЯДОЧИТЬ ПО С.Наименование");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Имя, Выборка.Имя);
	КонецЦикла;
	Возврат Список;

КонецФункции

// ----------------------------------------------------------------------------
// Первая настройка
// ----------------------------------------------------------------------------

Процедура Настроить()

	Пишу("НАСТРОЙКА. Файл настроек: " + КаталогНастроек() + "settings.ini");

	Значение = СпроситьСтроку("Адрес сайта (начинается с https://)", Нас("site"));
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Настройки.Вставить("site", Значение);

	Значение = СпроситьСтроку("Ключ доступа из админки сайта («Интеграция с 1С»): вставьте его целиком (Ctrl+V), он начинается с dnt_", Нас("key"), 100);
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Настройки.Вставить("key", Значение);

	Попытка
		Список = СписокЭлементов("Склады");
		Если Список.Количество() > 0 Тогда
			Элемент = Список.ВыбратьЭлемент("С какого склада брать остатки для сайта? (обычно «Главный»)");
			Если Элемент <> Неопределено Тогда
				Настройки.Вставить("warehouse", Элемент.Значение);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Пишу("Склады не прочитаны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	СохранитьНастройки();
	Пишу("");
	Пишу("Сохранено:");
	ПоказатьНастройки();

КонецПроцедуры

Процедура ПоказатьНастройки()

	Пишу("  Сайт:               " + Нас("site"));
	Пишу("  Ключ:               " + КлючКратко());
	Пишу("  Склад:              " + Нас("warehouse") + "  (несколько складов через «;» можно вписать в settings.ini)");
	Пишу("  Инвойсы:            слова «" + Нас("invoice_words") + "», «в пути» = " + ?(Нас("transit_rule") = "future", "дата в будущем", "не проведён"));
	Пишу("  Полный снимок:      " + ?(ПолныйРежимИнвойсов(), "да: все проведённые для остатков; в пути/отмены за " + Нас("invoice_days") + " дн. и будущие", "нет: только за " + Нас("invoice_days") + " дн. и будущие, full не отправляется"));
	Пишу("  Виды инвойсов:      " + ?(ПустаяСтрока(Нас("invoice_kinds")), "все (срезка, аксессуары, горшечные растения)", "только со словами «" + Нас("invoice_kinds") + "» в виде документа"));
	Пишу("  Штучный товар:      " + ?(ПустаяСтрока(Нас("piece_words")), "(не задан)", "виды документов со словами «" + Нас("piece_words") + "»: пачка = 1 шт"));
	Пишу("  Остаток по складу:  " + ?(Нас("cap_stock") = "1", "оприходованным инвойсам оставляем только то, что лежит на складе", "количество берётся по документу"));
	Пишу("  Вычитать резервы:   " + ?(Нас("use_reserves") = "1", "да", "нет"));
	Пишу("  Пачка по умолчанию: " + Нас("default_pack") + " шт (только если в 1С размер пачки не указан и вид товара незнакомый)");
	Пишу("  Автообмен:          каталог " + ?(Нас("auto_catalog") = "1", "ВКЛ", "выкл") + ", инвойсы " + ?(Нас("auto_invoices") = "1", "ВКЛ", "выкл"));
	Пишу("  Для режима «каталог без поставки» (пункты 3-5) в settings.ini есть ещё group=" + Нас("group") + " и price_type=" + ?(ПустаяСтрока(Нас("price_type")), "(не задан)", Нас("price_type")) + ".");

КонецПроцедуры

// ----------------------------------------------------------------------------
// Сведения о товарах: цена, остаток, упаковка
// ----------------------------------------------------------------------------

// Склады из настроек (массив ссылок)
Функция СкладыИзНастроек()

	Результат = Новый Массив;
	Для Каждого Название Из РазделитьСтроку(Нас("warehouse"), ";") Цикл
		Ссылка = НайтиЭлемент("Склады", СокрЛП(Название));
		Если Ссылка <> Неопределено И ЗначениеЗаполнено(Ссылка) Тогда
			Результат.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Остатки по товарам: Соответствие «ссылка -> количество в единицах хранения»
Функция ОстаткиТоваров(ИмяРегистра, Ссылки, Склады)

	Результат = Новый Соответствие;
	ОбъектМД = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если ОбъектМД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Поле = ПервоеПоле(ОбъектМД.Ресурсы, "Количество|ВНаличии|КоличествоОстаток");
	Если ПустаяСтрока(Поле) Или ОбъектМД.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Пишу("Регистр «" + ИмяРегистра + "»: не нашёл ресурс количества или измерение «Номенклатура». Ресурсы: "
			+ ИменаПолей(ОбъектМД.Ресурсы) + ". Измерения: " + ИменаПолей(ОбъектМД.Измерения));
		Возврат Результат;
	КонецЕсли;
	Условие = "Номенклатура В (&Ссылки)";
	Если Склады.Количество() > 0 И ОбъектМД.Измерения.Найти("Склад") <> Неопределено Тогда
		Условие = "Склад В (&Склады) И " + Условие;
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ О.Номенклатура КАК Товар, СУММА(О." + Поле + "Остаток) КАК Кол");
	Строки.Добавить("ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки(, " + Условие + ") КАК О");
	Строки.Добавить("СГРУППИРОВАТЬ ПО О.Номенклатура");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.УстановитьПараметр("Склады", Склады);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Товар, ЧислоИлиНоль(Выборка.Кол));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Запрос цен выбранного типа: Соответствие «ссылка -> Структура(Цена, Коэф)»
Функция ВыполнитьЗапросЦен(ПолеЦены, ПолеТипа, ТипЦен, Ссылки, СЕдиницей)

	Результат = Новый Соответствие;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ Ц.Номенклатура КАК Товар, Ц." + ПолеЦены + " КАК Цена"
		+ ?(СЕдиницей, ", Ц.ЕдиницаИзмерения.Коэффициент КАК Коэф", ""));
	Строки.Добавить("ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, " + ПолеТипа + " = &ТипЦен И Номенклатура В (&Ссылки)) КАК Ц");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цена = ЧислоИлиНоль(Выборка.Цена);
		Если Цена <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Коэф = 1;
		Если СЕдиницей Тогда
			Коэф = ЧислоИлиНоль(Выборка.Коэф);
			Если Коэф <= 0 Тогда
				Коэф = 1;
			КонецЕсли;
		ИначеЕсли Нас("price_unit") = "pack" Тогда
			Коэф = 0;     // цена за упаковку: переведём, когда узнаем размер упаковки
		КонецЕсли;
		Результат.Вставить(Выборка.Товар, Новый Структура("Цена, Коэф", Цена, Коэф));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Цены: Соответствие «ссылка -> цена за штуку»
Функция ЦеныТоваров(Ссылки, Инфо)

	Результат = Новый Соответствие;
	МДЦен = Метаданные.РегистрыСведений.Найти("ЦеныНоменклатуры");
	Если МДЦен = Неопределено Тогда
		Пишу("ОШИБКА: нет регистра сведений «ЦеныНоменклатуры».");
		Возврат Результат;
	КонецЕсли;
	ПолеТипа = ПервоеПоле(МДЦен.Измерения, "ТипЦен|ТипЦены|ВидЦены|ВидЦен");
	ПолеЦены = ПервоеПоле(МДЦен.Ресурсы, "Цена");
	Если ПустаяСтрока(ПолеТипа) Или ПустаяСтрока(ПолеЦены) Или МДЦен.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Пишу("Регистр «ЦеныНоменклатуры»: не нашёл нужные поля. Измерения: " + ИменаПолей(МДЦен.Измерения)
			+ ". Ресурсы: " + ИменаПолей(МДЦен.Ресурсы));
		Возврат Результат;
	КонецЕсли;
	МДТипов = НайтиСправочник("ТипыЦенНоменклатуры|ВидыЦен|ТипыЦен");
	Если МДТипов = Неопределено Или ПустаяСтрока(Нас("price_type")) Тогда
		Пишу("Не выбран тип цен: пункт 2 (первая настройка).");
		Возврат Результат;
	КонецЕсли;
	ТипЦен = НайтиЭлемент(МДТипов.Имя, Нас("price_type"));
	Если Не ЗначениеЗаполнено(ТипЦен) Тогда
		Пишу("Тип цен «" + Нас("price_type") + "» не найден в справочнике «" + МДТипов.Имя + "».");
		Возврат Результат;
	КонецЕсли;
	ЕстьЕдиница = МДЦен.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено;
	Попытка
		Результат = ВыполнитьЗапросЦен(ПолеЦены, ПолеТипа, ТипЦен, Ссылки, ЕстьЕдиница);
	Исключение
		Если ЕстьЕдиница Тогда
			Пишу("Цены вместе с единицей измерения не прочитаны (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
				+ "); читаю без неё: цена считается за штуку (или за упаковку, если price_unit=pack).");
			ЕстьЕдиница = Ложь;
			Результат = ВыполнитьЗапросЦен(ПолеЦены, ПолеТипа, ТипЦен, Ссылки, Ложь);
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	Инфо.Вставить("ЦенаПоЕдинице", ЕстьЕдиница);
	Возврат Результат;

КонецФункции

// Единицы измерения: Соответствие «ссылка товара -> массив структур(Имя, Коэф)»
Функция ЕдиницыТоваров(Ссылки)

	Результат = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Е.Владелец КАК Товар, Е.Наименование КАК Имя, Е.Коэффициент КАК Коэф"
			+ Символы.ПС + "ИЗ Справочник.ЕдиницыИзмерения КАК Е"
			+ Символы.ПС + "ГДЕ Е.Владелец В (&Ссылки) И Е.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Список = Результат.Получить(Выборка.Товар);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				Результат.Вставить(Выборка.Товар, Список);
			КонецЕсли;
			Список.Добавить(Новый Структура("Имя, Коэф", Выборка.Имя, Выборка.Коэф));
		КонецЦикла;
	Исключение
		Пишу("Единицы измерения не прочитаны (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ "): размер упаковки возьму из настройки default_pack.");
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Все сведения о товарах по списку ссылок: Соответствие «ссылка -> Структура».
// НужныЦены = Ложь: цены из регистра не читаются (для инвойсов цена берётся из строки документа).
Функция СведенияОТоварах(Ссылки, НужныЦены = Истина)

	Результат = Новый Соответствие;
	МДН = Метаданные.Справочники.Найти("Номенклатура");
	Если МДН = Неопределено Тогда
		Пишу("ОШИБКА: в базе нет справочника «Номенклатура».");
		Возврат Результат;
	КонецЕсли;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ЕстьАртикул = МДН.Реквизиты.Найти("Артикул") <> Неопределено;
	ЕстьЕдХран = МДН.Реквизиты.Найти("ЕдиницаХраненияОстатков") <> Неопределено;
	ЕстьВид = МДН.Реквизиты.Найти("ВидТовара") <> Неопределено;
	ЕстьВысота = МДН.Реквизиты.Найти("Высота") <> Неопределено;
	ЕстьСтрана = МДН.Реквизиты.Найти("СтранаПроисхождения") <> Неопределено;
	ЕстьНапр = МДН.Реквизиты.Найти("ТорговоеНаправление") <> Неопределено;
	ЕстьПостНом = МДН.Реквизиты.Найти("Поставщик") <> Неопределено;
	ЕстьПлант = МДН.Реквизиты.Найти("Плантации") <> Неопределено;
	ЕстьКоробНом = МДН.Реквизиты.Найти("КоличествоВКоробке") <> Неопределено;

	Поля = Новый Массив;
	Поля.Добавить("	Н.Ссылка КАК Ссылка");
	Поля.Добавить("	Н.Код КАК Код");
	Поля.Добавить("	Н.Наименование КАК Имя");
	Поля.Добавить("	Н.Родитель.Наименование КАК Группа");
	Если ЕстьАртикул Тогда
		Поля.Добавить("	Н.Артикул КАК Артикул");
	КонецЕсли;
	Если ЕстьЕдХран Тогда
		Поля.Добавить("	Н.ЕдиницаХраненияОстатков.Наименование КАК ЕдХранИмя");
		Поля.Добавить("	Н.ЕдиницаХраненияОстатков.Коэффициент КАК ЕдХранКоэф");
	КонецЕсли;
	Если ЕстьВид Тогда
		Поля.Добавить("	Н.ВидТовара КАК ВидТовара");
	КонецЕсли;
	Если ЕстьВысота Тогда
		Поля.Добавить("	Н.Высота КАК Высота");
	КонецЕсли;
	Если ЕстьСтрана Тогда
		Поля.Добавить("	Н.СтранаПроисхождения КАК СтранаТовара");
	КонецЕсли;
	Если ЕстьНапр Тогда
		Поля.Добавить("	Н.ТорговоеНаправление КАК Направление");
	КонецЕсли;
	Если ЕстьПостНом Тогда
		Поля.Добавить("	Н.Поставщик КАК ПоставщикНом");
	КонецЕсли;
	Если ЕстьПлант Тогда
		Поля.Добавить("	Н.Плантации КАК Плантация");
	КонецЕсли;
	Если ЕстьКоробНом Тогда
		Поля.Добавить("	Н.КоличествоВКоробке КАК КоробНом");
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ");
	Строки.Добавить(СоединитьСтроки(Поля, "," + Символы.ПС));
	Строки.Добавить("ИЗ Справочник.Номенклатура КАК Н");
	Строки.Добавить("ГДЕ Н.Ссылка В (&Ссылки)");
	Запрос = Новый Запрос;
	Запрос.Текст = СоединитьСтроки(Строки, Символы.ПС);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Карточки = Запрос.Выполнить().Выгрузить();

	Склады = СкладыИзНастроек();
	Остатки = ОстаткиТоваров("ТоварыНаСкладах", Ссылки, Склады);
	Резервы = Новый Соответствие;
	Если Нас("use_reserves") = "1" Тогда
		Резервы = ОстаткиТоваров("ТоварыВРезервеНаСкладах", Ссылки, Склады);
	КонецЕсли;
	Инфо = Новый Структура;
	Цены = Новый Соответствие;
	Если НужныЦены Тогда
		Цены = ЦеныТоваров(Ссылки, Инфо);
	КонецЕсли;
	Единицы = ЕдиницыТоваров(Ссылки);
	ПоУмолчанию = 25;
	Попытка
		ПоУмолчанию = Число(Нас("default_pack"));
	Исключение
	КонецПопытки;

	Для Каждого Карта Из Карточки Цикл
		Св = Новый Структура;
		Св.Вставить("Ссылка", Карта.Ссылка);
		Св.Вставить("GUID", Строка(Карта.Ссылка.УникальныйИдентификатор()));
		Св.Вставить("Код", Карта.Код);
		Св.Вставить("Имя", СокрЛП(Карта.Имя));
		Св.Вставить("Группа", ?(Карта.Группа = Null, "", Карта.Группа));
		Артикул = "";
		Если ЕстьАртикул Тогда
			Артикул = СокрЛП(Строка(Карта.Артикул));
		КонецЕсли;
		Св.Вставить("Артикул", Артикул);
		Вид = "";
		Если ЕстьВид Тогда
			Вид = ТекстЗначения(Карта.ВидТовара);
		КонецЕсли;
		Св.Вставить("Вид", Вид);
		Высота = 0;
		Если ЕстьВысота Тогда
			Высота = ПерваяЧисло(Карта.Высота);
		КонецЕсли;
		Св.Вставить("Высота", Высота);
		СтранаТовара = "";
		Если ЕстьСтрана Тогда
			СтранаТовара = НазваниеСтраны(ТекстЗначения(Карта.СтранаТовара));
		КонецЕсли;
		Св.Вставить("СтранаТовара", СтранаТовара);
		СтранаТовараТекст = "";
		Если ЕстьСтрана Тогда
			СтранаТовараТекст = ТекстЗначения(Карта.СтранаТовара);
		КонецЕсли;
		Св.Вставить("СтранаТовараТекст", СтранаТовараТекст);
		Направление = "";
		Если ЕстьНапр Тогда
			Направление = ТекстЗначения(Карта.Направление);
		КонецЕсли;
		Св.Вставить("Направление", Направление);
		ПоставщикНом = "";
		Если ЕстьПостНом Тогда
			ПоставщикНом = ТекстЗначения(Карта.ПоставщикНом);
		КонецЕсли;
		Св.Вставить("ПоставщикНом", ПоставщикНом);
		Плантация = "";
		Если ЕстьПлант Тогда
			Плантация = ТекстЗначения(Карта.Плантация);
		КонецЕсли;
		Св.Вставить("Плантация", Плантация);
		КоробНом = 0;
		Если ЕстьКоробНом Тогда
			КоробНом = ПерваяЧисло(Карта.КоробНом);
		КонецЕсли;
		Св.Вставить("КоробНом", КоробНом);
		ЕдХранИмя = "";
		КоэфХран = 1;
		Если ЕстьЕдХран Тогда
			ЕдХранИмя = СокрЛП(Строка(Карта.ЕдХранИмя));
			Если ЧислоИлиНоль(Карта.ЕдХранКоэф) > 0 Тогда
				КоэфХран = Карта.ЕдХранКоэф;
			КонецЕсли;
		КонецЕсли;
		Св.Вставить("ЕдХранИмя", ЕдХранИмя);
		Св.Вставить("КоэфХран", КоэфХран);

		// размер упаковки: из единиц измерения («пачка» = 25 шт), иначе из настройки
		Упаковка = 0;
		ИзЕдиниц = Ложь;
		СписокЕд = Единицы.Получить(Карта.Ссылка);
		Если СписокЕд <> Неопределено Тогда
			Для Каждого Ед Из СписокЕд Цикл
				Если ЧислоИлиНоль(Ед.Коэф) > 1 И СодержитСлово(Ед.Имя, "", Нас("pack_words")) Тогда
					Упаковка = Окр(Ед.Коэф);
					ИзЕдиниц = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Упаковка = 0 И КоэфХран > 1 И СодержитСлово(ЕдХранИмя, "", Нас("pack_words")) Тогда
			Упаковка = Окр(КоэфХран);
			ИзЕдиниц = Истина;
		КонецЕсли;
		Если Упаковка = 0 Тогда
			Упаковка = ?(ПоУмолчанию >= 1, Окр(ПоУмолчанию), 1);
		КонецЕсли;
		Св.Вставить("Упаковка", Упаковка);
		Св.Вставить("УпаковкаИзЕдиниц", ИзЕдиниц);

		// цена за штуку
		ЦенаШт = 0;
		Ц = Цены.Получить(Карта.Ссылка);
		Если Ц <> Неопределено Тогда
			Если Ц.Коэф > 0 Тогда
				ЦенаШт = Ц.Цена / Ц.Коэф;
			Иначе
				ЦенаШт = Ц.Цена / Упаковка;
			КонецЕсли;
		КонецЕсли;
		Св.Вставить("ЦенаШт", Окр(ЦенаШт, 2));

		// остаток в штуках = (остаток - резерв) * штук в единице хранения
		Ост = Остатки.Получить(Карта.Ссылка);
		Рез = Резервы.Получить(Карта.Ссылка);
		Остаток = ?(Ост = Неопределено, 0, Ост) - ?(Рез = Неопределено, 0, Рез);
		Св.Вставить("ОстатокЕд", ?(Ост = Неопределено, 0, Ост));
		Св.Вставить("РезервЕд", ?(Рез = Неопределено, 0, Рез));
		Св.Вставить("Стеблей", Макс(0, Окр(Остаток * КоэфХран)));
		Результат.Вставить(Карта.Ссылка, Св);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------------
// Каталог: подготовка, предпросмотр, отправка
// ----------------------------------------------------------------------------

// Строки каталога для сайта (массив структур) или Неопределено, если не получилось
Функция ПодготовитьКаталог()

	МДН = Метаданные.Справочники.Найти("Номенклатура");
	Если МДН = Неопределено Тогда
		Пишу("ОШИБКА: в базе нет справочника «Номенклатура».");
		Возврат Неопределено;
	КонецЕсли;
	Группы = Новый Массив;
	Для Каждого Название Из РазделитьСтроку(Нас("group"), ";") Цикл
		Ссылка = НайтиЭлемент("Номенклатура", СокрЛП(Название));
		Если Ссылка = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
			Пишу("Группа номенклатуры «" + СокрЛП(Название) + "» не найдена: пункт 2 (первая настройка).");
			Возврат Неопределено;
		КонецЕсли;
		Группы.Добавить(Ссылка);
	КонецЦикла;
	Если Группы.Количество() = 0 Тогда
		Пишу("Не выбрана группа товаров: пункт 2 (первая настройка).");
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Н.Ссылка КАК Ссылка ИЗ Справочник.Номенклатура КАК Н"
		+ Символы.ПС + "ГДЕ Н.ЭтоГруппа = ЛОЖЬ И Н.ПометкаУдаления = ЛОЖЬ И Н.Ссылка В ИЕРАРХИИ (&Группы)";
	Запрос.УстановитьПараметр("Группы", Группы);
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Пишу("Товаров в группе «" + Нас("group") + "»: " + Формат(Ссылки.Количество(), "ЧГ=0"));
	Сведения = СведенияОТоварах(Ссылки);

	Строки = Новый Массив;
	БезЦены = 0;
	БезОстатка = 0;
	Для Каждого Ссылка Из Ссылки Цикл
		Св = Сведения.Получить(Ссылка);
		Если Св = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Св.ЦенаШт <= 0 Тогда
			БезЦены = БезЦены + 1;
		ИначеЕсли Св.Стеблей <= 0 Тогда
			БезОстатка = БезОстатка + 1;
		Иначе
			Строки.Добавить(Св);
		КонецЕсли;
	КонецЦикла;
	Пишу("Без цены (не отправляются): " + Формат(БезЦены, "ЧГ=0") + "; без остатка (не отправляются, на сайте исчезнут): "
		+ Формат(БезОстатка, "ЧГ=0") + "; к отправке: " + Формат(Строки.Количество(), "ЧГ=0"));
	Возврат Строки;

КонецФункции

Процедура ПоказатьПримеры(Строки, Сколько = 25)

	Пишу("");
	Пишу("Первые " + Формат(Мин(Сколько, Строки.Количество()), "ЧГ=0") + " строк (так увидит сайт):");
	Пишу("название | упаковка | цена за штуку | остаток, шт | как посчитано");
	Номер = 0;
	Для Каждого Св Из Строки Цикл
		Номер = Номер + 1;
		Если Номер > Сколько Тогда
			Прервать;
		КонецЕсли;
		Откуда = "";
		Если Св.УпаковкаИзЕдиниц Тогда
			Откуда = "упаковка из единиц измерения";
		Иначе
			Откуда = "упаковка по умолчанию " + Формат(Св.Упаковка, "ЧГ=0") + " (единица «пачка» не найдена)";
		КонецЕсли;
		Пишу(Св.Имя + " | " + Формат(Св.Упаковка, "ЧГ=0") + " шт | " + Формат(Св.ЦенаШт, "ЧДЦ=2; ЧРД=,; ЧГ=0") + " ₽ | "
			+ Формат(Св.Стеблей, "ЧГ=0") + " | остаток 1С " + Формат(Св.ОстатокЕд, "ЧДЦ=2; ЧРД=,; ЧГ=0") + " " + Св.ЕдХранИмя
			+ " (резерв " + Формат(Св.РезервЕд, "ЧДЦ=2; ЧРД=,; ЧГ=0") + ", в штуке единицы хранения " + Формат(Св.КоэфХран, "ЧДЦ=2; ЧРД=,; ЧГ=0") + "); " + Откуда);
	КонецЦикла;

КонецПроцедуры

Функция СтрокаТовараJSON(Св)

	Части = Новый Массив;
	Части.Добавить("""id"":" + JSONСтрока(Св.GUID));
	Если Не ПустаяСтрока(Св.Артикул) Тогда
		Части.Добавить("""sku"":" + JSONСтрока(Св.Артикул));
	КонецЕсли;
	Части.Добавить("""name"":" + JSONСтрока(Св.Имя));
	Если Не ПустаяСтрока(Св.Вид) Тогда
		Части.Добавить("""kind"":" + JSONСтрока(Св.Вид));
	КонецЕсли;
	Если Св.Высота > 0 Тогда
		Части.Добавить("""height"":" + ЧислоJSON(Св.Высота, 0));
	КонецЕсли;
	Если Не ПустаяСтрока(Св.СтранаТовара) Тогда
		Части.Добавить("""country"":" + JSONСтрока(Св.СтранаТовара));
	КонецЕсли;
	Части.Добавить("""price"":" + ЧислоJSON(Св.ЦенаШт, 2));
	Части.Добавить("""quantity"":" + ЧислоJSON(Св.Стеблей, 0));
	Если Св.УпаковкаИзЕдиниц Тогда
		Части.Добавить("""package_size"":" + ЧислоJSON(Св.Упаковка, 0));
	Иначе
		Части.Добавить("""package_size_hint"":" + ЧислоJSON(Св.Упаковка, 0));
	КонецЕсли;
	Возврат "{" + СоединитьСтроки(Части, ",") + "}";

КонецФункции

Функция ТелоКаталога(Строки)

	Документ = Новый ТекстовыйДокумент;
	Документ.ДобавитьСтроку("{""full"":true,""products"":[");
	Номер = 0;
	Для Каждого Св Из Строки Цикл
		Номер = Номер + 1;
		Документ.ДобавитьСтроку(СтрокаТовараJSON(Св) + ?(Номер < Строки.Количество(), ",", ""));
	КонецЦикла;
	Документ.ДобавитьСтроку("]}");
	Возврат Документ.ПолучитьТекст();

КонецФункции

Процедура ДействиеКаталогПоказать()

	Строки = ПодготовитьКаталог();
	Если Строки <> Неопределено Тогда
		ПоказатьПримеры(Строки);
		Пишу("");
		Пишу("Ничего не отправлено. Если цены, остатки и упаковки похожи на правду, сделайте пункт 4 (проверка на сайте).");
	КонецЕсли;

КонецПроцедуры

// ПроверкаБезСохранения: Истина - сайт только посчитает и ничего не сохранит
Процедура ОтправитьКаталог(ПроверкаБезСохранения)

	Если ПустаяСтрока(Нас("key")) Тогда
		Пишу("Не задан ключ доступа: пункт 2 (первая настройка).");
		Возврат;
	КонецЕсли;
	Строки = ПодготовитьКаталог();
	Если Строки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Строки.Количество() = 0 Тогда
		Пишу("К отправке 0 товаров: проверьте группу, склад и тип цен (пункт 2). На сайт ничего не ушло.");
		Возврат;
	КонецЕсли;
	Прошлое = 0;
	Попытка
		Прошлое = Число(Нас("last_count"));
	Исключение
	КонецПопытки;
	Если Не ПроверкаБезСохранения И Прошлое >= 20 И Строки.Количество() < Прошлое / 2 Тогда
		Пишу("СТОП: к отправке " + Формат(Строки.Количество(), "ЧГ=0") + " товаров, а в прошлый раз было " + Формат(Прошлое, "ЧГ=0")
			+ ". Так резко товаров убывать не должно: возможно, выбран не тот склад или тип цен. На сайт ничего не ушло."
			+ " Если так и должно быть, сначала сделайте пункт 4 (проверка), затем снова пункт 5.");
		Возврат;
	КонецЕсли;
	Если Не ПроверкаБезСохранения Тогда
		Если Не Подтвердить("Отправить на сайт " + Формат(Строки.Количество() + 0, "ЧГ=0") + " товаров ПО-НАСТОЯЩЕМУ?"
			+ Символы.ПС + "Всё, чего нет в этом списке, исчезнет с витрины сайта (остаток 0)."
			+ Символы.ПС + "Сначала лучше сделать пункт 4 (проверка на сайте).") Тогда
			Пишу("Отправка отменена.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Ответ = ВызватьСайт("POST", "/api/1c/products/sync" + ?(ПроверкаБезСохранения, "?dry_run=1", ""), ТелоКаталога(Строки));
	Пишу(?(ПроверкаБезСохранения, "ПРОВЕРКА на сайте (ничего не сохранено)", "ОТПРАВКА каталога на сайт") + ": " + Формат(Строки.Количество(), "ЧГ=0") + " товаров.");
	Названия = Новый Соответствие;
	Названия.Вставить("created", "создано новых");
	Названия.Вставить("updated", "обновлено");
	Названия.Вставить("deactivated", "снято с витрины");
	Названия.Вставить("errors_total", "ошибок в строках");
	ИтогОтвета(Ответ, Названия);
	Если ПроверкаБезСохранения Тогда
		Пишу("");
		Пишу("Как читать: если «создано новых» почти равно числу товаров, а «обновлено» почти ноль, то названия/артикулы не совпали");
		Пишу("с товарами на сайте и настоящая загрузка заведёт дубли: НЕ отправляйте, пришлите этот отчёт мне.");
	ИначеЕсли Ответ.Код = 200 Тогда
		Настройки.Вставить("last_count", Формат(Строки.Количество(), "ЧГ=0"));
		СохранитьНастройки();
	КонецЕсли;

КонецПроцедуры

