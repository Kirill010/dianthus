Процедура ПереключитьАвто()

	Пишу("Автообмен включается только после успешной ручной проверки. Эти флаги НЕ создают задание Windows: его настраивают отдельно с параметром /C ""авто"".");
	Нов = Нас("auto_catalog") = "1";
	Настройки.Вставить("auto_catalog", ?(Подтвердить("Автоматически отправлять КАТАЛОГ «без поставки»? Не включайте для тех же товаров, которые отправляются инвойсами." + Символы.ПС + "Сейчас: " + ?(Нов, "включено", "выключено")), "1", "0"));
	Нов = Нас("auto_invoices") = "1";
	Настройки.Вставить("auto_invoices", ?(Подтвердить("Автоматически отправлять ИНВОЙСЫ? При полном режиме старые поставки, которых нет в актуальном списке, будут закрыты, а их остатки обнулены." + Символы.ПС + "Сейчас: " + ?(Нов, "включено", "выключено")), "1", "0"));
	Нов = Нас("auto_orders") = "1";
	Если СозданиеДокументовРазрешено() Тогда
		Настройки.Вставить("auto_orders", ?(Подтвердить("Автоматически создавать НЕпроведённые накладные по заказам сайта и слать статусы на сайт? Только после приёмки на копии-черновике." + Символы.ПС + "Сейчас: " + ?(Нов, "включено", "выключено")), "1", "0"));
	Иначе
		Пишу("Автозаказы не включаются: база «" + ИмяБазы() + "» не указана в настройке orders_bases (защита рабочей базы).");
		Настройки.Вставить("auto_orders", "0");
	КонецЕсли;
	СохранитьНастройки();
	ПоказатьНастройки();

КонецПроцедуры

Процедура ВыполнитьПункт(Код)

	Журнал = Новый Массив;
	Заголовок = "Обмен с сайтом Диантус";
	Попытка
		Если Код = "1" Тогда
			Заголовок = "Связь с сайтом";
			ДействиеСвязь();
		ИначеЕсли Код = "2" Тогда
			Заголовок = "Первая настройка";
			Настроить();
		ИначеЕсли Код = "3" Тогда
			Заголовок = "Каталог: что будет отправлено";
			ДействиеКаталогПоказать();
		ИначеЕсли Код = "4" Тогда
			Заголовок = "Каталог: проверка на сайте";
			ОтправитьКаталог(Истина);
		ИначеЕсли Код = "5" Тогда
			Заголовок = "Каталог: отправка";
			ОтправитьКаталог(Ложь);
		ИначеЕсли Код = "6" Тогда
			Заголовок = "Инвойсы: что будет отправлено";
			ДействиеИнвойсыПоказать();
		ИначеЕсли Код = "7" Тогда
			Заголовок = "Инвойсы: проверка на сайте";
			ОтправитьИнвойсы(Истина);
		ИначеЕсли Код = "8" Тогда
			Заголовок = "Инвойсы: отправка";
			ОтправитьИнвойсы(Ложь);
		ИначеЕсли Код = "9" Тогда
			Заголовок = "Новые заказы с сайта";
			ДействиеЗаказыПоказать();
		ИначеЕсли Код = "10" Тогда
			Заголовок = "Подтвердить заказы";
			ДействиеЗаказыПодтвердить();
		ИначеЕсли Код = "11" Тогда
			Заголовок = "Описание базы";
			ДействиеОписатьБазу();
		ИначеЕсли Код = "12" Тогда
			Заголовок = "Настройки";
			ПоказатьНастройки();
			ПереключитьАвто();
		ИначеЕсли Код = "13" Тогда
			Заголовок = "Статус заказа на сайте";
			ДействиеЗаказСтатус();
		ИначеЕсли Код = "14" Тогда
			Заголовок = "Сверка строк инвойсов";
			ДействиеСверка();
		ИначеЕсли Код = "15" Тогда
			Заголовок = "Сведения о базе";
			ДействиеСведенияОБазе();
		ИначеЕсли Код = "16" Тогда
			Заголовок = "Автозаказы: пробная сборка накладных";
			ДействиеЗаказыПробная();
		ИначеЕсли Код = "17" Тогда
			Заголовок = "Автозаказы: создать накладные";
			ДействиеЗаказыСоздать();
		ИначеЕсли Код = "18" Тогда
			Заголовок = "Автозаказы: статусы на сайт";
			СинхронизироватьСтатусыЗаказов();
		ИначеЕсли Код = "19" Тогда
			Заголовок = "Автозаказы: самопроверка на выдуманном заказе";
			ДействиеЗаказыСамопроверка();
		ИначеЕсли Код = "20" Тогда
			Заголовок = "Фото: проверка";
			ДействиеФото(Истина);
		ИначеЕсли Код = "21" Тогда
			Заголовок = "Фото: отправка на сайт";
			Если Подтвердить("Отправить фото из папки на сайт? Фото попадут в карточки товаров и будут видны клиентам." + Символы.ПС + "Сначала лучше сделать пункт 20 (проверка).") Тогда
				ДействиеФото(Ложь);
			Иначе
				Пишу("Отправка фото отменена.");
			КонецЕсли;
		КонецЕсли;
	Исключение
		Пишу("");
		Пишу("!!! ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Пишу("Пришлите этот текст разработчику (Ctrl+A, Ctrl+C).");
	КонецПопытки;
	ПоказатьЖурнал(Заголовок);

КонецПроцедуры

// История автообмена: одна короткая запись на запуск в auto_log.txt (старый хвост обрезается, файл не растёт бесконечно)
Процедура ЗаписатьИсториюАвто()

	Попытка
		Папка = КаталогНастроек();
		Если Не ФайлЕсть(Папка) Тогда
			СоздатьКаталог(Папка);
		КонецЕсли;
		Путь = Папка + "auto_log.txt";
		Документ = Новый ТекстовыйДокумент;
		Если ФайлЕсть(Путь) Тогда
			Документ.Прочитать(Путь, КодировкаТекста.UTF8);
		КонецЕсли;
		Пока Документ.КоличествоСтрок() > 600 Цикл
			Документ.УдалитьСтроку(1);
		КонецЦикла;
		Итог = "";
		Для Каждого Линия Из Журнал Цикл
			Если Найти(Линия, "ответ сайта") > 0 Или Найти(Линия, "ОШИБКА") > 0 Или Найти(Линия, "СТОП") > 0 Тогда
				Итог = Итог + " | " + Лев(Линия, 160);
			КонецЕсли;
		КонецЦикла;
		Документ.ДобавитьСтроку(Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm'") + Итог);
		Документ.Записать(Путь, КодировкаТекста.UTF8);
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ВыполнитьАвтоматически()

	ЭтоАвто = Истина;
	Журнал = Новый Массив;
	Пишу("АВТООБМЕН " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm'") + ", сборка " + ВерсияОбработки());
	Попытка
		Если Нас("auto_catalog") = "1" Тогда
			Пишу("-- каталог --");
			ОтправитьКаталог(Ложь);
		КонецЕсли;
		Если Нас("auto_invoices") = "1" Тогда
			Пишу("-- инвойсы --");
			ОтправитьИнвойсы(Ложь);
		КонецЕсли;
		Если Нас("auto_orders") = "1" И СозданиеДокументовРазрешено() Тогда
			Пишу("-- заказы сайта --");
			СоздатьНакладныеЗаказов();
		КонецЕсли;
		Если Нас("auto_catalog") <> "1" И Нас("auto_invoices") <> "1" И Нас("auto_orders") <> "1" Тогда
			Пишу("Автообмен выключен в настройках (меню, пункт 12).");
		КонецЕсли;
	Исключение
		Пишу("!!! ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ПоказатьЖурнал("Автообмен");
	ЗаписатьИсториюАвто();
	Попытка
		ЗавершитьРаботуСистемы(Ложь);
	Исключение
	КонецПопытки;

КонецПроцедуры

