Процедура ДействиеСвязь()

	Пишу("Адрес: " + Нас("site"));
	Ответ = ВызватьСайт("GET", "/login", Неопределено, "");
	Пишу("1) Сайт доступен без ключа (/login): " + ОписатьОтвет(Ответ));
	Если ПустаяСтрока(Нас("key")) Тогда
		Пишу("2) Ключ не задан: пункт 2 (первая настройка).");
	Иначе
		Ответ = ВызватьСайт("GET", "/api/1c/ping");
		Пишу("2) Ключ " + КлючКратко() + " (/api/1c/ping): " + ОписатьОтвет(Ответ));
	КонецЕсли;

КонецПроцедуры

Функция ТипыСтрокой(ОписаниеТипа)

	Части = Новый Массив;
	Попытка
		Для Каждого ТипЗначения Из ОписаниеТипа.Типы() Цикл
			Если ТипЗначения = Тип("Строка") Тогда
				Части.Добавить("Строка");
			ИначеЕсли ТипЗначения = Тип("Число") Тогда
				Части.Добавить("Число");
			ИначеЕсли ТипЗначения = Тип("Дата") Тогда
				Части.Добавить("Дата");
			ИначеЕсли ТипЗначения = Тип("Булево") Тогда
				Части.Добавить("Булево");
			Иначе
				ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
				Если ОбъектМД <> Неопределено Тогда
					Части.Добавить(ОбъектМД.ПолноеИмя());
				Иначе
					Части.Добавить(Строка(ТипЗначения));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Части.Добавить("(тип не определён)");
	КонецПопытки;
	Возврат СоединитьСтроки(Части, " | ");

КонецФункции

Процедура ОписатьПоля(КоллекцияПолей, Отступ, Метка)

	Для Каждого Поле Из КоллекцияПолей Цикл
		Пишу(Отступ + Метка + " " + Поле.Имя + "   «" + Поле.Синоним + "»   " + ТипыСтрокой(Поле.Тип));
	КонецЦикла;

КонецПроцедуры

Процедура ОписатьОбъект(ОбъектМД, Вид)

	Пишу("");
	Пишу("=== " + ОбъектМД.ПолноеИмя() + "   «" + ОбъектМД.Синоним + "»");
	Попытка
		Если Вид = "Справочник" Или Вид = "Документ" Тогда
			ОписатьПоля(ОбъектМД.Реквизиты, "    ", "поле");
			Для Каждого ТабЧасть Из ОбъектМД.ТабличныеЧасти Цикл
				Пишу("    [табличная часть] " + ТабЧасть.Имя + "   «" + ТабЧасть.Синоним + "»");
				ОписатьПоля(ТабЧасть.Реквизиты, "        ", "-");
			КонецЦикла;
		Иначе
			ОписатьПоля(ОбъектМД.Измерения, "    ", "измерение");
			ОписатьПоля(ОбъектМД.Ресурсы, "    ", "ресурс");
			ОписатьПоля(ОбъектМД.Реквизиты, "    ", "реквизит");
		КонецЕсли;
	Исключение
		Пишу("    (описание прервано: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")");
	КонецПопытки;

КонецПроцедуры

Процедура ИскатьПоле(КоллекцияПолей, ПутьОбъекта, Слово, Счетчик)

	Для Каждого Поле Из КоллекцияПолей Цикл
		Если Счетчик.Значение >= 40 Тогда
			Возврат;
		КонецЕсли;
		Если СодержитСлово(Поле.Имя, Поле.Синоним, Слово) Тогда
			Счетчик.Значение = Счетчик.Значение + 1;
			Пишу("    " + ПутьОбъекта + "." + Поле.Имя + "   «" + Поле.Синоним + "»   " + ТипыСтрокой(Поле.Тип));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура НайтиПоле(Слово)

	Пишу("");
	Пишу("--- Где встречается «" + Слово + "» (в названиях объектов и полей) ---");
	Счетчик = Новый Структура("Значение", 0);
	Для Каждого ОбъектМД Из Метаданные.Справочники Цикл
		Попытка
			Если СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Слово) И Счетчик.Значение < 40 Тогда
				Счетчик.Значение = Счетчик.Значение + 1;
				Пишу("    [объект] " + ОбъектМД.ПолноеИмя() + "   «" + ОбъектМД.Синоним + "»");
			КонецЕсли;
			ИскатьПоле(ОбъектМД.Реквизиты, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
		Исключение
		КонецПопытки;
	КонецЦикла;
	Для Каждого ОбъектМД Из Метаданные.Документы Цикл
		Попытка
			Если СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Слово) И Счетчик.Значение < 40 Тогда
				Счетчик.Значение = Счетчик.Значение + 1;
				Пишу("    [объект] " + ОбъектМД.ПолноеИмя() + "   «" + ОбъектМД.Синоним + "»");
			КонецЕсли;
			ИскатьПоле(ОбъектМД.Реквизиты, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
			Для Каждого ТабЧасть Из ОбъектМД.ТабличныеЧасти Цикл
				ИскатьПоле(ТабЧасть.Реквизиты, ОбъектМД.ПолноеИмя() + "." + ТабЧасть.Имя, Слово, Счетчик);
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Для Каждого ОбъектМД Из Метаданные.РегистрыСведений Цикл
		Попытка
			Если СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Слово) И Счетчик.Значение < 40 Тогда
				Счетчик.Значение = Счетчик.Значение + 1;
				Пишу("    [объект] " + ОбъектМД.ПолноеИмя() + "   «" + ОбъектМД.Синоним + "»");
			КонецЕсли;
			ИскатьПоле(ОбъектМД.Измерения, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
			ИскатьПоле(ОбъектМД.Ресурсы, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
			ИскатьПоле(ОбъектМД.Реквизиты, ОбъектМД.ПолноеИмя(), Слово, Счетчик);
		Исключение
		КонецПопытки;
	КонецЦикла;
	Если Счетчик.Значение = 0 Тогда
		Пишу("    (не найдено)");
	КонецЕсли;

КонецПроцедуры

Процедура ОбразцыНазваний(ИмяСправочника, Сколько)

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Сколько, "ЧГ=0") + " Т.Наименование КАК Название ИЗ Справочник." + ИмяСправочника + " КАК Т";
		Выборка = Запрос.Выполнить().Выбрать();
		Список = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Список.Добавить(СокрЛП(Строка(Выборка.Название)));
		КонецЦикла;
		Пишу("    Образцы названий: " + СоединитьСтроки(Список, "; "));
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ДействиеОписатьБазу()

	Пишу("ОПИСАНИЕ БАЗЫ ДЛЯ НАСТРОЙКИ ОБМЕНА (только названия, без данных клиентов и сумм)");
	СисИнфо = Новый СистемнаяИнформация;
	Пишу("Платформа: " + СисИнфо.ВерсияПриложения);
	Пишу("Конфигурация: " + Метаданные.Имя + "   «" + Метаданные.Синоним + "»   версия " + Метаданные.Версия);
	Попытка
		Пишу("Режим совместимости: " + Строка(Метаданные.РежимСовместимости));
	Исключение
	КонецПопытки;
	Попытка
		Пишу("Компьютер: " + ИмяКомпьютера());
	Исключение
	КонецПопытки;

	Пишу("");
	Пишу("######## ЧТО ИЩЕТ ОБМЕН (найдено ли в вашей базе) ########");
	Для Каждого Имя Из РазделитьСтроку("Номенклатура,Контрагенты,ДоговорыКонтрагентов,ЕдиницыИзмерения,ТипыЦенНоменклатуры,Склады", ",") Цикл
		ОбъектМД = Метаданные.Справочники.Найти(Имя);
		Пишу("  Справочник." + Имя + ": " + ?(ОбъектМД = Неопределено, "НЕТ", "есть"));
		Если ОбъектМД <> Неопределено Тогда
			ОписатьОбъект(ОбъектМД, "Справочник");
			Если Имя = "Склады" Или Имя = "ТипыЦенНоменклатуры" Или Имя = "ЕдиницыИзмерения" Тогда
				ОбразцыНазваний(Имя, 15);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из РазделитьСтроку("ЦеныНоменклатуры", ",") Цикл
		ОбъектМД = Метаданные.РегистрыСведений.Найти(Имя);
		Пишу("  РегистрСведений." + Имя + ": " + ?(ОбъектМД = Неопределено, "НЕТ", "есть"));
		Если ОбъектМД <> Неопределено Тогда
			ОписатьОбъект(ОбъектМД, "РегистрСведений");
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из РазделитьСтроку("ТоварыНаСкладах,ТоварыВРезервеНаСкладах", ",") Цикл
		ОбъектМД = Метаданные.РегистрыНакопления.Найти(Имя);
		Пишу("  РегистрНакопления." + Имя + ": " + ?(ОбъектМД = Неопределено, "НЕТ", "есть"));
		Если ОбъектМД <> Неопределено Тогда
			ОписатьОбъект(ОбъектМД, "РегистрНакопления");
		КонецЕсли;
	КонецЦикла;

	Пишу("");
	Пишу("######## ДОКУМЕНТЫ-ИНВОЙСЫ И ПРОДАЖИ ########");
	Для Каждого ОбъектМД Из Метаданные.Документы Цикл
		Если СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Нас("invoice_words") + ",Реализац,Заказ,Счет,Счёт") Тогда
			ОписатьОбъект(ОбъектМД, "Документ");
		КонецЕсли;
	КонецЦикла;

	Пишу("");
	Пишу("######## ГДЕ ВСТРЕЧАЮТСЯ НУЖНЫЕ СЛОВА (скидки клиентов и т.п.) ########");
	Для Каждого Слово Из РазделитьСтроку("Скидк,Бонус,Дисконт,ИНН,Артикул,Штрихкод,Цвет,Рост,Страна,Длина", ",") Цикл
		НайтиПоле(Слово);
	КонецЦикла;

	Пишу("");
	Пишу("######## ЧТО ЕЩЁ ЕСТЬ В КОНФИГУРАЦИИ (по именам) ########");
	Пишу("Обработки: " + ИменаПолей(Метаданные.Обработки));
	Пишу("Отчёты: " + ИменаПолей(Метаданные.Отчеты));
	Попытка
		Пишу("Планы обмена: " + ИменаПолей(Метаданные.ПланыОбмена));
	Исключение
	КонецПопытки;
	Попытка
		Пишу("HTTP-сервисы: " + ИменаПолей(Метаданные.HTTPСервисы));
	Исключение
		Пишу("HTTP-сервисы: в этом режиме совместимости недоступны");
	КонецПопытки;
	Пишу("");
	Пишу("КОНЕЦ ОПИСАНИЯ. В базе ничего не менялось.");

КонецПроцедуры

