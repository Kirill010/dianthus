	Если Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;
	Возврат Формат(Значение, "ЧДЦ=" + Формат(Знаков, "ЧГ=0") + "; ЧРД=.; ЧГ=0");

КонецФункции

// Целое число после «"поле":» в тексте ответа сайта; Неопределено, если поля нет
Функция ЧислоИзОтвета(Текст, ИмяПоля)

	Позиция = Найти(Текст, """" + ИмяПоля + """");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Остаток = Сред(Текст, Позиция + СтрДлина(ИмяПоля) + 2);
	Пока Лев(Остаток, 1) = ":" Или Лев(Остаток, 1) = " " Цикл
		Остаток = Сред(Остаток, 2);
	КонецЦикла;
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Цифры) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

// Разбор CSV: разделитель «;», кавычки, переводы строк внутри кавычек
Функция РазобратьCSV(Текст)

	Строки = Новый Массив;
	Поля = Новый Массив;
	Поле = "";
	ВКавычках = Ложь;
	Длина = СтрДлина(Текст);
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(Текст, Индекс + 1, 1) = """" Тогда
					Поле = Поле + """";
					Индекс = Индекс + 1;
				Иначе
					ВКавычках = Ложь;
				КонецЕсли;
			Иначе
				Поле = Поле + Символ;
			КонецЕсли;
		Иначе
			Если Символ = """" Тогда
				ВКавычках = Истина;
			ИначеЕсли Символ = ";" Тогда
				Поля.Добавить(Поле);
				Поле = "";
			ИначеЕсли Символ = Символы.ПС Тогда
				Поля.Добавить(Поле);
				Поле = "";
				Строки.Добавить(Поля);
				Поля = Новый Массив;
			ИначеЕсли Символ <> Символы.ВК Тогда
				Поле = Поле + Символ;
			КонецЕсли;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Поле <> "" Или Поля.Количество() > 0 Тогда
		Поля.Добавить(Поле);
		Строки.Добавить(Поля);
	КонецЕсли;
	Возврат Строки;

КонецФункции

