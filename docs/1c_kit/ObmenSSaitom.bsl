Процедура Пишу(ТекстСтроки = "")

	Журнал.Добавить(ТекстСтроки);

КонецПроцедуры

Функция СоединитьСтроки(Элементы, Разделитель = ", ")

	Результат = "";
	Первый = Истина;
	Для Каждого Элемент Из Элементы Цикл
		Если Не Первый Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Строка(Элемент);
		Первый = Ложь;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазделитьСтроку(Знач Текст, Разделитель = ",")

	Результат = Новый Массив;
	Пока Истина Цикл
		Позиция = Найти(Текст, Разделитель);
		Если Позиция = 0 Тогда
			Результат.Добавить(Текст);
			Прервать;
		КонецЕсли;
		Результат.Добавить(Лев(Текст, Позиция - 1));
		Текст = Сред(Текст, Позиция + СтрДлина(Разделитель));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Подходит ли имя/синоним под одно из слов списка (буквы любого регистра)
Функция СодержитСлово(Имя, Синоним, СписокСлов)

	Образец = НРег(Имя + " " + Синоним);
	Для Каждого Слово Из РазделитьСтроку(СписокСлов, ",") Цикл
		Искомое = НРег(СокрЛП(Слово));
		Если Не ПустаяСтрока(Искомое) И Найти(Образец, Искомое) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Число из поля запроса: пусто (Null) -> 0, чтобы не сравнивать «ничто» с числом
Функция ЧислоИлиНоль(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Число из значения любого типа: число отдаём как есть, из текста берём первое число
// («60 см» -> 60, «62,5» -> 62.5); 0, если чисел нет
Функция ПерваяЧисло(Знач Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = Строка(Значение);
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли (Символ = "," Или Символ = ".") И Цифры <> "" И Найти(Цифры, ".") = 0 Тогда
			Цифры = Цифры + ".";
		ИначеЕсли Цифры <> "" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Прав(Цифры, 1) = "." Тогда
		Цифры = Лев(Цифры, СтрДлина(Цифры) - 1);
	КонецЕсли;
	Если ПустаяСтрока(Цифры) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Цифры);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Текст значения любого типа (ссылка, строка, число); пусто для пустых ссылок и Неопределено
Функция ТекстЗначения(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Результат = СокрЛП(Строка(Значение));
	Если Результат = "<Не задан>" Или Результат = "Неопределено" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Имя реквизита: сначала по точному имени (варианты через «|»), потом по словам в синониме (через «,»).
// Пусто, если не нашлось.
Функция ПолеТЧ(КоллекцияПолей, Имена, Слова = "")

	Для Каждого Вариант Из РазделитьСтроку(Имена, "|") Цикл
		Если КоллекцияПолей.Найти(Вариант) <> Неопределено Тогда
			Возврат Вариант;
		КонецЕсли;
	КонецЦикла;
	Если Не ПустаяСтрока(Слова) Тогда
		Для Каждого Поле Из КоллекцияПолей Цикл
			Если СодержитСлово("", Поле.Синоним, Слова) Тогда
				Возврат Поле.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат "";

КонецФункции

// Цена строки инвойса за штуку: из строки документа, а если там пусто - из регистра цен
Функция ЦенаСтроки(Ст)

	Возврат ?(Ст.Цена > 0, Ст.Цена, Ст.Св.ЦенаШт);

КонецФункции

// Высота строки инвойса: из документа, а если там пусто - из карточки товара
Функция ВысотаСтроки(Ст)

	Возврат ?(Ст.Высота > 0, Ст.Высота, Ст.Св.Высота);

КонецФункции

// Сколько штук в пачке для НОВОГО товара, если в 1С размер пачки не указан: по виду товара,
// иначе настройка default_pack. Для товара, который уже есть на сайте, размер пачки сайт не меняет.
Функция ПачкаПоВиду(Вид, Имя = "")

	Образец = НРег(Вид);
	// кустовые розы и российские розы («РФ» в названии) обычно по 10 штук, а не по 25, как эквадорские
	Если Найти(Образец, "роза") > 0 И (Найти(НРег(Имя), "кустов") > 0 Или Найти(Имя, " РФ") > 0) Тогда
		Возврат 10;
	КонецЕсли;
	// аксессуары, горшечные и посадочные растения продаются поштучно
	Если Найти(Образец, "аксессуар") > 0 Или Найти(Образец, "горшеч") > 0 Или Найти(Образец, "грунт") > 0 Или Найти(Образец, "растени") > 0 Тогда
		Возврат 1;
	КонецЕсли;
	// штучные экзотические цветы и растения продаются по одному
	Если Найти(Образец, "антуриум") > 0 Или Найти(Образец, "протея") > 0 Или Найти(Образец, "гиппеаструм") > 0 Или Найти(Образец, "орхиде") > 0
		Или Найти(Образец, "калла") > 0 Или Найти(Образец, "стрелиц") > 0 Или Найти(НРег(Имя), "ванда") > 0 Или Найти(НРег(Имя), "банксия") > 0 Тогда
		Возврат 1;
	КонецЕсли;
	Если Найти(Образец, "гипсофил") > 0 Тогда
		Возврат 25;
	КонецЕсли;
	Если Найти(Образец, "гвоздик") > 0 Тогда
		Возврат 20;
	ИначеЕсли Найти(Образец, "тюльпан") > 0 Тогда
		Возврат 50;
	ИначеЕсли Найти(Образец, "пион") > 0 Или Найти(Образец, "хризантем") > 0 Или Найти(Образец, "альстромер") > 0 Тогда
		Возврат 10;
	ИначеЕсли Найти(Образец, "роза") > 0 Тогда
		Возврат 25;
	КонецЕсли;
	ПоУмолчанию = 10;
	Попытка
		ПоУмолчанию = Число(Нас("default_pack"));
	Исключение
	КонецПопытки;
	Возврат ?(ПоУмолчанию >= 1, Окр(ПоУмолчанию), 1);

КонецФункции

// Название страны для сайта: известные приводим к привычному виду («ЭКВАДОР» -> «Эквадор»,
// «НИДЕРЛАНДЫ» -> «Голландия»), остальные пишем с большой буквы
Функция НазваниеСтраны(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Результат = СтранаПоТексту(Текст);
	Если ПустаяСтрока(Результат) Тогда
		Результат = ВРег(Лев(Текст, 1)) + НРег(Сред(Текст, 2));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Страна по ГРУППЕ товара в справочнике номенклатуры («РОУЗХИЛЛ», «Ступино» - Россия, «ECUANROS» - Эквадор...).
// Слова и страны берутся из настройки group_countries (settings.ini), потому что группы называют по поставщикам.
Функция СтранаПоГруппе(Группа)

	Если ПустаяСтрока(Группа) Тогда
		Возврат "";
	КонецЕсли;
	Образец = НРег(Группа);
	Для Каждого Пара Из РазделитьСтроку(Нас("group_countries"), ";") Цикл
		Позиция = Найти(Пара, "=");
		Если Позиция > 1 Тогда
			Слово = НРег(СокрЛП(Лев(Пара, Позиция - 1)));
			Если Не ПустаяСтрока(Слово) И Найти(Образец, Слово) > 0 Тогда
				Возврат СокрЛП(Сред(Пара, Позиция + 1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат СтранаПоТексту(Группа);

КонецФункции

// Страна строки инвойса и откуда она взята. Порядок от надёжного к догадке:
//  1) «Страна строка» в инвойсе; 2) «Страна» в шапке инвойса; 3) «Страна происхождения» в КАРТОЧКЕ товара (основной источник);
//  4) группа товара; 5) название товара («РФ», «(Р)», «Кения»...); 6) организация («ООО "ДИАНТУС"» - российские поставщики).
// Вид документа («Инвойс срезка эквадор») страну НЕ определяет: так оформляют и российских поставщиков.
Функция ОпределитьСтрану(Инв, Ст)

	Результат = Новый Структура("Страна, Откуда", "", "");
	Св = Ст.Св;
	Если Не ПустаяСтрока(Ст.СтранаСтр) Тогда
		Результат.Страна = Ст.СтранаСтр;
		Результат.Откуда = "строка инвойса";
	ИначеЕсли Не ПустаяСтрока(Инв.СтранаШапки) Тогда
		Результат.Страна = НазваниеСтраны(Инв.СтранаШапки);
		Результат.Откуда = "шапка инвойса";
	ИначеЕсли Не ПустаяСтрока(Св.СтранаТовара) Тогда
		Результат.Страна = Св.СтранаТовара;
		Результат.Откуда = "карточка товара";
	Иначе
		ПоГруппе = СтранаПоГруппе(Св.Группа);
		Если Не ПустаяСтрока(ПоГруппе) Тогда
			Результат.Страна = ПоГруппе;
			Результат.Откуда = "группа товара «" + Св.Группа + "»";
		ИначеЕсли Найти(Св.Имя, " РФ") > 0 Или Найти(Св.Имя, "(Р)") > 0 Тогда
			Результат.Страна = "Россия";
			Результат.Откуда = "название товара";
		ИначеЕсли Не ПустаяСтрока(СтранаПоТексту(Св.Имя)) Тогда
			Результат.Страна = СтранаПоТексту(Св.Имя);
			Результат.Откуда = "название товара";
		ИначеЕсли Не ПустаяСтрока(Нас("russian_org")) И Инв.Организация = Нас("russian_org") Тогда
			Результат.Страна = "Россия";
			Результат.Откуда = "организация " + Инв.Организация;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Страна строки, как она уйдёт на сайт (считается один раз при подготовке инвойсов)
Функция СтранаСтроки(Инв, Ст)

	Возврат Ст.СтранаИтог;

КонецФункции

// Учесть пачку в таблице «ключ -> (пачка -> сколько строк)»
Процедура УчестьПачку(Таблица, Ключ, Пачка)

	Счет = Таблица.Получить(Ключ);
	Если Счет = Неопределено Тогда
		Счет = Новый Соответствие;
		Таблица.Вставить(Ключ, Счет);
	КонецЕсли;
	Было = Счет.Получить(Пачка);
	Счет.Вставить(Пачка, ?(Было = Неопределено, 1, Было + 1));

КонецПроцедуры

// Самая частая пачка в таблице: Структура(Пачка, Сколько, Всего). Пачка = 0, если данных мало или нет явного большинства.
Функция МодаПачки(Счет, МинДоля)

	Результат = Новый Структура("Пачка, Сколько, Всего", 0, 0, 0);
	Если Счет = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Лучшая = 0;
	ЛучшийСчет = 0;
	Всего = 0;
	Для Каждого Пара Из Счет Цикл
		Всего = Всего + Пара.Значение;
		Если Пара.Значение > ЛучшийСчет Тогда
			ЛучшийСчет = Пара.Значение;
			Лучшая = Пара.Ключ;
		КонецЕсли;
	КонецЦикла;
	Результат.Всего = Всего;
	Если Всего >= 2 И ЛучшийСчет / Всего >= МинДоля Тогда
		Результат.Пачка = Лучшая;
		Результат.Сколько = ЛучшийСчет;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЧислоВHex(Знач Значение, Цифр = 4)

	Алфавит = "0123456789abcdef";
	Результат = "";
	Для Счетчик = 1 По Цифр Цикл
		Результат = Сред(Алфавит, (Значение % 16) + 1, 1) + Результат;
		Значение = Цел(Значение / 16);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строка JSON в «чистом ASCII»: всё, кроме латиницы и цифр, - через \uXXXX,
// поэтому кодировка при передаче не имеет значения.
Функция JSONСтрока(Значение)

	Текст = Строка(Значение);
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Код = КодСимвола(Символ);
		Если Символ = """" Тогда
			Результат = Результат + "\""";
		ИначеЕсли Символ = "\" Тогда
			Результат = Результат + "\\";
		ИначеЕсли Код < 32 Или Код > 126 Тогда
			Результат = Результат + "\u" + ЧислоВHex(Код);
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат """" + Результат + """";

КонецФункции

Функция ЧислоJSON(Значение, Знаков = 2)

	Если Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;
	Возврат Формат(Значение, "ЧДЦ=" + Формат(Знаков, "ЧГ=0") + "; ЧРД=.; ЧГ=0");

КонецФункции

// Целое число после «"поле":» в тексте ответа сайта; Неопределено, если поля нет
Функция ЧислоИзОтвета(Текст, ИмяПоля)

	Позиция = Найти(Текст, """" + ИмяПоля + """");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Остаток = Сред(Текст, Позиция + СтрДлина(ИмяПоля) + 2);
	Пока Лев(Остаток, 1) = ":" Или Лев(Остаток, 1) = " " Цикл
		Остаток = Сред(Остаток, 2);
	КонецЦикла;
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Цифры) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

// Разбор CSV: разделитель «;», кавычки, переводы строк внутри кавычек
Функция РазобратьCSV(Текст)

	Строки = Новый Массив;
	Поля = Новый Массив;
	Поле = "";
	ВКавычках = Ложь;
	Длина = СтрДлина(Текст);
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(Текст, Индекс + 1, 1) = """" Тогда
					Поле = Поле + """";
					Индекс = Индекс + 1;
				Иначе
					ВКавычках = Ложь;
				КонецЕсли;
			Иначе
				Поле = Поле + Символ;
			КонецЕсли;
		Иначе
			Если Символ = """" Тогда
				ВКавычках = Истина;
			ИначеЕсли Символ = ";" Тогда
				Поля.Добавить(Поле);
				Поле = "";
			ИначеЕсли Символ = Символы.ПС Тогда
				Поля.Добавить(Поле);
				Поле = "";
				Строки.Добавить(Поля);
				Поля = Новый Массив;
			ИначеЕсли Символ <> Символы.ВК Тогда
				Поле = Поле + Символ;
			КонецЕсли;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Поле <> "" Или Поля.Количество() > 0 Тогда
		Поля.Добавить(Поле);
		Строки.Добавить(Поля);
	КонецЕсли;
	Возврат Строки;

КонецФункции

