Процедура ПереключитьАвто()

	Пишу("Автообмен включается только после успешной ручной проверки. Эти флаги НЕ создают задание Windows: его настраивают отдельно с параметром /C ""авто"".");
	Нов = Нас("auto_catalog") = "1";
	Настройки.Вставить("auto_catalog", ?(Подтвердить("Автоматически отправлять КАТАЛОГ «без поставки»? Не включайте для тех же товаров, которые отправляются инвойсами." + Символы.ПС + "Сейчас: " + ?(Нов, "включено", "выключено")), "1", "0"));
	Нов = Нас("auto_invoices") = "1";
	Настройки.Вставить("auto_invoices", ?(Подтвердить("Автоматически отправлять ИНВОЙСЫ? При полном режиме старые поставки, которых нет в актуальном списке, будут закрыты, а их остатки обнулены." + Символы.ПС + "Сейчас: " + ?(Нов, "включено", "выключено")), "1", "0"));
	СохранитьНастройки();
	ПоказатьНастройки();

КонецПроцедуры

Процедура ВыполнитьПункт(Код)

	Журнал = Новый Массив;
	Заголовок = "Обмен с сайтом Диантус";
	Попытка
		Если Код = "1" Тогда
			Заголовок = "Связь с сайтом";
			ДействиеСвязь();
		ИначеЕсли Код = "2" Тогда
			Заголовок = "Первая настройка";
			Настроить();
		ИначеЕсли Код = "3" Тогда
			Заголовок = "Каталог: что будет отправлено";
			ДействиеКаталогПоказать();
		ИначеЕсли Код = "4" Тогда
			Заголовок = "Каталог: проверка на сайте";
			ОтправитьКаталог(Истина);
		ИначеЕсли Код = "5" Тогда
			Заголовок = "Каталог: отправка";
			ОтправитьКаталог(Ложь);
		ИначеЕсли Код = "6" Тогда
			Заголовок = "Инвойсы: что будет отправлено";
			ДействиеИнвойсыПоказать();
		ИначеЕсли Код = "7" Тогда
			Заголовок = "Инвойсы: проверка на сайте";
			ОтправитьИнвойсы(Истина);
		ИначеЕсли Код = "8" Тогда
			Заголовок = "Инвойсы: отправка";
			ОтправитьИнвойсы(Ложь);
		ИначеЕсли Код = "9" Тогда
			Заголовок = "Новые заказы с сайта";
			ДействиеЗаказыПоказать();
		ИначеЕсли Код = "10" Тогда
			Заголовок = "Подтвердить заказы";
			ДействиеЗаказыПодтвердить();
		ИначеЕсли Код = "11" Тогда
			Заголовок = "Описание базы";
			ДействиеОписатьБазу();
		ИначеЕсли Код = "12" Тогда
			Заголовок = "Настройки";
			ПоказатьНастройки();
			ПереключитьАвто();
		ИначеЕсли Код = "13" Тогда
			Заголовок = "Статус заказа на сайте";
			ДействиеЗаказСтатус();
		КонецЕсли;
	Исключение
		Пишу("");
		Пишу("!!! ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Пишу("Пришлите этот текст разработчику (Ctrl+A, Ctrl+C).");
	КонецПопытки;
	ПоказатьЖурнал(Заголовок);

КонецПроцедуры

Процедура ВыполнитьАвтоматически()

	ЭтоАвто = Истина;
	Журнал = Новый Массив;
	Пишу("АВТООБМЕН " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm'"));
	Попытка
		Если Нас("auto_catalog") = "1" Тогда
			Пишу("-- каталог --");
			ОтправитьКаталог(Ложь);
		КонецЕсли;
		Если Нас("auto_invoices") = "1" Тогда
			Пишу("-- инвойсы --");
			ОтправитьИнвойсы(Ложь);
		КонецЕсли;
		Если Нас("auto_catalog") <> "1" И Нас("auto_invoices") <> "1" Тогда
			Пишу("Автообмен выключен в настройках (меню, пункт 12).");
		КонецЕсли;
	Исключение
		Пишу("!!! ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ПоказатьЖурнал("Автообмен");
	Попытка
		ЗавершитьРаботуСистемы(Ложь);
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ПоказатьМеню()

	Пока Истина Цикл
		Список = Новый СписокЗначений;
		Список.Добавить("2", "2. Первая настройка (адрес, ключ, группа, склад, тип цен)");
		Список.Добавить("1", "1. Проверить связь с сайтом");
		Список.Добавить("3", "3. Каталог «без поставки»: показать, что будет отправлено (ничего не отправляется)");
		Список.Добавить("4", "4. Каталог «без поставки»: проверка на сайте (ничего не сохраняется)");
		Список.Добавить("5", "5. Каталог «без поставки»: ОТПРАВИТЬ на сайт");
		Список.Добавить("6", "6. Инвойсы (поставки): показать (ничего не отправляется)");
		Список.Добавить("7", "7. Инвойсы (поставки): проверка на сайте (ничего не сохраняется)");
		Список.Добавить("8", "8. Инвойсы (поставки): ОТПРАВИТЬ на сайт");
		Список.Добавить("9", "9. Заказы с сайта: показать новые");
		Список.Добавить("10", "10. Заказы с сайта: по одному подтвердить создание и резерв в 1С");
		Список.Добавить("11", "11. Описание базы (для разработчика)");
		Список.Добавить("12", "12. Настройки и автообмен");
		Список.Добавить("13", "13. Заказ: отправить статус на сайт (вручную)");
		Элемент = Список.ВыбратьЭлемент("Обмен 1С с сайтом Диантус (закрыть - Отмена)");
		Если Элемент = Неопределено Тогда
			Прервать;
		КонецЕсли;
		ВыполнитьПункт(Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

Процедура Запуск()

	Журнал = Новый Массив;
	ЭтоАвто = Ложь;
	ЗагрузитьНастройки();
	Режим = "";
	Попытка
		Режим = НРег(СокрЛП(ПараметрЗапуска));
	Исключение
	КонецПопытки;
	Если Режим = "авто" Или Режим = "auto" Тогда
		ВыполнитьАвтоматически();
	Иначе
		ПоказатьМеню();
	КонецЕсли;

КонецПроцедуры

