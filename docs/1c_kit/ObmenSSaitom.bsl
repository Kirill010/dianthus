// Самая частая пачка в таблице: Структура(Пачка, Сколько, Всего). Пачка = 0, если данных мало или нет явного большинства.
Функция МодаПачки(Счет, МинДоля)

	Результат = Новый Структура("Пачка, Сколько, Всего", 0, 0, 0);
	Если Счет = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Лучшая = 0;
	ЛучшийСчет = 0;
	Всего = 0;
	Для Каждого Пара Из Счет Цикл
		Всего = Всего + Пара.Значение;
		Если Пара.Значение > ЛучшийСчет Тогда
			ЛучшийСчет = Пара.Значение;
			Лучшая = Пара.Ключ;
		КонецЕсли;
	КонецЦикла;
	Результат.Всего = Всего;
	Если Всего >= 2 И ЛучшийСчет / Всего >= МинДоля Тогда
		Результат.Пачка = Лучшая;
		Результат.Сколько = ЛучшийСчет;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЧислоВHex(Знач Значение, Цифр = 4)

	Алфавит = "0123456789abcdef";
	Результат = "";
	Для Счетчик = 1 По Цифр Цикл
		Результат = Сред(Алфавит, (Значение % 16) + 1, 1) + Результат;
		Значение = Цел(Значение / 16);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строка JSON в «чистом ASCII»: всё, кроме латиницы и цифр, - через \uXXXX,
// поэтому кодировка при передаче не имеет значения.
Функция JSONСтрока(Значение)

	Текст = Строка(Значение);
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Код = КодСимвола(Символ);
		Если Символ = """" Тогда
			Результат = Результат + "\""";
		ИначеЕсли Символ = "\" Тогда
			Результат = Результат + "\\";
		ИначеЕсли Код < 32 Или Код > 126 Тогда
			Результат = Результат + "\u" + ЧислоВHex(Код);
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат """" + Результат + """";

КонецФункции

