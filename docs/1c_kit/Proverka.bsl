// ============================================================================
// ПРОБНЫЙ ФАЙЛ ДЛЯ 1С  (шаг 1 из 2)  -  ТОЛЬКО ЧТЕНИЕ, 10 МИНУТ
//
// Зачем: быстро проверить три вещи, прежде чем делать большой файл обмена:
//   1. Получается ли у вас создать и открыть такой файл в 1С.
//   2. Видит ли компьютер с 1С ваш сайт.
//   3. Как в вашей базе называются справочники, цены, остатки и инвойсы
//      (только названия; данные клиентов и суммы НЕ читаются).
//
// В базе 1С он НИЧЕГО не создаёт, не изменяет и не удаляет. Данные на сайт не отправляет.
// Как запустить: «1С:Предприятие» -> Файл -> Открыть -> этот файл (.epf)
// ============================================================================

#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда

Перем Журнал;     // Массив строк отчёта

Процедура Пишу(ТекстСтроки = "")

	Журнал.Добавить(ТекстСтроки);

КонецПроцедуры

Функция СоединитьСтроки(Элементы, Разделитель = ", ")

	Результат = "";
	Первый = Истина;
	Для Каждого Элемент Из Элементы Цикл
		Если Не Первый Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Строка(Элемент);
		Первый = Ложь;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазделитьСтроку(Знач Текст, Разделитель = ",")

	Результат = Новый Массив;
	Пока Истина Цикл
		Позиция = Найти(Текст, Разделитель);
		Если Позиция = 0 Тогда
			Результат.Добавить(Текст);
			Прервать;
		КонецЕсли;
		Результат.Добавить(Лев(Текст, Позиция - 1));
		Текст = Сред(Текст, Позиция + СтрДлина(Разделитель));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СодержитСлово(Имя, Синоним, СписокСлов)

	Образец = НРег(Имя + " " + Синоним);
	Для Каждого Слово Из РазделитьСтроку(СписокСлов, ",") Цикл
		Искомое = НРег(СокрЛП(Слово));
		Если Не ПустаяСтрока(Искомое) И Найти(Образец, Искомое) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ИменаПолей(КоллекцияПолей)

	Имена = Новый Массив;
	Для Каждого Поле Из КоллекцияПолей Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	Возврат СоединитьСтроки(Имена, ", ");

КонецФункции

// Есть ли в базе объект с таким именем; если есть - перечисляет названия его полей
Процедура ПроверитьОбъект(Вид, Имя)

	ОбъектМД = Неопределено;
	Попытка
		Если Вид = "Справочник" Тогда
			ОбъектМД = Метаданные.Справочники.Найти(Имя);
		ИначеЕсли Вид = "РегистрСведений" Тогда
			ОбъектМД = Метаданные.РегистрыСведений.Найти(Имя);
		ИначеЕсли Вид = "РегистрНакопления" Тогда
			ОбъектМД = Метаданные.РегистрыНакопления.Найти(Имя);
		ИначеЕсли Вид = "Документ" Тогда
			ОбъектМД = Метаданные.Документы.Найти(Имя);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если ОбъектМД = Неопределено Тогда
		Пишу(Вид + " «" + Имя + "»: НЕТ");
		Возврат;
	КонецЕсли;
	Пишу(Вид + " «" + Имя + "»: есть  («" + ОбъектМД.Синоним + "»)");
	Попытка
		Если Вид = "Справочник" Или Вид = "Документ" Тогда
			Пишу("    поля: " + ИменаПолей(ОбъектМД.Реквизиты));
			Для Каждого ТабЧасть Из ОбъектМД.ТабличныеЧасти Цикл
				Пишу("    таблица «" + ТабЧасть.Имя + "»: " + ИменаПолей(ТабЧасть.Реквизиты));
			КонецЦикла;
		Иначе
			Пишу("    измерения: " + ИменаПолей(ОбъектМД.Измерения));
			Пишу("    ресурсы: " + ИменаПолей(ОбъектМД.Ресурсы));
			Пишу("    реквизиты: " + ИменаПолей(ОбъектМД.Реквизиты));
		КонецЕсли;
	Исключение
		Пишу("    (поля не прочитаны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")");
	КонецПопытки;

КонецПроцедуры

// Где в названиях полей встречается слово (например, «скидк»): только путь и название поля
Процедура Искать(Слово)

	Пишу("Где встречается «" + Слово + "»:");
	Найдено = 0;
	Попытка
		Для Каждого ОбъектМД Из Метаданные.Справочники Цикл
			Для Каждого Поле Из ОбъектМД.Реквизиты Цикл
				Если Найдено < 25 И СодержитСлово(Поле.Имя, Поле.Синоним, Слово) Тогда
					Найдено = Найдено + 1;
					Пишу("    " + ОбъектМД.ПолноеИмя() + "." + Поле.Имя + "  («" + Поле.Синоним + "»)");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Для Каждого ОбъектМД Из Метаданные.РегистрыСведений Цикл
			Если Найдено < 25 И СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, Слово) Тогда
				Найдено = Найдено + 1;
				Пишу("    " + ОбъектМД.ПолноеИмя() + "  («" + ОбъектМД.Синоним + "»)");
			КонецЕсли;
			Для Каждого Поле Из ОбъектМД.Ресурсы Цикл
				Если Найдено < 25 И СодержитСлово(Поле.Имя, Поле.Синоним, Слово) Тогда
					Найдено = Найдено + 1;
					Пишу("    " + ОбъектМД.ПолноеИмя() + "." + Поле.Имя + "  («" + Поле.Синоним + "»)");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Пишу("    (поиск прерван: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")");
	КонецПопытки;
	Если Найдено = 0 Тогда
		Пишу("    (не найдено)");
	КонецЕсли;

КонецПроцедуры

// Виден ли сайт с этого компьютера: сначала средствами 1С, потом через Windows
Функция СвязьССайтом(Хост)

	Результат = "";
	Попытка
		Соединение = Новый HTTPСоединение(Хост, 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL());
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/health"));
		Результат = "средствами 1С: код " + Формат(Ответ.КодСостояния, "ЧГ=0") + " (200 = всё хорошо)";
	Исключение
		Результат = "средствами 1С НЕ УДАЛОСЬ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Результат = Результат + Символы.ПС + "    ";
	Попытка
		Объект = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
		Объект.Open("GET", "https://" + Хост + "/health", Ложь);
		Объект.SetTimeouts(15000, 15000, 30000, 30000);
		Объект.Send();
		Результат = Результат + "через Windows: код " + Формат(Объект.Status, "ЧГ=0") + " (200 = всё хорошо)";
	Исключение
		Результат = Результат + "через Windows НЕ УДАЛОСЬ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура СобратьОтчет()

	Пишу("ПРОБНЫЙ ФАЙЛ 1С ДЛЯ САЙТА ДИАНТУС. Отчёт не содержит данных клиентов, сумм и паролей.");
	Пишу("Сформирован: " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm'"));
	Пишу("");
	Пишу("######## ОБЩЕЕ ########");
	Пишу("Платформа: " + СистемнаяИнформация.ВерсияПриложения);
	Пишу("Конфигурация: " + Метаданные.Имя + "  («" + Метаданные.Синоним + "»)  версия " + Метаданные.Версия);
	Попытка
		Пишу("Режим совместимости: " + Строка(Метаданные.РежимСовместимости));
	Исключение
	КонецПопытки;
	Попытка
		Пишу("Компьютер: " + ИмяКомпьютера());
	Исключение
	КонецПопытки;

	Пишу("");
	Пишу("######## СВЯЗЬ С САЙТОМ ########");
	Пишу("Адрес dianthus-opt.ru:");
	Пишу("    " + СвязьССайтом("dianthus-opt.ru"));

	Пишу("");
	Пишу("######## ЧТО ЕСТЬ В ВАШЕЙ БАЗЕ (названия) ########");
	ПроверитьОбъект("Справочник", "Номенклатура");
	ПроверитьОбъект("Справочник", "Склады");
	ПроверитьОбъект("Справочник", "ТипыЦенНоменклатуры");
	ПроверитьОбъект("Справочник", "ЕдиницыИзмерения");
	ПроверитьОбъект("Справочник", "Контрагенты");
	ПроверитьОбъект("Справочник", "ДоговорыКонтрагентов");
	ПроверитьОбъект("РегистрСведений", "ЦеныНоменклатуры");
	ПроверитьОбъект("РегистрНакопления", "ТоварыНаСкладах");
	ПроверитьОбъект("РегистрНакопления", "ТоварыВРезервеНаСкладах");
	ПроверитьОбъект("Документ", "РеализацияТоваровУслуг");

	Пишу("");
	Пишу("######## ДОКУМЕНТЫ-ИНВОЙСЫ ########");
	Найдено = 0;
	Для Каждого ОбъектМД Из Метаданные.Документы Цикл
		Если СодержитСлово(ОбъектМД.Имя, ОбъектМД.Синоним, "Инвойс") Тогда
			Найдено = Найдено + 1;
			ПроверитьОбъект("Документ", ОбъектМД.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Найдено = 0 Тогда
		Пишу("Документов со словом «Инвойс» в названии не найдено.");
	КонецЕсли;

	Пишу("");
	Пишу("######## ГДЕ ХРАНЯТСЯ СКИДКИ КЛИЕНТОВ ########");
	Искать("Скидк");
	Искать("Бонус");
	Искать("Дисконт");

	Пишу("");
	Пишу("КОНЕЦ ОТЧЁТА. В информационной базе ничего не менялось.");

КонецПроцедуры

Процедура Запуск()

	Журнал = Новый Массив;
	Попытка
		Предупреждение("Файл открылся: значит, всё получилось." + Символы.ПС + Символы.ПС
			+ "Сейчас он соберёт названия справочников и проверит связь с сайтом."
			+ " В вашей базе он ничего не меняет. Нажмите OK.", 0, "Пробный файл для сайта Диантус");
	Исключение
	КонецПопытки;
	Попытка
		СобратьОтчет();
	Исключение
		Пишу("");
		Пишу("!!! ОТЧЁТ ПРЕРВАН ОШИБКОЙ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Текст = СоединитьСтроки(Журнал, Символы.ПС);
	Попытка
		Копия = Текст;
		ВвестиСтроку(Копия, "Отчёт: нажмите Ctrl+A, затем Ctrl+C, вставьте в чат и закройте окно (OK)", 0, Истина);
	Исключение
		Сообщить(Текст);
	КонецПопытки;

КонецПроцедуры

// ----------------------------------------------------------------------------
// Основная программа: выполняется при открытии файла
// ----------------------------------------------------------------------------

Запуск();

#КонецЕсли
