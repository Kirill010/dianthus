# Образец настроек. Реальный файл .env создаётся командой:
#   ./scripts/prepare.sh <домен> <email-админа>
# (она подставит случайные пароли). Сам .env в Git НЕ попадает.

ENV=prod
SECRET_KEY=<openssl rand -hex 32>
APP_URL=https://example.ru

POSTGRES_USER=dianthus_user
POSTGRES_PASSWORD=<случайный пароль>
POSTGRES_DB=dianthus
# Хост "db" — имя контейнера. Пароль должен совпадать с POSTGRES_PASSWORD.
# Без "+asyncpg": приложение использует синхронный SQLAlchemy.
DATABASE_URL=postgresql://dianthus_user:<тот же пароль>@db:5432/dianthus

REDIS_PASSWORD=<случайный пароль>
REDIS_URL=redis://:<тот же пароль>@redis:6379/0

CACHE_TTL=300
PAGE_SIZE=12
SESSION_MAX_AGE=604800

ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=<сложный пароль: минимум 8 символов, буквы и цифры>
ADMIN_NAME=Администратор
ADMIN_COMPANY=ООО Диантус
ADMIN_PHONE=
ADMIN_FORCE_PASSWORD_RESET=0

SHOP_NAME=ООО «Диантус»
SHOP_PHONE=
SHOP_PHONE_2=
SHOP_ADDRESS=
SHOP_WORKING_HOURS=Пн–Вс 08:00–21:00
SHOP_MAX_LINK=
SHOP_MAP_URL=

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true

INTEGRATION_USER=1c_dianthus
INTEGRATION_PASSWORD=<случайный пароль для 1С>

SENTRY_DSN=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.ru
