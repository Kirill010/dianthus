# ═══════════════════════════════════════════════════════════════
# Шаблон настроек для РАЗРАБОТКИ на своём компьютере:
#     [ -f .env ] || cp .env.example .env
#     (Windows PowerShell: if (-not (Test-Path .env)) { Copy-Item .env.example .env })
# Не перезаписывайте существующий .env — в нём могут быть боевые настройки.
#
# Боевой .env на сервере НЕ копируйте отсюда — его создаёт скрипт
#     bash scripts/prepare.sh ваш-домен.ru admin@ваш-домен.ru
# со случайными паролями (см. docs/GUIDE_FROM_SCRATCH.md).
# Файл .env нельзя коммитить в Git — он в .gitignore.
# ═══════════════════════════════════════════════════════════════

# dev = разработка (SQLite, без Redis, cookie работает и по http://).
# prod = боевой режим (только HTTPS, строгая проверка секретов, нужен PostgreSQL).
ENV=dev
SECRET_KEY=dev-secret-key-change-me-0123456789abcdef
APP_URL=http://127.0.0.1:8000

# База данных. Для разработки хватает SQLite (файл создастся сам):
DATABASE_URL=sqlite:///./dianthus.db
# PostgreSQL (так настроено в docker-compose, хост db — имя контейнера):
# DATABASE_URL=postgresql://dianthus_user:ПАРОЛЬ@db:5432/dianthus

# Redis нужен только в продакшене (сессии и лимиты запросов между воркерами).
# REDIS_URL=redis://:ПАРОЛЬ@redis:6379/0

PAGE_SIZE=12
SESSION_MAX_AGE=604800

# Максимальный размер загружаемого фото, байт (по умолчанию 5 МБ)
# MAX_UPLOAD_SIZE=5242880

# ── Администратор: создаётся автоматически при первом запуске ──
# Пароль: минимум 8 символов, буква и цифра. После первого входа смените его в
# профиле, включите 2FA и удалите ADMIN_PASSWORD из .env.
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Администратор
ADMIN_COMPANY=ООО Диантус
ADMIN_PHONE=
ADMIN_FORCE_PASSWORD_RESET=0

# ── Магазин (страница «Контакты», письма, PDF-счёт, политика конфиденциальности) ──
SHOP_NAME=ООО «Диантус»
SHOP_PHONE=
SHOP_PHONE_2=
SHOP_ADDRESS=
SHOP_EMAIL=
SHOP_WORKING_HOURS=Пн–Вс 08:00–21:00
SHOP_MAX_LINK=
SHOP_MAP_URL=
# Банковские реквизиты для PDF-счёта, строки через «|»
SHOP_REQUISITES=
# Часовой пояс магазина (время заказов показывается в нём; в БД хранится UTC)
SHOP_TZ=Europe/Moscow

# ── Почта (уведомления админам и клиентам). Пусто = письма не отправляются ──
# Яндекс.Почта: нужен «пароль приложения», а не пароль от ящика.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true

# ── Обмен с 1С (HTTP Basic). Без пароля интеграция отключена (ответ 503) ──
INTEGRATION_USER=1c_dianthus
INTEGRATION_PASSWORD=dev-1c-password
# 1 = вычитать из остатков 1С заказы, которые она ещё не подтвердила (orders/ack)
ONEC_RESERVE_UNEXPORTED=0

# ── Необязательное ──
# SENTRY_DSN=
# BACKUP_REMOTE=backup@другой-сервер:/srv/dianthus-backups
